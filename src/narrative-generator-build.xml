<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="generateNarratives" default="build">
    <dirname property="narrative.build.dir" file="${ant.file.generateNarratives}"/>
    <property name="dependency.dir" location="${lib.dir}/ant-dependencies/jar"/>
    <property name="narrativegenerator.dir" location="${testscripttools.dir}/xsl/util"/>
    <property name="Saxon-HE.jar" location="${dependency.dir}/Saxon-HE-9.9.1-7.jar"/>

    <target name="load-dependencies">
        <taskdef resource="net/sf/antcontrib/antlib.xml">
            <classpath>
                <pathelement location="${dependency.dir}/ant-contrib-1.0b3.jar" />
            </classpath>
        </taskdef>
        <property name="ant.contrib.loaded" value="true" />
    </target>
    
    <!-- Actual build targets -->
    
    <target name="get-input-files">
        <if>
            <not>
                <isreference refid="in.dirs"/>
            </not>
            <then>
                <if>
                    <not>
                        <isset property="in.dir"/>
                    </not>
                    <then>
                        <input message="Please enter the folder with XML files (may also be given using '-Din.dir=/path/to/xml/files')" addproperty="project"/>
                    </then>
                </if>
                <property name="in.dir.absolute" location="${in.dir}"/>
                <dirset id="in.dirs" dir="${in.dir.absolute}"/>
            </then>
        </if>
    </target>
    
    <target name="select-stylesheet" depends="load-dependencies">
        <if>
            <equals arg1="${fhir.version}" arg2="R4"/>
            <then>
                <property name="stylesheet" value="NarrativeGenerator-R4.xsl"/>
            </then>
        <elseif>
            <equals arg1="${fhir.version}" arg2="STU3"/>
            <then>
                <property name="stylesheet" value="NarrativeGenerator.xsl"/>
            </then>
        </elseif>
        <elseif>
            <not>
                <isset property="fhir.version"/>
            </not>
            <then>
                <echo message="'fhir.version' property not set, defaulting to STU3"/>
                <property name="stylesheet" value="NarrativeGenerator.xsl"/>
            </then>
        </elseif>
        <else>
            <fail message="Invalid fhir.version '${fhir.version}': should be 'STU3' or 'R4'"/>
        </else>
    </if>
    </target>

    <target name="prepare-entrypoint" depends="select-stylesheet">
        <copy file="${narrative.build.dir}/narrative-generator-entrypoint.xsl"
              tofile="${narrativegenerator.dir}/NarrativeGenerator-entrypoint.xsl"
              overwrite="true">
            <filterset>
                <filter token="GENERATOR_STYLESHEET" value="${narrativegenerator.dir}/${stylesheet}"/>
            </filterset>
        </copy>
    </target>

    <macrodef name="run-narrative-generator">
        <attribute name="in.dir.absolute"/>
        
        <sequential>
            <fileset id="in.files" dir="@{in.dir.absolute}" excludes="${files.to.exclude}">
                <include name="**/*.xml"/>
            </fileset>
            
            <tempfile property="temp.dir"/>
            <mkdir dir="${temp.dir}"/>
            
            <xslt force="true" style="${narrativegenerator.dir}/NarrativeGenerator-entrypoint.xsl" destdir="${temp.dir}" useImplicitFileset="false" failOnNoResources="false">
                <factory name="net.sf.saxon.TransformerFactoryImpl"/>
                <classpath location="${Saxon-HE.jar}"/>
                <param name="override" expression="true"/>
                <param name="fhirVersion" expression="${fhir.version}"/>
                <outputproperty name="method" value="xml"/>
                <outputproperty name="omit-xml-declaration" value="yes"/>
                <outputproperty name="indent" value="yes"/>
                <fileset refid="in.files"/>
                <mapper type="identity"/>
            </xslt>
            
            <xslt style="${narrativegenerator.dir}/formatXML.xsl" basedir="${temp.dir}" destdir="@{in.dir.absolute}">
                <factory name="net.sf.saxon.TransformerFactoryImpl"/>
                <classpath location="${Saxon-HE.jar}"/>
                <mapper type="identity"/>
            </xslt>
            
            <delete dir="${temp.dir}"/>
        </sequential>
    </macrodef>
        
    <target name="build" depends="prepare-entrypoint, get-input-files">
        <for param="curr.dir">
            <path>
                <dirset refid="in.dirs"/>
            </path>
            
            <sequential>
                <echo message="Generating narratives for @{curr.dir}"/>
                <run-narrative-generator in.dir.absolute="@{curr.dir}"/>
            </sequential>
        </for>
    </target>
</project>