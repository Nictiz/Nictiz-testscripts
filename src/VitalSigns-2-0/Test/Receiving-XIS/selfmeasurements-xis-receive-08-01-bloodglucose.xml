<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="server">
    <id value="xis-08-01-receive-bloodglucose"/>
    <version value="stu3-2.0"/>
    <title value="Scenario 8.1 - Receive BloodGlucose measurements of person 'XXX_Herder'"/>
    <description value="Test of scenario 8.1 of the [Vital Signs (Zelfmetingen) Receive use case](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/FHIR_VitalSigns). See [the test file on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/Testscript_Zelfmetingen_Ontvangen) for more information."/>
    <destination>
        <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-destination-title">
            <valueString value="Resource endpoint"/>
        </extension>
        <index value="1"/>
        <profile>
            <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"/>
            <code value="FHIR-Server"/>
        </profile>
    </destination>
    <nts:clAuthExtension patientResourceId="selfmeasurements-Patient-XXX-Herder"/>
    <nts:fixture id="scenario-8-1-bundle-fixture"
        href="bundles/receive/selfmeasurements-receive-scenario-8-1-bloodglucose-bundle.{$_FORMAT}"/>
    <nts:includeDateT value="yes"/>

    <test id="scenario8-1-receive-most-recent-bloodglucose">
        <description value="Receive 1 zib-BloodGlucose instance of person 'XXX_Herder' and check the response"/>
        <nts:include value="medmij/test.xis.successfulBatch" scope="common"
            sourceId="scenario-8-1-bundle-fixture" description="Receive a FHIR batch Bundle, containing an Observation resource and a Patient resource, including a 'Prefer' header, and send a response"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="1"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Patient" count="1"/>
        <action>
            <assert>
                <description value="Confirm that the latest observation resource has the correct bloodglucose value"/>
                <direction value="response"/>
                <expression value="Bundle.entry.resource.ofType(Observation).value.where(value=5.4 and code='mmol/L').exists()"/>
            </assert>
        </action>
    </test>
</TestScript>
