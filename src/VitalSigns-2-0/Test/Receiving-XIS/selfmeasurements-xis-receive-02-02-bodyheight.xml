<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="server">
    <id value="xis-02-02-receive-bodyheight"/>
    <version value="stu3-2.0"/>
    <title value="Scenario 2.2 - Receive BodyHeight measurements of person 'XXX_Herder'"/>
    <description value="Test of scenario 2.2 of the [Vital Signs (Zelfmetingen) Receive use case](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/FHIR_VitalSigns). See [the test file on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/Testscript_Zelfmetingen_Ontvangen) for more information."/>
    <destination>
        <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-destination-title">
            <valueString value="Resource endpoint"/>
        </extension>
        <index value="1"/>
        <profile>
            <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"/>
            <code value="FHIR-Server"/>
        </profile>
    </destination>
    <nts:clAuthExtension patientResourceId="selfmeasurements-Patient-XXX-Herder"/>
    <nts:fixture id="scenario-2-2-bundle-fixture"
        href="bundles/receive/selfmeasurements-receive-scenario-2-2-bodyheight-bundle.{$_FORMAT}"/>
    <nts:includeDateT value="yes"/>

    <test id="scenario2-2-receive-most-recent-bodyheight">
        <description value="Receive 3 zib-BodyHeight instances of person 'XXX_Herder' and check the response"/>
        <nts:include value="medmij/test.xis.successfulBatch" scope="common"
            sourceId="scenario-2-2-bundle-fixture" description="Receive a FHIR batch Bundle, containing 3 Observation resources and a Patient resource, including a 'Prefer' header, and send a response"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="3"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Patient" count="1"/>
        <action>
            <assert>
                <description value="Confirm that the latest observation resource has the correct bodyheight value"/>
                <direction value="response"/>
                <expression value="Bundle.entry.resource.ofType(Observation).where(code.coding.where(code='8302-2' and system='http://loinc.org')).value.ofType(Quantity).where(value=195 and code='cm').exists()"/>
            </assert>
        </action>
        <action>
            <assert>
                <description value="Confirm that the latest observation resource has the correct bodyheight value"/>
                <direction value="response"/>
                <expression value="Bundle.entry.resource.ofType(Observation).where(code.coding.where(code='8302-2' and system='http://loinc.org')).value.ofType(Quantity).where(value=191 and code='cm').exists()"/>
            </assert>
        </action>
        <action>
            <assert>
                <description value="Confirm that the latest observation resource has the correct bodyheight value"/>
                <direction value="response"/>
                <expression value="Bundle.entry.resource.ofType(Observation).where(code.coding.where(code='8302-2' and system='http://loinc.org')).value.ofType(Quantity).where(value=185 and code='cm').exists()"/>
            </assert>
        </action>
    </test>
</TestScript>
