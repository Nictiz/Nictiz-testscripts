<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="client">
    <id value="phr-08-X-retrieve-bloodglucose"/>
    <version value="stu3-2.0"/>
    <title value="Scenario 8.X - Retrieve BloodGlucose measurements of person 'XXX_Smorenburg'"/>
    <description value="Test of scenario 8.X of the [Vital Signs (Zelfmetingen) Retrieve use case](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/FHIR_VitalSigns). See [the test file on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/Testscript_Metingen_Raadplegen) for more information."/>
    <nts:clAuthExtension patientResourceId="selfmeasurements-Patient-XXX-Smorenburg"/>
    <nts:includeDateT value="yes"/>

    <test id="scenario8-1-retrieve-all-bloodglucose">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description value="Retrieve all zib-BloodGlucose instances of person 'XXX_Smorenburg' and check the request"/>
        <nts:include value="medmij/test.phr.search" scope="common"
            resource="Observation"
            params="?code=http://loinc.org|14760-3,http://loinc.org|14743-9,http://loinc.org|14770-2" description="Send a FHIR search on Observation, including the correct 'code' parameter"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="6"/>
    </test>

    <test id="scenario8-2-retrieve-all-bloodglucose">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description value="Retrieve the latest zib-BloodGlucose instances of person 'XXX_Smorenburg' and check the request"/>
        <nts:include value="medmij/test.phr.search" scope="common"
            resource="Observation"
            params="/$lastn?code=http://loinc.org|14760-3,http://loinc.org|14770-2" description="Send a FHIR $lastn search on Observation, including the correct 'code' parameter"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="2"/>

        <action>
            <assert>
                <description value="Confirm that the latest observation resource has the correct bloodglucose value"/>
                <direction value="response"/>
                <expression value="Bundle.entry.resource.ofType(Observation).value.where(value=5.2 and code='mmol/L').exists()"/>
            </assert>
        </action>
    </test>

    <test id="scenario8-3-retrieve-all-bloodglucoses">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description value="Retrieve all zib-BloodGlucose instances from 12 to 1 days ago of person 'XXX_Smorenburg' and check the request"/>
        <nts:include value="medmij/test.phr.search" scope="common"
            resource="Observation"
            params="?code=http://loinc.org|14760-3,http://loinc.org|14743-9,http://loinc.org|14770-2&amp;date=ge${DATE, T, D,-12}&amp;date=le${DATE, T, D,-1}" description="Send a FHIR search on Observation, including the correct 'code' and two 'date' parameters"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="3"/>

        <action>
            <assert>
                <description value="Confirm that resources contain the correct values"/>
                <direction value="response"/>
                <expression value="Bundle.entry.resource.ofType(Observation).value.where(value=5.2 and code='mmol/L').exists()"/>
            </assert>
        </action>
        <action>
            <assert>
                <description value="Confirm that resources contain the correct values"/>
                <direction value="response"/>
                <expression value="Bundle.entry.resource.ofType(Observation).value.where(value=7.4 and code='mmol/L').exists()"/>
            </assert>
        </action>
        <action>
            <assert>
                <description value="Confirm that resources contain the correct values"/>
                <direction value="response"/>
                <expression value="Bundle.entry.resource.ofType(Observation).value.where(value=7.3 and code='mmol/L').exists()"/>
            </assert>
        </action>
    </test>

    <test id="scenario8-4-retrieve-all-bloodglucoses">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description value="Retrieve all zib-BloodGlucose instances from 100 to 50 days ago of person 'XXX_Smorenburg' and check the request"/>
        <nts:include value="medmij/test.phr.search" scope="common"
            resource="Observation"
            params="?code=http://loinc.org|14760-3,http://loinc.org|14743-9,http://loinc.org|14770-2&amp;date=ge${DATE, T, D,-100}&amp;date=le${DATE, T, D,-50}" description="Send a FHIR search on Observation, including the correct 'code' and two 'date' parameters"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="0"/>
    </test>
</TestScript>
