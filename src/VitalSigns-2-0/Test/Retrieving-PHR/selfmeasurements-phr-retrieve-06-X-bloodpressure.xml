<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="client">
    <id value="phr-06-X-retrieve-bloodpressure"/>
    <version value="stu3-2.0"/>
    <title value="Scenario 6.X - Retrieve BloodPressure measurements of person 'XXX_Smorenburg'"/>
    <description value="Test of scenario 6.X of the [Vital Signs (Zelfmetingen) Retrieve use case](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/FHIR_VitalSigns). See [the test file on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/Testscript_Metingen_Raadplegen) for more information."/>
    <nts:clAuthExtension patientResourceId="selfmeasurements-Patient-XXX-Smorenburg"/>
    <nts:includeDateT value="yes"/>

    <test id="scenario6-1-retrieve-all-bloodpressure">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description value="Retrieve all zib-BloodPressure instances of person 'XXX_Smorenburg' and check the request"/>
        <nts:include value="medmij/test.phr.search" scope="common"
            resource="Observation"
            params="?code=http://loinc.org|85354-9" description="Send a FHIR search on Observation, including the correct 'code' parameter"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="5"/>
    </test>

    <test id="scenario6-2-retrieve-all-bloodpressure">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description value="Retrieve the latest zib-BloodPressure instances of person 'XXX_Smorenburg' and check the request"/>
        <nts:include value="medmij/test.phr.search" scope="common"
            resource="Observation"
            params="/$lastn?code=http://loinc.org|85354-9" description="Send a FHIR $lastn search on Observation, including the correct 'code' parameter"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="1"/>

        <action>
            <assert>
                <description value="Confirm that the latest observation resource has the correct bloodpressure value"/>
                <direction value="response"/>
                <expression value="Bundle.entry.resource.ofType(Observation).component.where(code.coding.code='8480-6').value.where(value=123 and code='mm[Hg]').exists()"/>
            </assert>
        </action>
        <action>
            <assert>
                <description value="Confirm that the latest observation resource has the correct bloodpressure value"/>
                <direction value="response"/>
                <expression value="Bundle.entry.resource.ofType(Observation).component.where(code.coding.code='8462-4').value.where(value=82 and code='mm[Hg]').exists()"/>
            </assert>
        </action>
    </test>

    <test id="scenario6-3-retrieve-all-bloodpressures">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description value="Retrieve all zib-BloodPressure instances from 14 to 1 days ago of person 'XXX_Smorenburg' and check the request"/>
        <nts:include value="medmij/test.phr.search" scope="common"
            resource="Observation"
            params="?code=http://loinc.org|85354-9&amp;date=ge${DATE, T, D,-14}&amp;date=le${DATE, T, D,-1}" description="Send a FHIR search on Observation, including the correct 'code' and two 'date' parameters"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="1"/>

            <action>
                <assert>
                    <description value="Confirm that resources contain the correct values"/>
                    <direction value="response"/>
                    <expression value="Bundle.entry.resource.ofType(Observation).component.where(code.coding.code='8480-6').value.where(value=123 and code='mm[Hg]').exists()"/>
                </assert>
            </action>
            <action>
                <assert>
                    <description value="Confirm that resources contain the correct values"/>
                    <direction value="response"/>
                    <expression value="Bundle.entry.resource.ofType(Observation).component.where(code.coding.code='8462-4').value.where(value=82 and code='mm[Hg]').exists()"/>
                </assert>
            </action>
    </test>

    <test id="scenario6-4-retrieve-all-bloodpressures">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description value="Retrieve all zib-BloodPressure instances from 100 to 53 days ago of person 'XXX_Smorenburg' and check the request"/>
        <nts:include value="medmij/test.phr.search" scope="common"
            resource="Observation"
            params="?code=http://loinc.org|85354-9&amp;date=ge${DATE, T, D,-100}&amp;date=le${DATE, T, D,-53}" description="Send a FHIR search on Observation, including the correct 'code' and two 'date' parameters"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="0"/>
    </test>
</TestScript>
