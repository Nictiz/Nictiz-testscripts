<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="server">
    <id value="xis-serve-09-X-heartrate"/>
    <version value="stu3-2.0"/>
    <title value="Scenario 9.X - Serve HeartRate measurements of person 'XXX_Smorenburg'"/>
    <description value="Test of scenario 9.X of the [Vital Signs (Zelfmetingen) Serve use case](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/FHIR_VitalSigns). See [the test file on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/Testscript_Metingen_Beschikbaarstellen) for more information."/>
    <destination>
        <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-destination-title">
            <valueString value="Resource endpoint"/>
        </extension>
        <index value="1"/>
        <profile>
            <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"/>
            <code value="FHIR-Server"/>
        </profile>
    </destination>
    <nts:clAuthExtension patientResourceId="selfmeasurements-Patient-XXX-Smorenburg"/>
    <nts:includeDateT value="yes"/>

    <test id="scenario9-1-serve-all-heartrate">
        <description value="Serve all zib-HeartRate instances of person 'XXX_Smorenburg' and check the response"/>
        <nts:include value="medmij/test.xis.successfulSearch" scope="common"
            resource="Observation"
            params="?code=http://loinc.org|8867-4" description="Receive a FHIR search on Observation, including 'code' parameter, and send a response"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="5"/>
    </test>

    <test id="scenario9-2-serve-all-heartrate">
        <description value="Serve the latest zib-HeartRate instances of person 'XXX_Smorenburg' and check the response"/>
        <nts:include value="medmij/test.xis.successfulSearch" scope="common"
            resource="Observation"
            params="/$lastn?code=http://loinc.org|8867-4" description="Receive a FHIR $lastn search on Observation, including 'code' parameter, and send a response"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="1"/>

        <action>
            <assert>
                <description value="Confirm that the latest observation resource has the correct heartrate value"/>
                <direction value="response"/>
                <expression value="Bundle.entry.resource.ofType(Observation).where(code.coding.code='8867-4' and code.coding.system='http://loinc.org').value.ofType(Quantity).where(value=63 and code='/min').exists()"/>
            </assert>
        </action>
    </test>

    <test id="scenario9-3-serve-all-heartrates">
        <description value="Serve all zib-HeartRate instances from 120 to 100 days ago of person 'XXX_Smorenburg' and check the response"/>
        <nts:include value="medmij/test.xis.successfulSearch" scope="common"
            resource="Observation"
            params="?code=http://loinc.org|8867-4&amp;date=ge${DATE, T, D,-120}&amp;date=le${DATE, T, D,-100}" description="Receive a FHIR search on Observation, including 'code' and two 'date' parameters, and send a response"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="2"/>

        <action>
            <assert>
                <description value="Confirm that resources contain the correct values"/>
                <direction value="response"/>
                <expression value="Bundle.entry.resource.ofType(Observation).where(code.coding.code='8867-4' and code.coding.system='http://loinc.org').value.ofType(Quantity).where(value=65 and code='/min').exists()"/>
            </assert>
        </action>
        <action>
            <assert>
                <description value="Confirm that resources contain the correct values"/>
                <direction value="response"/>
                <expression value="Bundle.entry.resource.ofType(Observation).where(code.coding.code='8867-4' and code.coding.system='http://loinc.org').value.ofType(Quantity).where(value=64 and code='/min').exists()"/>
            </assert>
        </action>        
    </test>

    <test id="scenario9-4-serve-all-heartrates">
        <description value="Serve all zib-HeartRate instances from 80 to 40 days ago of person 'XXX_Smorenburg' and check the response"/>
        <nts:include value="medmij/test.xis.successfulSearch" scope="common"
            resource="Observation"
            params="?code=http://loinc.org|8867-4&amp;date=ge${DATE, T, D,-80}&amp;date=le${DATE, T, D,-40}" description="Receive a FHIR search on Observation, including 'code' and two 'date' parameters, and send a response"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="0"/>
    </test>
</TestScript>
