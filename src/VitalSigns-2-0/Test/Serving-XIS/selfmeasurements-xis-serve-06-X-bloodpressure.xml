<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="server">
    <id value="xis-serve-06-X-bloodpressure"/>
    <version value="stu3-2.0"/>
    <title value="Scenario 6.X - Serve BloodPressure measurements of person 'XXX_Smorenburg'"/>
    <description value="Test of scenario 6.X of the [Vital Signs (Zelfmetingen) Serve use case](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/FHIR_VitalSigns). See [the test file on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/Testscript_Metingen_Beschikbaarstellen) for more information."/>
    <destination>
        <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-destination-title">
            <valueString value="Resource endpoint"/>
        </extension>
        <index value="1"/>
        <profile>
            <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"/>
            <code value="FHIR-Server"/>
        </profile>
    </destination>
    <nts:clAuthExtension patientResourceId="selfmeasurements-Patient-XXX-Smorenburg"/>
    <nts:includeDateT value="yes"/>

    <test id="scenario6-1-serve-all-bloodpressure">
        <description value="Serve all zib-BloodPressure instances of person 'XXX_Smorenburg' and check the response"/>
        <nts:include value="medmij/test.xis.successfulSearch" scope="common"
            resource="Observation"
            params="?code=http://loinc.org|85354-9" description="Receive a FHIR search on Observation, including 'code' parameter, and send a response"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="5"/>
    </test>

    <test id="scenario6-2-serve-all-bloodpressure">
        <description value="Serve the latest zib-BloodPressure instances of person 'XXX_Smorenburg' and check the response"/>
        <nts:include value="medmij/test.xis.successfulSearch" scope="common"
            resource="Observation"
            params="/$lastn?code=http://loinc.org|85354-9" description="Receive a FHIR $lastn search on Observation, including 'code' parameter, and send a response"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="1"/>

        <action>
            <assert>
                <description value="Confirm that the latest observation resource has the correct bloodpressure value"/>
                <direction value="response"/>
                <expression value="Bundle.entry.resource.ofType(Observation).component.where(code.coding.code='8480-6').value.where(value=123 and code='mm[Hg]').exists()"/>
            </assert>
        </action>
        <action>
            <assert>
                <description value="Confirm that the latest observation resource has the correct bloodpressure value"/>
                <direction value="response"/>
                <expression value="Bundle.entry.resource.ofType(Observation).component.where(code.coding.code='8462-4').value.where(value=82 and code='mm[Hg]').exists()"/>
            </assert>
        </action>
    </test>

    <test id="scenario6-3-serve-all-bloodpressures">
        <description value="Serve all zib-BloodPressure instances from 55 to 20 days ago of person 'XXX_Smorenburg' and check the response"/>
        <nts:include value="medmij/test.xis.successfulSearch" scope="common"
            resource="Observation"
            params="?code=http://loinc.org|85354-9&amp;date=ge${DATE, T, D,-55}&amp;date=le${DATE, T, D,-20}" description="Receive a FHIR search on Observation, including 'code' and two 'date' parameters, and send a response"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="4"/>

            <action>
                <assert>
                    <description value="Confirm that the latest observation resource has the correct bloodpressure value"/>
                    <direction value="response"/>
                    <expression value="Bundle.entry.resource.ofType(Observation).component.where(code.coding.code='8480-6').value.where(value=127 and code='mm[Hg]').exists()"/>
                </assert>
            </action>
            <action>
                <assert>
                    <description value="Confirm that the latest observation resource has the correct bloodpressure value"/>
                    <direction value="response"/>
                    <expression value="Bundle.entry.resource.ofType(Observation).component.where(code.coding.code='8462-4').value.where(value=85 and code='mm[Hg]').exists()"/>
                </assert>
            </action>
            <action>
                <assert>
                    <description value="Confirm that the latest observation resource has the correct bloodpressure value"/>
                    <direction value="response"/>
                    <expression value="Bundle.entry.resource.ofType(Observation).component.where(code.coding.code='8480-6').value.where(value=131 and code='mm[Hg]').exists()"/>
                </assert>
            </action>
            <action>
                <assert>
                    <description value="Confirm that the latest observation resource has the correct bloodpressure value"/>
                    <direction value="response"/>
                    <expression value="Bundle.entry.resource.ofType(Observation).component.where(code.coding.code='8462-4').value.where(value=87 and code='mm[Hg]').exists()"/>
                </assert>
            </action>
            <action>
                <assert>
                    <description value="Confirm that the latest observation resource has the correct bloodpressure value"/>
                    <direction value="response"/>
                    <expression value="Bundle.entry.resource.ofType(Observation).component.where(code.coding.code='8480-6').value.where(value=135 and code='mm[Hg]').exists()"/>
                </assert>
            </action>
            <action>
                <assert>
                    <description value="Confirm that the latest observation resource has the correct bloodpressure value"/>
                    <direction value="response"/>
                    <expression value="Bundle.entry.resource.ofType(Observation).component.where(code.coding.code='8462-4').value.where(value=90 and code='mm[Hg]').exists()"/>
                </assert>
            </action>
            <action>
                <assert>
                    <description value="Confirm that the latest observation resource has the correct bloodpressure value"/>
                    <direction value="response"/>
                    <expression value="Bundle.entry.resource.ofType(Observation).component.where(code.coding.code='8480-6').value.where(value=132 and code='mm[Hg]').exists()"/>
                </assert>
            </action>
            <action>
                <assert>
                    <description value="Confirm that the latest observation resource has the correct bloodpressure value"/>
                    <direction value="response"/>
                    <expression value="Bundle.entry.resource.ofType(Observation).component.where(code.coding.code='8462-4').value.where(value=87 and code='mm[Hg]').exists()"/>
                </assert>
            </action>
    </test>

    <test id="scenario6-4-serve-all-bloodpressures">
        <description value="Serve all zib-BloodPressure instances from 10 to 1 days ago of person 'XXX_Smorenburg' and check the response"/>
        <nts:include value="medmij/test.xis.successfulSearch" scope="common"
            resource="Observation"
            params="?code=http://loinc.org|85354-9&amp;date=ge${DATE, T, D,-10}&amp;date=le${DATE, T, D,-1}" description="Receive a FHIR search on Observation, including 'code' and two 'date' parameters, and send a response"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="0"/>
    </test>
</TestScript>
