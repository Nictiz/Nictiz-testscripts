<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="client">
    <id value="phr-1-retrieve-vitalsigns"/>
    <version value="stu3-2.0"/>
    <title value="Scenarios 1.1 to 1.7 - Retrieve Vital Signs of XXX_Bourgonjee"/>
    <description value="Qualification of scenarios 1.1 to 1.7 of the [Vital Signs (Zelfmetingen) Serve use case](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/FHIR_VitalSigns). See [the test file on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/Zelfmetingen_Raadplegen) for more information."/>
    <nts:clAuthExtension patientResourceId="selfmeasurement-patient-kwalificatie1" id="XXX_Bourgonjee"/>
    <nts:includeDateT value="yes"/>

    <test id="scenario1-1-retrieve-all-bloodpressure">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description value="Retrieve all zib-BloodPressure instances of person 'XXX_Bourgonjee' and check the request"/>
        <nts:include value="medmij/test.phr.search" scope="common"
            resource="Observation"
            params="?code=http://loinc.org|85354-9"
            description="Send a FHIR search on Observation, including the correct 'code' parameter"/>
        <nts:include value="canary-assert.response.successfulSearch" scope="common"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="2"/>
    </test>

    <test id="scenario1-2-retrieve-latest-bodyweight">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description value="Retrieve the latest zib-BodyWeight instance of person 'XXX_Bourgonjee' and check the request"/>
        <nts:include value="medmij/test.phr.search" scope="common"
            resource="Observation"
            params="/$lastn?code=http://loinc.org|29463-7"
            description="Send a FHIR $lastn search on Observation, including the correct 'code' parameter"/>
        <nts:include value="canary-assert.response.successfulSearch" scope="common"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="1"/>
    </test>

    <test id="scenario1-3-retrieve-all-bloodglucose">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description value="Retrieve all zib-BloodGlucose instances of person 'XXX_Bourgonjee' and check the request"/>
        <nts:include value="medmij/test.phr.search" scope="common"
            resource="Observation"
            params="?code=http://loinc.org|14760-3,http://loinc.org|14743-9,http://loinc.org|14770-2"
            description="Send a FHIR search on Observation, including the correct 'code' parameter"/>
        <nts:include value="canary-assert.response.successfulSearch" scope="common"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="3"/>
    </test>

    <test id="scenario1-4-retrieve-all-heartrate">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description value="Retrieve all zib-HeartRate instances of person 'XXX_Bourgonjee' and check the request"/>
        <nts:include value="medmij/test.phr.search" scope="common"
            resource="Observation"
            params="?code=http://loinc.org|8867-4"
            description="Send a FHIR search on Observation, including the correct 'code' parameter"/>
        <nts:include value="canary-assert.response.successfulSearch" scope="common"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="2"/>
    </test>

    <test id="scenario1-5-retrieve-period-bloodpressure">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description value="Retrieve all zib-BloodPressure instances from a specific period of 50 days in the past of person 'XXX_Bourgonjee' and check the response"/>
        <nts:include value="medmij/test.phr.search" scope="common"
            resource="Observation"
            params="?code=http://loinc.org|85354-9&amp;date=ge${DATE, T, D,-100}&amp;date=le${DATE, T, D,-50}"
            description="Send a FHIR search on Observation, including the correct 'code' and two 'date' parameters"/>
        <nts:include value="canary-assert.response.successfulSearch" scope="common"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="0"/>
    </test>

    <test id="scenario1-6-retrieve-period-observation">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description value="Retrieve multiple types of VitalSigns instances from the last 30 days of person 'XXX_Bourgonjee' and check the response"/>
        <nts:include value="medmij/test.phr.search" scope="common"
            resource="Observation"
            params="?code=http://loinc.org|85354-9,http://loinc.org|29463-7,http://loinc.org|14760-3,http://loinc.org|14743-9,http://loinc.org|14770-2,http://loinc.org|8867-4&amp;date=ge${DATE, T, D,-30}&amp;date=le${DATE, T, D,-0}"
            description="Send a FHIR search on Observation, including the correct 'code' and two 'date' parameters"/>
        <nts:include value="canary-assert.response.successfulSearch" scope="common"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="8"/>
    </test>

    <test id="scenario1-7-retrieve-all-vitalsign-observation">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description value="Retrieve all VitalSigns instances of person 'XXX_Bourgonjee' and check the response"/>
        <nts:include value="medmij/test.phr.search" scope="common"
            resource="Observation"
            params="?category=vital-signs"
            description="Send a FHIR search on Observation, including the correct 'category' parameter"/>
        <nts:include value="canary-assert.response.successfulSearch" scope="common"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="6"/>
    </test>
</TestScript>
