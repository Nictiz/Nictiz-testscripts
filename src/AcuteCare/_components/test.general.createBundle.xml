<?xml version="1.0" encoding="UTF-8"?>
<!--
    teardown component for AcuteCare test scripts. This component is used to delete the bundle resource created during the test run.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <action>
        <operation> <!-- Bundle is handled as a create/POST. The bundle is saved as a resource. -->
            <type>
                <system value="http://hl7.org/fhir/restful-interaction" />
                <code value="create" />
            </type>
            <resource value="Bundle" />
            <description value="{$operationDescription}" />
            <origin value="1" />
            <destination value="1" />
            <encodeRequestUrl value="true" />
            <sourceId value="scenario-bundle-fixture" />
            <responseId value="scenario-bundle-response" />
        </operation>
    </action>
</nts:component>
