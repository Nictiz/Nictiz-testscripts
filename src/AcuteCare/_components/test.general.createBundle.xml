<?xml version="1.0" encoding="UTF-8"?>
<!--
Bundle is handled as a create/POST. The bundle is saved as a resource.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <action>
        <operation> 
            <type>
                <system value="http://hl7.org/fhir/restful-interaction" />
                <code value="create" />
            </type>
            <resource value="Bundle" />
            <description value="{$description}" />
            <origin value="1" />
            <destination value="1" />
            <encodeRequestUrl value="true" />
            <sourceId value="scenario-bundle-fixture" />
            <responseId value="scenario-bundle-response" />
            <requestHeader>
               <field value="Authorization"/>
               <value value="FILL YOUR TOKEN"/>
            </requestHeader>
        </operation>
    </action>
</nts:component>
