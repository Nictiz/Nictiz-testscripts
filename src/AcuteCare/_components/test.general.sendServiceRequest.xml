<?xml version="1.0" encoding="UTF-8"?>
<!--
    ServiceRequest is handled with the transaction operation. 
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <variable>
        <name value="Patient-id" />
        <description value="The id of the patient resource" />
        <expression
            value="Bundle.entry.resource.where($this is ServiceRequest).subject.reference.replaceMatches('^Patient/', '')" />
        <sourceId value="scenario-servicerequest-request" />
    </variable>
    <variable>
        <name value="Encounter-id" />
        <description value="The id of the patient resource" />
        <expression
            value="Bundle.entry.resource.where($this is ServiceRequest).subject.reference.replaceMatches('^Encounter/', '')" />
        <sourceId value="scenario-servicerequest-request" />
    </variable>
    <variable>
        <name value="PractitionerRole-id" />
        <description value="The id of the patient resource" />
        <expression
            value="Bundle.entry.resource.where($this is ServiceRequest).subject.reference.replaceMatches('^PractitionerRole/', '')" />
        <sourceId value="scenario-servicerequest-request" />
    </variable>
    <variable>
        <name value="Organization-id" />
        <description value="The id of the patient resource" />
        <expression
            value="Bundle.entry.resource.where($this is ServiceRequest).subject.reference.replaceMatches('^Organization/', '')" />
        <sourceId value="scenario-servicerequest-request" />
    </variable>
    <variable>
        <name value="Composition-id" />
        <description value="The id of the patient resource" />
        <expression
            value="Bundle.entry.resource.where($this is ServiceRequest).subject.reference.replaceMatches('^Composition/', '')" />
        <sourceId value="scenario-servicerequest-request" />
    </variable>
    <variable>
        <name value="DocumentReference-id" />
        <description value="The id of the patient resource" />
        <expression
            value="Bundle.entry.resource.where($this is ServiceRequest).subject.reference.replaceMatches('^DocumentReference/', '')" />
        <sourceId value="scenario-servicerequest-request" />
    </variable>
    
    <action>
        <operation> 
            <type>
                <system value="http://terminology.hl7.org/CodeSystem/testscript-operation-codes"/>
                <code value="transaction"/>
            </type>
            <method value="post" />
            <description value="{$description}" />
            <origin value="1" />
            <destination value="1" />
            <encodeRequestUrl value="true" />
            <sourceId value="scenario-servicerequest-fixture" />
            <requestId value="scenario-servicerequest-request" />
            <responseId value="scenario-servicerequest-response" />
            <nts:include value="header.request.PatientToken" scope="common"/>
        </operation>
    </action>
</nts:component>
