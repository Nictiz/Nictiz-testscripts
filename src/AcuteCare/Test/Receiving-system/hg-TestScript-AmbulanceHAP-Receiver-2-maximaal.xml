<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
  nts:scenario="server">
  <id value="hg-TestScript-AmbulanceHAP-Receiver-2-maximaal" />
  <version value="0.1.0-alpha.1" />
  <title value="Scenario 2 - Receive maximaal" />
  <description value="Receive an ambulance-to-HAP referral message with a maximally populated message" />
  <nts:authToken patientResourceId="patient-van-XXX-Baatenburg"/>
  <nts:fixture id="scenario-servicerequest-fixture"
        href="bundles/bundle-az-ave-tst-2-maximaal-servicerequest-az-ave-tst-2-maximaal.{$_FORMAT}" />
  <origin>
    <index value="1"/>
    <profile>
        <system value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-origin-profile"/>
        <code value="Conformancelab-Client"/>
    </profile>
  </origin>
  <destination>
    <index value="1"/>
    <profile>
        <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"/>
        <code value="FHIR-Server"/>
    </profile>
  </destination>
  <origin>
    <index value="2"/>
    <profile>
        <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-origin-types"/>
        <code value="FHIR-Client"/>
    </profile>
  </origin>
  <destination>
    <index value="2"/>
    <profile>
        <system value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-destination-profile"/>
        <code value="Conformancelab-Server"/>
    </profile>
  </destination>

  <test id="01-receive-ambulance-referral">
    <description value="Receive ServiceRequest az-ave-tst-2-maximaal." />
    <nts:include value="test.general.sendServiceRequest" description="Receive the ambulance-to-HAP referral message ServiceRequest from the sender." />
  </test>

  <test id="02-retrieve-ambulance-referral-patient">
        <description value="Retrieve Patient az-ave-tst-2-maximaal." />
        <nts:include value="test.general.serveResource" 
            description="The retrieving system (SUT) retrieves the ambulance-to-HAP referral Patient resource." 
            resource = "Patient"
            params="/${Patient-id}"
            useToken="true" />
    </test>

    <test id="03-retrieve-ambulance-referral-encounter">
        <description value="Retrieve Encounter az-ave-tst-2-maximaal." />
        <nts:include value="test.general.serveResource" 
            description="The retrieving system (SUT) retrieves the ambulance-to-HAP referral Encounter resource." 
            resource = "Encounter"
            params="/${Encounter-id}"
            useToken="true" />
    </test>

    <test id="04-retrieve-ambulance-referral-practitionerrole">
        <description value="Retrieve PractitionerRole az-ave-tst-2-maximaal." />
        <nts:include value="test.general.serveResource" 
            description="The retrieving system (SUT) retrieves the ambulance-to-HAP referral PractitionerRole resource." 
            resource = "PractitionerRole"
            params="/${PractitionerRole-id}"
            useToken="true" />
    </test>

    <test id="05-retrieve-ambulance-referral-organization">
        <description value="Retrieve Organization az-ave-tst-2-maximaal." />
        <nts:include value="test.general.serveResource" 
            description="The retrieving system (SUT) retrieves the ambulance-to-HAP referral Organization resource." 
            resource = "Organization"
            params="/${Organization-id}"
            useToken="true" />
    </test>

    <test id="06-retrieve-ambulance-referral-composition">
        <description value="Retrieve Composition az-ave-tst-2-maximaal." />
        <nts:include value="test.general.serveResource" 
            description="The retrieving system (SUT) retrieves the ambulance-to-HAP referral Composition resource." 
            resource = "Composition"
            params="/${Composition-id}"
            useToken="true" />
    </test>
    
    <test id="07-retrieve-ambulance-referral-documentreference">
        <description value="Retrieve DocumentReference az-ave-tst-2-maximaal." />
        <nts:include value="test.general.serveResource" 
            description="The retrieving system (SUT) retrieves the ambulance-to-HAP referral DocumentReference resource." 
            resource = "DocumentReference"
            params="/${DocumentReference-id}"
            useToken="true" />
    </test>
  
  <nts:include value="teardown.general.servicerequest" nts:in-targets="Nictiz-internal"/>
</TestScript>