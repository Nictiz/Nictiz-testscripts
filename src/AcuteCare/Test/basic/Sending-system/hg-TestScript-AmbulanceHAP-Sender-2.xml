<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
	nts:scenario="client">
	<id value="hg-TestScript-AmbulanceHAP-Sender-2" />
	<version value="0.1.0-alpha.1" />
	<title value="Scenario 2 - Send minimal" />
	<description value="Send an ambulance-to-HAP referral message with a lean message" />

	<nts:fixture id="scenario-bundle-fixture"
		href="REPLACE-Bundle-hg-ReferralBundle-AmbulanceHAP-min.xml" />

	<test id="01-send-ambulance-referral">
		<description value="Send patient az-ave-tst-3-minimaalTestdag." />
		<nts:include value="test.general.createBundle" description="The sending system (SUT) pushes the ambulance-to-HAP referral message Bundle. PROVISIONAL: modelled as a create/POST pending the exchange-paradigm choice (#14)." />
		<nts:include value="assert.response.success" scope="common" />
		<action>
            <assert>
                <description value="The pushed resource is a Bundle."/>
                <direction value="request"/>
                <resource value="Bundle"/>
                <stopTestOnFail value="true"/>
                <warningOnly value="false"/>
            </assert>
        </action>
        <action>
            <assert>
                <description value="The pushed Bundle is a message Bundle (Bundle.type = message)."/>
                <direction value="request"/>
                <expression value="Bundle.type = 'message'"/>
                <stopTestOnFail value="true"/>
                <warningOnly value="false"/>
            </assert>
        </action>
        <action>
            <assert>
                <description value="The pushed Bundle is a message Bundle (Bundle.type = message)."/>
                <direction value="request"/>
                <expression value="Bundle.type = 'message'"/>
                <stopTestOnFail value="true"/>
                <warningOnly value="false"/>
            </assert>
        </action>
        
        <nts:include value="assert.request.bundleContent" scope="common" />
        
        <action>
            <assert>
                <description value="The MessageHeader carries the AMB-naar-HAP transaction event (145)."/>
                <direction value="request"/>
                <expression value="Bundle.entry.resource.ofType(MessageHeader).event.ofType(Coding).code = '145'"/>
                <stopTestOnFail value="true"/>
                <warningOnly value="false"/>
            </assert>
        </action>
        <action>
            <assert>
                <description value="The MessageHeader focuses a resource (the referral ServiceRequest)."/>
                <direction value="request"/>
                <expression value="Bundle.entry.resource.ofType(MessageHeader).focus.exists()"/>
                <stopTestOnFail value="false"/>
                <warningOnly value="false"/>
            </assert>
        </action>
        <action>
            <assert>
                <description value="The Composition carries the mandatory 'reason for referral' section (SNOMED 440378000)."/>
                <direction value="request"/>
                <expression value="Bundle.entry.resource.ofType(Composition).section.code.coding.where(system = 'http://snomed.info/sct' and code = '440378000').exists()"/>
                <stopTestOnFail value="false"/>
                <warningOnly value="false"/>
            </assert>
        </action> 
	</test>
	
    <nts:include value="teardown.general.bundle"/>
</TestScript>