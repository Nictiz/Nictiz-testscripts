<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="client">
    <id value="hg-TestScript-AmbulanceHAP-Sender-2-maximaal" />
    <version value="0.1.0-alpha.1" />
    <title value="Scenario 2 - Send maximal" />
    <description value="Send an ambulance-to-HAP referral message with a maximally populated message" />
    <nts:authToken patientResourceId="patient-"/>
    <nts:fixture id="scenario-servicerequest-fixture"
        href="bundles/bundle-az-ave-tst-2-maximaal-servicerequest-az-ave-tst-2-maximaal.xml"/>

    <origin>
        <index value="1"/>
        <profile>
            <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-origin-types"/>
            <code value="FHIR-Client"/>
        </profile>
    </origin>
    <destination>
        <index value="1"/>
        <profile>
            <system value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-destination-profile"/>
            <code value="Conformancelab-Server"/>
        </profile>
    </destination>
    <origin>
        <index value="2"/>
        <profile>
            <system value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-origin-profile"/>
            <code value="Conformancelab-Client"/>
        </profile>
    </origin>
    <destination>
        <index value="2"/>
        <profile>
            <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"/>
            <code value="FHIR-Server"/>
        </profile>
    </destination>

    <variable>
        <name value="created-servicerequest-id" />
        <description value="The id of the created ServiceRequest resource" />
        <expression
            value="Bundle.entry.response.location.where(startsWith('ServiceRequest/')).replaceMatches('^ServiceRequest/([^/]+).*$','$1')" />
        <sourceId value="scenario-servicerequest-response" />
    </variable>

    <test id="01-send-ambulance-referral-servicerequest">
        <description value="Send ServiceRequest az-ave-tst-2-maximaal." />
        <nts:include value="test.general.sendServiceRequest" description="The sending system (SUT) pushes the ambulance-to-HAP referral servicerequest." />
        <nts:include value="assert.request.bundleContent" scope="common" />
        <nts:contentAsserts href="bundles/bundle-az-ave-tst-2-maximaal-servicerequest-az-ave-tst-2-maximaal.xml" nts:in-targets="CheckContent"/>
    </test>

    <test id="02-serve-ambulance-referral-patient">
        <description value="Serve Patient az-ave-tst-2-maximaal." />
        <nts:include value="test.general.serveResource" 
            description="The sending system (SUT) serves the ambulance-to-HAP referral Patient resource." 
            resource = "Patient"
            params="/${Patient-id}"
            dirResponse="true"
            useToken="true" />
        <nts:contentAsserts href="fixtures/az-ave-tst-2-maximaal-patient-van-XXX-Baatenburg.xml" nts:in-targets="CheckContent"/>
    </test>

    <test id="03-serve-ambulance-referral-encounter">
        <description value="Serve Encounter az-ave-tst-2-maximaal." />
        <nts:include value="test.general.serveResource" 
            description="The sending system (SUT) serves the ambulance-to-HAP referral Encounter resource." 
            resource = "Encounter"
            params="/${Encounter-id}"
            dirResponse="true"
            useToken="true" />
        <nts:contentAsserts href="fixtures/az-ave-tst-2-maximaal-encounter-25-2020-10-1.xml" nts:in-targets="CheckContent"/>
    </test>

    <test id="04-serve-ambulance-referral-practitionerrole">
        <description value="Serve PractitionerRole az-ave-tst-2-maximaal." />
        <nts:include value="test.general.serveResource" 
            description="The sending system (SUT) serves the ambulance-to-HAP referral PractitionerRole resource." 
            resource = "PractitionerRole"
            params="/${PractitionerRole-id}"
            dirResponse="true"
            useToken="true" />
        <nts:contentAsserts href="fixtures/az-ave-tst-2-maximaal-pracrole-123456789.xml" nts:in-targets="CheckContent"/>
    </test>

    <test id="05-serve-ambulance-referral-organization">
        <description value="Serve Organization az-ave-tst-2-maximaal." />
        <nts:include value="test.general.serveResource" 
            description="The sending system (SUT) serves the ambulance-to-HAP referral Organization resource." 
            resource = "Organization"
            params="/${Organization-id}"
            dirResponse="true"
            useToken="true" />
        <nts:contentAsserts href="fixtures/az-ave-tst-2-maximaal-org-6010860.xml" nts:in-targets="CheckContent"/>
    </test>

    <test id="06-serve-ambulance-referral-composition">
        <description value="Serve Composition az-ave-tst-2-maximaal." />
        <nts:include value="test.general.serveResource" 
            description="The sending system (SUT) serves the ambulance-to-HAP referral Composition resource." 
            resource = "Composition"
            params="/${Composition-id}"
            dirResponse="true"
            useToken="true" />
        <nts:contentAsserts href="fixtures/az-ave-tst-2-maximaal-composition-ambu-az-ave-tst-2-maximaal.xml" nts:in-targets="CheckContent"/>
    </test>
    
    <test id="07-serve-ambulance-referral-documentreference">
        <description value="Serve DocumentReference az-ave-tst-2-maximaal." />
        <nts:include value="test.general.serveResource" 
            description="The sending system (SUT) serves the ambulance-to-HAP referral DocumentReference resource." 
            resource = "DocumentReference"
            params="/${DocumentReference-id}"
            dirResponse="true"
            useToken="true" />
        <nts:contentAsserts href="fixtures/az-ave-tst-2-maximaal-documentreference-9068.xml" nts:in-targets="CheckContent"/>
    </test>
    <nts:include value="teardown.general.servicerequest"/>
</TestScript>