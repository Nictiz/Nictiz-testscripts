<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="client">
    <id value="hg-TestScript-AmbulanceHAP-Sender-1" />
    <version value="0.1.0-alpha.1" />
    <title value="Scenario 1 - Send maximal" />
    <description value="Send an ambulance-to-HAP referral message with a richly populated message" />

    <variable>
        <name value="created-patient-id" />
        <description value="The id of the created patient resource" />
        <expression
            value="Bundle.entry.where(response.location.startsWith('Patient/')).response.location.split('/')[1]" />
        <sourceId value="scenario-bundle-response" />
    </variable>

    <nts:fixture id="scenario-bundle-fixture"
        href="REPLACE-Bundle-hg-ReferralBundle-AmbulanceHAP-max.xml" />

    <test id="01-send-ambulance-referral">
        <description value="Send patient az-ave-tst-2-maximaal." />
        <action>
            <operation>
                <type>
                    <system value="http://hl7.org/fhir/restful-interaction" />
                    <code value="create" />
                </type>
                <description
                    value="The sending system (SUT) pushes the ambulance-to-HAP referral message Bundle. PROVISIONAL: modelled as a create/POST pending the exchange-paradigm choice (#14)." />
                <origin value="1" />
                <destination value="1" />
                <encodeRequestUrl value="true" />
                <sourceId value="scenario-bundle-fixture" />
                <responseId value="scenario-bundle-response" />
            </operation>
        </action>
        <nts:include value="assert.response.success" scope="common" />
        <nts:include value="assert.request.bundleContent" scope="common" />
    </test>
    <teardown>
        <name value="teardown" />
        <description value="Delete the created resources" />
        <action>
            <operation>
                <type>
                    <system
                        value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-operation-codes" />
                    <code value="purge" />
                </type>
                <description
                    value="Delete all resources created during this test run that are associated with the created Patient resource." />
                <resource value="Patient" />
                <encodeRequestUrl value="true" />
                <params value="/${created-patient-id}/$purge" />
                <requestHeader>
                    <field value="Prefer" />
                    <value value="return=representation" />
                </requestHeader>
            </operation>
        </action>
    </teardown>
</TestScript>