<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="client">
    <id value="hg-TestScript-AmbulanceHAP-Sender-1-minimaal" />
    <version value="0.1.0-alpha.1" />
    <title value="Scenario 1 - Send minimal" />
    <description value="Send an ambulance-to-HAP referral message with a minimally populated message" />
    <nts:authToken patientResourceId="patient-"/>
    <nts:fixture id="scenario-servicerequest-fixture"
        href="bundles/bundle-az-ave-tst-1-minimaal-servicerequest-az-ave-tst-1-minimaal.xml"/>

    <origin>
        <index value="1"/>
        <profile>
            <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-origin-types"/>
            <code value="FHIR-Client"/>
        </profile>
    </origin>
    <destination>
        <index value="1"/>
        <profile>
            <system value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-destination-profile"/>
            <code value="Conformancelab-Server"/>
        </profile>
    </destination>
    <origin>
        <index value="2"/>
        <profile>
            <system value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-origin-profile"/>
            <code value="Conformancelab-Client"/>
        </profile>
    </origin>
    <destination>
        <index value="2"/>
        <profile>
            <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"/>
            <code value="FHIR-Server"/>
        </profile>
    </destination>

    <variable>
        <name value="created-servicerequest-id" />
        <description value="The id of the created ServiceRequest resource" />
        <expression
            value="Bundle.entry.response.location.where(startsWith('ServiceRequest/')).replaceMatches('^ServiceRequest/([^/]+).*$','$1')" />
        <sourceId value="scenario-servicerequest-response" />
    </variable>

    <test id="01-send-ambulance-referral-servicerequest">
        <description value="Send ServiceRequest az-ave-tst-1-minimaal." />
        <nts:include value="test.general.sendServiceRequest" description="The sending system (SUT) pushes the ambulance-to-HAP referral servicerequest. PROVISIONAL: modelled as a create/POST pending the exchange-paradigm choice (#14)." />
        <nts:include value="assert.response.success" scope="common" />
        <nts:include value="assert.request.bundleContent" scope="common" />
    </test>

    <test id="02-serve-ambulance-referral-patient">
        <description value="Serve Patient az-ave-tst-1-minimaal." />
        <nts:include value="test.general.serveResource" 
            description="The sending system (SUT) serves the ambulance-to-HAP referral Patient resource. PROVISIONAL: modelled as a create/POST pending the exchange-paradigm choice (#14)." 
            resource = "Patient"
            params="/${Patient-id}"
            useToken="true" />
    </test>

    <test id="03-serve-ambulance-referral-encounter">
        <description value="Serve Patient az-ave-tst-1-minimaal." />
        <nts:include value="test.general.serveResource" 
            description="The sending system (SUT) serves the ambulance-to-HAP referral Encounter resource. PROVISIONAL: modelled as a create/POST pending the exchange-paradigm choice (#14)." 
            resource = "Encounter"
            params="/${Encounter-id}"
            useToken="true" />
    </test>

    <test id="04-serve-ambulance-referral-practitionerrole">
        <description value="Serve Patient az-ave-tst-1-minimaal." />
        <nts:include value="test.general.serveResource" 
            description="The sending system (SUT) serves the ambulance-to-HAP referral PractitionerRole resource. PROVISIONAL: modelled as a create/POST pending the exchange-paradigm choice (#14)." 
            resource = "PractitionerRole"
            params="/${PractitionerRole-id}"
            useToken="true" />
    </test>

    <test id="05-serve-ambulance-referral-organization">
        <description value="Serve Patient az-ave-tst-1-minimaal." />
        <nts:include value="test.general.serveResource" 
            description="The sending system (SUT) serves the ambulance-to-HAP referral Organization resource. PROVISIONAL: modelled as a create/POST pending the exchange-paradigm choice (#14)." 
            resource = "Organziation"
            params="/${Organization-id}"
            useToken="true" />
    </test>

    <test id="06-serve-ambulance-referral-composition">
        <description value="Serve Patient az-ave-tst-1-minimaal." />
        <nts:include value="test.general.serveResource" 
            description="The sending system (SUT) serves the ambulance-to-HAP referral Composition resource. PROVISIONAL: modelled as a create/POST pending the exchange-paradigm choice (#14)." 
            resource = "Composition"
            params="/${Composition-id}"
            useToken="true" />
    </test>
    
    <test id="07-serve-ambulance-referral-documentreference">
        <description value="Serve Patient az-ave-tst-1-minimaal." />
        <nts:include value="test.general.serveResource" 
            description="The sending system (SUT) serves the ambulance-to-HAP referral DocumentReference resource. PROVISIONAL: modelled as a create/POST pending the exchange-paradigm choice (#14)." 
            resource = "DocumentReference"
            params="/${DocumentReference-id}"
            useToken="true" />
    </test>
    <nts:include value="teardown.general.servicerequest"/>
</TestScript>