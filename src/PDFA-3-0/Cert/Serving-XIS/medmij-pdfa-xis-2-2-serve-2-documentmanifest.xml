<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="server">
    <id value="xis-2-2-serve-2-documentmanifest"/>
    <version value="stu3-2.0"/>
    <title value="Scenario 2.2 - Serve two DocumentManifest resources of person 'XXX-Schulte'"/>
    <description value="Qualification of scenario 2.2 of the PDF/A Serve use case. See [the test file on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/PDFA_Beschikbaarstellen) for more information."/>
    <destination>
        <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-destination-title">
            <valueString value="Resource endpoint"/>
        </extension>
        <index value="1"/>
        <profile>
            <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"/>
            <code value="FHIR-Server"/>
        </profile>
    </destination>
    <nts:clAuthExtension patientResourceId="example-pdfa-kwalificatie2" id="XXX_Schulte"/>

    <test id="scenario2-2-serve-2-documentmanifest" nts:in-targets="#default Nictiz-intern">
        <description value="Serve all current DocumentManifest resources and check the response"/>
        <nts:include value="medmij/test.xis.successfulSearch" scope="common"
            resource="DocumentManifest"
            params="?status=current" description="Receive a FHIR search on DocumentManifest, including 'status' parameter, and send a response"/>
        <nts:include value="assert.response.variableNumberOfResults"
            resource="DocumentManifest" min="2" max="3" />
        <nts:include value="assert.response.resourceWithLoinc"
            resourceType="DocumentManifest" code="18842-5"/>
        <nts:include value="assert.response.resourceWithLoinc"
            resourceType="DocumentManifest" code="73575-3"/>

        <nts:include value="assert.response.unknownMasterIdentifier" nts:in-targets="#default"
            resourceType="DocumentManifest" code="18842-5"
            masterIdentifier="urn:oid:1.2.276.0.7230010.3.1.2.1787205428.8024.1526514975.220899"/>
        <nts:include value="assert.response.unknownMasterIdentifier" nts:in-targets="#default"
            resourceType="DocumentManifest" code="73575-3"
            masterIdentifier="urn:oid:1.2.276.0.7230010.3.1.2.9857205428.8024.1526514975.440899"/>
    </test>
    
    <test id="scenario2-2-serve-2-documentmanifest" nts:in-targets="NoManifest">
        <description value="Handle unsupported request for DocumentManifest resources and check the response"/>
        <nts:include value="medmij/test.xis.search" scope="common"
            resource="DocumentManifest"
            params="?status=current" description="Receive a FHIR search on DocumentManifest, including 'status' parameter, and send a response"/>
        <nts:include value="assert.response.unsupportedResource" scope="common"/>
    </test>
</TestScript>
