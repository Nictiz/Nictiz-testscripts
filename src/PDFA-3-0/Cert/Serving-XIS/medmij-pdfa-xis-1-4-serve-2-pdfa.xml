<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="server">
    <id value="xis-1-4-serve-2-pdfa"/>
    <version value="stu3-2.0"/>
    <title value="Scenario 1.4 - Serve two PDFA documents of XXX-Baltus through Binary resources. If PDFA documents are served via an HTTP get, scenario 2.5 should be executed instead"/>
    <description value="Qualification of scenario 1.4 of the PDF/A Serve use case. See [the test file on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/PDFA_Beschikbaarstellen) for more information."/>
    <destination>
        <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-destination-title">
            <valueString value="Resource endpoint"/>
        </extension>
        <index value="1"/>
        <profile>
            <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"/>
            <code value="FHIR-Server"/>
        </profile>
    </destination>
    <nts:clAuthExtension patientResourceId="example-pdfa-kwalificatie1" id="XXX_Baltus"/>
    <nts:profile id="Binary-profile" value="http://hl7.org/fhir/StructureDefinition/Binary"/>

    <test id="scenario1-4-serve-documentreference">
        <description value="Serve all current DocumentReference resources and check the response"/>
        <nts:include value="medmij/test.xis.successfulSearch" scope="common"
            resource="DocumentReference"
            params="?status=current"
            responseId="documentreference-search-response" description="Receive a FHIR search on DocumentReference, including 'status' parameter, and send a response"/>
        <action>
            <assert>
                <description value="Confirm that the returned searchset Bundle contains at least 2 DocumentReference resources."/>
                <direction value="response"/>
                <expression value="Bundle.entry.where(resource.is(DocumentReference)).count() >= 2"/>
            </assert>
        </action>
        <nts:include value="assert.response.resourceWithLoinc" code="68688-1"/>
        <nts:include value="assert.response.resourceWithLoinc" code="34781-5"/>
    </test>

    <test id="scenario1-4-serve-pdfa-document-1">
        <description value="Serve first PDFA document through a Binary resource and check the response"/>
        <nts:include value="variable.fixture.PDFFromBundle"
            variableName="pdfa1-url"
            sourceId="documentreference-search-response"
            index="0"/>
        <nts:include value="operation.xis.readUrl" resource="Binary" url="${pdfa1-url}" description="Receive a FHIR read at the referenced resource URL and send a response"/>
        <nts:include value="assert.response.success" scope="common"/>
        <action>
            <assert>
                <description value="Confirm that the returned resource type is Binary."/>
                <direction value="response"/>
                <resource value="Binary"/>
                <warningOnly value="false"/>
            </assert>
        </action>
        <action>
            <assert>
                <description value="Confirm that the returned Binary conforms to the base FHIR specification."/>
                <direction value="response"/>
                <validateProfileId value="Binary-profile"/>
            </assert>
        </action>
    </test>

    <test id="scenario1-4-serve-pdfa-document-2">
        <description value="Serve second PDFA document through a Binary resource and check the response"/>
        <nts:include value="variable.fixture.PDFFromBundle"
            variableName="pdfa2-url"
            sourceId="documentreference-search-response"
            index="1"/>
        <nts:include value="operation.xis.readUrl" resource="Binary" url="${pdfa2-url}" description="Receive a FHIR read at the referenced resource URL and send a response"/>
        <nts:include value="assert.response.success" scope="common"/>
        <action>
            <assert>
                <description value="Confirm that the returned resource type is Binary."/>
                <direction value="response"/>
                <resource value="Binary"/>
                <warningOnly value="false"/>
            </assert>
        </action>
        <action>
            <assert>
                <description value="Confirm that the returned Binary conforms to the base FHIR specification."/>
                <direction value="response"/>
                <validateProfileId value="Binary-profile"/>
            </assert>
        </action>
    </test>
</TestScript>
