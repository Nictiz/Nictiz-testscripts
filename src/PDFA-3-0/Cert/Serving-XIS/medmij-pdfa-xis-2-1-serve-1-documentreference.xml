<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="server">
    <id value="xis-2-1-serve-1-documentreference"/>
    <version value="stu3-2.0"/>
    <title value="Scenario 2.1 - Serve one DocumentReference resource of person 'XXX-Schulte'"/>
    <description value="Qualification of scenario 2.1 of the PDF/A Serve use case. See [the test file on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/PDFA_Beschikbaarstellen) for more information."/>
    <destination>
        <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-destination-title">
            <valueString value="Resource endpoint"/>
        </extension>
        <index value="1"/>
        <profile>
            <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"/>
            <code value="FHIR-Server"/>
        </profile>
    </destination>
    <nts:clAuthExtension patientResourceId="example-pdfa-kwalificatie2" id="XXX_Schulte"/>

    <test id="scenario2-1-serve-1-documentreference">
        <description value="Serve all current DocumentReference resources and check the response"/>
        <nts:include value="medmij/test.xis.successfulSearch" scope="common"
            resource="DocumentReference"
            params="?status=current" description="Receive a FHIR search on DocumentReference, including 'status' parameter, and send a response"/>
        <nts:include value="assert.response.variableNumberOfResults"
            resource="DocumentReference" min="1" max="2" />
        
        <nts:include value="assert.response.resourceWithLoinc" code="68626-1"/>
        
        <nts:include value="assert.response.unknownMasterIdentifier" nts:in-targets="#default NoManifest"
            code="68626-1"
            masterIdentifier="urn:oid:1.2.276.0.7230010.3.1.2.1787205428.3024.1522314975.287798"/>
    </test>
</TestScript>
