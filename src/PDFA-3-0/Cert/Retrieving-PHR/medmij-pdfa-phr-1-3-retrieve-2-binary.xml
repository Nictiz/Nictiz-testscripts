<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="client">
    <id value="phr-1-3-retrieve-2-binary"/>
    <version value="stu3-2.0"/>
    <title value="Scenario 1.3 - Retrieve Binary resources of person 'XXX-Baltus'"/>
    <description value="Qualification of scenario 1.3 of the PDF/A Retrieve use case. See [the test file on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/PDFA_Raadplegen) for more information."/>
    <nts:clAuthExtension patientResourceId="example-pdfa-kwalificatie1" id="XXX_Baltus"/>

    <nts:fixture id="binary1-fixture" href="resources/medmij-pdfa-Binary-kwalificatie1.xml"/>
    <nts:fixture id="binary2-fixture" href="resources/medmij-pdfa-Binary-kwalificatie2.xml"/>

    <variable>
        <name value="binary1-id"/>
        <expression value="Binary.id"/>
        <sourceId value="binary1-fixture"/>
    </variable>
    <variable>
        <name value="binary2-id"/>
        <expression value="Binary.id"/>
        <sourceId value="binary2-fixture"/>
    </variable>

    <test id="scenario1-3-retrieve-binary-1">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description value="Read Binary resource and check the request"/>
        <nts:include value="medmij/test.phr.read" scope="common"
            resource="Binary" params="/${binary1-id}" description="Send a FHIR read on Binary"/>
        <nts:include value="assert.response.success" scope="common"/>

    </test>
    <test id="scenario1-3-retrieve-binary-2">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description value="Read Binary resource and check the request"/>
        <nts:include value="medmij/test.phr.read" scope="common"
            resource="Binary" params="/${binary2-id}" description="Send a FHIR read on Binary"/>
        <nts:include value="assert.response.success" scope="common"/>
            
    </test>
</TestScript>
