<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="client">
    <id value="phr-3-2-send-2-documents"/>
    <version value="stu3-2.0"/>
    <title value="Scenario 3.2 - Send two documents of person 'XXX-Ellens'"/>
    <description value="Qualification of scenario 3.2 of the PDF/A Receive use case. See [the test file on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/PDFA_Sturen) for more information."/>
    
    <nts:clAuthExtension patientResourceId="example-pdfa-kwalificatie3" id="XXX_Ellens"/>
    <nts:fixture id="scenario-3-2-bundle-fixture"
        href="resources/medmij-pdfa-Bundle-kwalificatie2.xml"/>
    <nts:includeDateT value="yes"/>

    <test id="scenario3-2-send-2-documents">
        <description value="Send two documents in a transaction Bundle and check the request"/>
        <nts:include value="medmij/test.phr.successfulTransaction" scope="common" sourceId="scenario-3-2-bundle-fixture" description="Send a FHIR transaction Bundle"/>
        <nts:include value="assert.request.numResources" scope="common"
            resource="DocumentManifest" count="1"/>
        <nts:include value="assert.request.numResources" scope="common"
            resource="DocumentReference" count="2"/>
        <nts:include value="assert.request.numResources" scope="common"
            resource="Binary" count="2"/>
        <nts:include value="assert.request.numResources" scope="common"
            resource="Patient" count="1"/>
    </test>
</TestScript>
