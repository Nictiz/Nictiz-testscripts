   <!-- Observations - Observaties gekoppeld aan prenatale controle -->
   <test id="6b-ServeObservations">
      <description value="Serve Observations and check the response"/>
      <nts:include value="medmij/test.xis.successfulSearch" scope="common" description="Receive a FHIR search on Observation, including 'context:Encounter.episodeofcare' parameter, and send a response">
         <nts:with-parameter name="resource" value="Observation"/>
         <nts:with-parameter name="params" value="?context:Encounter.episodeofcare=EpisodeOfCare/${episode-id}"/>
      </nts:include>    
      <nts:include value="assert.response.numResources" scope="common">
         <nts:with-parameter name="resource" value="Observation"/>
         <nts:with-parameter name="count" value="0"/>
      </nts:include>
   </test>
   
   <!-- Alle verrichtingen -->
   <test id="7-ServeProcedures">
      <description value="Serve (Obstetric) Procedures and check the response"/>
      <nts:include value="medmij/test.xis.successfulSearch" scope="common" description="Receive a FHIR search on Procedure, including 'context' and two '_include' parameters, and send a response">
         <nts:with-parameter name="resource" value="Procedure"/>
