<?xml version="1.0" encoding="UTF-8"?>
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <action>
        <assert>
            <label value="added NTV check"/>
            <description value="Confirm that the returned entries contain a subject with a reference and display."/>
            <direction value="response"/>
            <expression value="Bundle.entry.take(2).resource.ofType(DocumentReference).all(subject.reference.exists() and subject.display.exists())"/>
            <warningOnly value="false"/>
        </assert>
    </action>
</nts:component>
