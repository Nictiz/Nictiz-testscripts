<?xml version="1.0" encoding="UTF-8"?>
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <action>
        <assert>
            <label value="added NTV check"/>
            <description value="All {$resourceType} resources SHALL have a narrative status of extensions or generated."/>
            <expression value="Bundle.entry.resource.ofType({$resourceType}).all(text.status = 'extensions' or text.status = 'generated')"/>
            <warningOnly value="true"/>
        </assert>
    </action>
    <action>
        <assert>
            <label value="added NTV check"/>
            <description value="{$resourceType}s with resource-level modifier extensions SHALL have a narrative with an allowed status and XHTML content."/>
            <expression value="Bundle.entry.resource.ofType({$resourceType}).all(modifierExtension.empty() or ((text.status = 'extensions' or text.status = 'generated') and text.div.exists()))"/>
            <warningOnly value="true"/>
        </assert>
    </action>
</nts:component>
