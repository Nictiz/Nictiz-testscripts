<?xml version="1.0" encoding="UTF-8"?>
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <action>
        <assert>
            <description value="All DocumentReference resources SHALL have a narrative status of extensions or generated."/>
            <expression value="Bundle.entry.resource.ofType(DocumentReference).all(text.status = 'extensions' or text.status = 'generated')"/>
            <warningOnly value="false"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="DocumentReferences with resource-level modifier extensions SHALL have a narrative with an allowed status and XHTML content."/>
            <expression value="Bundle.entry.resource.ofType(DocumentReference).all(modifierExtension.empty() or ((text.status = 'extensions' or text.status = 'generated') and text.div.exists()))"/>
            <warningOnly value="false"/>
        </assert>
    </action>
</nts:component>
