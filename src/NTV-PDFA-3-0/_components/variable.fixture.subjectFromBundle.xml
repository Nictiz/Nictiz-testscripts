<?xml version="1.0" encoding="UTF-8"?>
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <variable>
        <name value="{$variableName}"/>
        <!-- Pick the absolute url as is or create an absolute url when a relative url is given by combining the base URL given in the Bundle self link with the relative reference.-->
        <expression value="iif(Bundle.entry[{$index}].resource.ofType(DocumentReference).subject.reference.startsWith('Patient/'),
            Bundle.link.where(relation = 'self').url.replaceMatches('DocumentReference[/?].*$', '') + Bundle.entry[{index}].resource.ofType(DocumentReference).subject.reference,
            Bundle.entry[{$index}].resource.ofType(DocumentReference).subject.reference)"/>
        <sourceId value="{$sourceId}"/>
    </variable>
</nts:component>
