<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="server">
    <id value="xis-1-6-serve-without-include"/>
    <version value="stu3-2.0"/>
    <title value="Scenario 1.6 - Serve DocumentReference resources without _include"/>
    <description value="Conditional qualification scenario: during a DocumentReference search without _include, the server voluntarily includes the referenced Patient as an additional searchset entry. The included entry SHALL have search.mode=include. The presence assertion is a scenario precondition, not a general server requirement."/>
    <nts:clAuthExtension patientResourceId="pdfa-validatie1" id="XXX_Baltus"/>

    <test id="scenario1-6-serve-without-include">
        <description value="Serve all current DocumentReference resources."/>
        <nts:include value="medmij/test.xis.successfulSearch" scope="common"
            resource="DocumentReference"
            params="?status=current"
            responseId="documentreference-search-response"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="DocumentReference" count="2" nts:in-targets="#default NoManifest"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="DocumentReference" count="3" nts:in-targets="Nictiz-intern"/>

        <nts:include value="assert.response.resourceWithLoinc" code="68688-1"/>
        <nts:include value="assert.response.resourceWithLoinc" code="34781-5"/>
        <nts:include value="assert.response.resourceWithLoinc" code="34797-1" nts:in-targets="Nictiz-intern"/>

        <nts:include value="assert.response.unknownMasterIdentifier" nts:in-targets="#default NoManifest"
            code="68688-1"
            masterIdentifier="urn:oid:1.2.276.0.7230010.3.1.2.1787205428.3024.1522314975.220898"/>
        <nts:include value="assert.response.unknownMasterIdentifier" nts:in-targets="#default NoManifest"
            code="34781-5"
            masterIdentifier="urn:oid:1.2.276.0.7230010.3.1.2.1787205428.3024.1522314975.220899"/>
        <nts:include value="assert.response.subjectReference"/>
        <nts:include value="assert.response.authorReference"/>
    </test>

    <variable name="subjectReference1" expression="Bundle.entry[0].resource.ofType(DocumentReference).subject.reference" sourceId="documentreference-search-response"/>
    <variable name="subjectReference2" expression="Bundle.entry[1].resource.ofType(DocumentReference).subject.reference" sourceId="documentreference-search-response"/>
    <test>
        <description value="Check of references resolvable."/>
        <nts:include value="medmij/test.xis.successfulRead" scope="common"
            resource="Patient"
            url="${subjectReference1}"/>
            <nts:include value="medmij/test.xis.successfulRead" scope="common"
            resource="Patient"
            url="${subjectReference2}"/>
    </test>
</TestScript>
  <id value="xis-1-6-serve-without-include"/>
  <version value="stu3-2.0"/>
  <title value="PDF/A - Automatically included referenced resources"/>
  <description value="Conditional qualification scenario: during a DocumentReference search without _include, the server voluntarily includes the referenced Patient as an additional searchset entry. The included entry SHALL have search.mode=include. The presence assertion is a scenario precondition, not a general server requirement."/>
  <test>
    <name value="Search_DocumentReferences_With_Automatically_Included_Patient"/>
    <description value="Run a DocumentReference search without _include; verify voluntarily included Patient entries use search.mode=include."/>
    <action>
      <operation>
        <type>
          <system value="http://hl7.org/fhir/testscript-operation-codes"/>
          <code value="search"/>
        </type>
        <resource value="DocumentReference"/>
        <params value="?patient=Patient%2Fexample-pdfa-kwalificatie1&amp;status=current"/>
        <responseId value="documentReferenceSearchResponse"/>
      </operation>
    </action>
    <action>
      <assert>
        <label value="Response is searchset"/>
        <description value="Search results SHALL be a searchset Bundle."/>
        <expression value="Bundle.type = 'searchset'"/>
        <sourceId value="documentReferenceSearchResponse"/>
        <warningOnly value="false"/>
      </assert>
    </action>
    <action>
      <assert>
        <label value="Scenario precondition - Patient included"/>
        <description value="This conditional scenario requires at least one separate Patient entry, included by the server without an _include parameter. A failure here means the scenario is not applicable, not that the server violates the conditional SHALL."/>
        <expression value="Bundle.entry.resource.ofType(Patient).exists()"/>
        <sourceId value="documentReferenceSearchResponse"/>
        <warningOnly value="true"/>
      </assert>
    </action>
    <action>
      <assert>
        <label value="Included Patient entries use search.mode include"/>
        <description value="Each automatically added Patient entry SHALL have Bundle.entry.search.mode=include."/>
        <expression value="Bundle.entry.where(resource.ofType(Patient).exists()).all(search.mode = 'include')"/>
        <sourceId value="documentReferenceSearchResponse"/>
        <warningOnly value="false"/>
      </assert>
    </action>
    <action>
      <assert>
        <label value="Matching DocumentReference entries use search.mode match"/>
        <description value="The DocumentReference resources matching this search are marked as match."/>
        <expression value="Bundle.entry.where(resource.ofType(DocumentReference).exists()).all(search.mode = 'match')"/>
        <sourceId value="documentReferenceSearchResponse"/>
        <warningOnly value="false"/>
      </assert>
    </action>
  </test>
</TestScript>
