<?xml version="1.0" encoding="UTF-8"?>
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <action>
        <assert>
            <description value="Confirm that the returned entries contain valid author references."/>
            <direction value="response"/>
            <expression value="Bundle.entry.take(2).resource.ofType(DocumentReference).all(author.all(reference.startsWith('#') and reference.substring(1) in %resource.contained.id))"/>
            <warningOnly value="false"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="Confirm that the returned entries contain valid author references."/>
            <direction value="response"/>
            <expression value="Bundle.entry.take(2).resource.ofType(DocumentReference).all(author.all(display.exists() and display.hasValue()))"/>
            <warningOnly value="false"/>
        </assert>
    </action>
</nts:component>
