<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="server">
    <id value="xis-1-1-serve-patient"/>
    <version value="stu3-2.0"/>
    <title value="Scenario 1.1 - Serve Patient"/>
    <description value="Qualification of scenario 1.1 of the GP Patient Data Serve use case. See [the test file on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/Huisartsgegevens_Beschikbaarstellen) for more information."/>
    <destination>
        <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-destination-title">
            <valueString value="Resource endpoint"/>
        </extension>
        <index value="1"/>
        <profile>
            <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"/>
            <code value="FHIR-Server"/>
        </profile>
    </destination>
    <nts:clAuthExtension patientResourceId="gpdata-patient-kwalificatie1" id="XXX_Cevat"/>

    <test id="scenario1-1-serve-patient">
        <description value="Serve Patient resource of person 'XXX_Cevat' and check the response"/>
        <nts:include value="medmij/test.xis.successfulSearch" scope="common"
            resource="Patient"
            params="?_include=Patient:general-practitioner" description="Receive a FHIR search on Patient, including '_include' parameter, and send a response"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Patient" count="1"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Practitioner" count="1"/>
    </test>
</TestScript>
