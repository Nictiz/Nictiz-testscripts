<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript" nts:scenario="client">
    <id value="medmij-gpdata-phr-1-1-retrieve-gpdata"/>
    <version value="stu3-2.0"/>
    <title value="Scenario 1.1 - Retrieve GP Patient Data of XXX_Cevat"/>
    <description value="Scenario 1.1 - Retrieve Patient, EpisodeOfCare, Composition, Encounter, MedicationRequest, laboratory and diagnostic Observation, and AllergyIntolerance resources of person XXX_Cevat."/>
    <nts:clAuthExtension patientResourceId="gpdata-patient-kwalificatie1" id="XXX_Cevat"/>
    <nts:includeDateT value="yes"/>
    <test id="scenario1-1-retrieve-patient">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <name value="Scenario 1.1 - Retrieve Patient"/>
        <description value="Scenario 1.1 - Query Patient resource of person 1."/>
        <nts:include value="medmij/test.phr.search" scope="common" resource="Patient" params="?_include=Patient:general-practitioner"/>
        <nts:include value="canary-assert.response.successfulSearch" scope="common"/>
        <nts:include value="assert.response.numResources" scope="common" resource="Patient" count="1"/>
        <nts:include value="assert.response.numResources" scope="common" resource="Practitioner" count="1"/>
    </test>
    <test id="scenario1-1-retrieve-episodeofcare">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <name value="Scenario 1.1 - Retrieve EpisodeOfCare"/>
        <description value="Scenario 1.1 - Query all EpisodeOfCare resources of person 1."/>
        <nts:include value="medmij/test.phr.search" scope="common" resource="EpisodeOfCare"/>
        <nts:include value="canary-assert.response.successfulSearch" scope="common"/>
        <nts:include value="assert.response.numResources" scope="common" resource="EpisodeOfCare" count="7"/>
    </test>
    <test id="scenario1-1-retrieve-composition">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <name value="Scenario 1.1 - Retrieve Composition"/>
        <description value="Scenario 1.1 - Query all Composition resources of person 1."/>
        <nts:include value="medmij/test.phr.search" scope="common" resource="Composition" params="?type=http://loinc.org|67781-5"/>
        <nts:include value="canary-assert.response.successfulSearch" scope="common"/>
        <nts:include value="assert.response.numResources" scope="common" resource="Composition" count="17"/>
    </test>
    <test id="scenario1-1-retrieve-encounter">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <name value="Scenario 1.1 - Retrieve Encounter"/>
        <description value="Scenario 1.1 - Query all Encounter resources of person 1."/>
        <nts:include value="medmij/test.phr.search" scope="common" resource="Encounter"/>
        <nts:include value="canary-assert.response.successfulSearch" scope="common"/>
        <nts:include value="assert.response.numResources" scope="common" resource="Encounter" count="17"/>
    </test>
    <test id="scenario1-1-retrieve-medicationrequest">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <name value="Scenario 1.1 - Retrieve MedicationRequest"/>
        <description value="Scenario 1.1 - Query all MedicationRequest resources of person 1."/>
        <nts:include value="medmij/test.phr.search" scope="common" resource="MedicationRequest" params="?periodofuse=ge${DATE, T}&amp;category=http://snomed.info/sct|16076005&amp;_include=MedicationRequest:medication"/>
        <nts:include value="canary-assert.response.successfulSearch" scope="common"/>
        <nts:include value="assert.response.numResources" scope="common" resource="MedicationRequest" count="3"/>
    </test>
    <test id="scenario1-1-retrieve-lab-and-diagnostic-observation">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <name value="Scenario 1.1 - Retrieve Lab and Diagnostic Observations"/>
        <description value="Scenario 1.1 - Query all Lab and Diagnostic Observations resources of person 1."/>
        <nts:include value="medmij/test.phr.search" scope="common" resource="Observation" params="?code=https://referentiemodel.nhg.org/tabellen/nhg-tabel-45-diagnostische-bepalingen|&amp;_include=Observation:related-target&amp;_include=Observation:specimen&amp;date=ge${CURRENTDATE,M,-14}"/>
        <nts:include value="canary-assert.response.successfulSearch" scope="common"/>
        <nts:include value="assert.response.numResources" scope="common" resource="Observation" count="18"/>
    </test>
    <test id="scenario1-1-retrieve-allergyintolerance">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <name value="Scenario 1.1 - Retrieve AllergyIntolerance"/>
        <description value="Scenario 1.1 - Query all AllergyIntolerance resources of person 1."/>
        <nts:include value="medmij/test.phr.search" scope="common" resource="AllergyIntolerance" params="?category=medication"/>
        <nts:include value="canary-assert.response.successfulSearch" scope="common"/>
        <nts:include value="assert.response.numResources" scope="common" resource="AllergyIntolerance" count="1"/>
    </test>
</TestScript>
