   <nts:authToken patientResourceId="medmij-bgz-test-patB"/>

   <test id="scenario2-02-retrieve-patient">
      <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
      <name value="Scenario 2.2, 2.5 and 2.19 - Patient"/>
      <description value="Retrieve zib-Patient instance including the patient's general practitioner and check the request"/>
      <nts:include value="medmij/test.phr.search"
                   scope="common"
                   resource="Patient"
                   params="?_include=Patient:general-practitioner"/>
      <nts:include value="canary-assert.response.successfulSearch" scope="common"/>
      <nts:include value="assert.response.numResources"
                   scope="common"
                   resource="Patient"
                   count="1"/>
      <nts:include value="assert.response.numResources"
                   scope="common"
                   resource="Practitioner"
                   count="1"/>
   </test>
