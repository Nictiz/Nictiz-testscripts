    <test id="01-retrieve-Patient">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description
            value="Retrieve zib-Patient instance including the patient's general practitioner and check the request"/>
        <nts:include value="medmij/test.phr.search" scope="common"
            resource="Patient"
            params="?_include=Patient:general-practitioner" description="Send a FHIR search on Patient, including the correct '_include' parameter"/>
        <nts:include value="canary-assert.response.successfulSearch" scope="common"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Patient" count="1"/>
    </test>

