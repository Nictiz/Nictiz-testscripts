<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="server">
    <id value="medmij-bgz-xis-1-2-serve-bgz"/>
    <version value="stu3-3.0"/>
    <title value="Scenario 1.2 - Serve BgZ resources of XXX-Mesker"/>
    <description value="Qualification of scenario 1.2 - of the [Retrieve BgZ informatie use case](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/FHIR_BGZ_2017). See [the test file on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/BgZ_Raadplegen) for more information."/>
    <nts:authToken patientResourceId="medmij-bgz-patient-ts-02" id="XXX_Mesker"/>

    <test id="01-serve-Patient">
        <description
            value="Serve zib-Patient instance including the patient's general practitioner and check the response"/>
        <nts:include value="medmij/test.xis.successfulSearch" scope="common" 
            resource="Patient"
            params="?_include=Patient:general-practitioner"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Patient" count="1"/>
    </test>

    <test id="02-serve-Payer">
        <description value="Serve zib-Payer instance including the insurer and check the response"/>
        <nts:include value="medmij/test.xis.successfulSearch" scope="common"
            resource="Coverage"
            params="?_include=Coverage:payor:Patient&amp;_include=Coverage:payor:Organization"/>
        <nts:include value="assert.response.noEntries" scope="common"/>
    </test>

    <test id="03-serve-TreatmentDirective">
        <description value="Serve zib-TreatmentDirective instance and check the response"/>
        <nts:include value="medmij/test.xis.successfulSearch" scope="common"
            resource="Consent"
            params="?category=http://snomed.info/sct|11291000146105"/>
        <nts:include value="assert.response.noEntries" scope="common"/>
    </test>

