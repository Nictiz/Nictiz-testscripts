<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript" nts:scenario="server">
    <id value="nlps-regressie-patientid-level4a"/>
    <version value="r4.0.1"/>
    <title value="NL-PS-REG-L4A - Regressie niveau 4a: 2 minimale GBB's per sectie - Patient id query"/>
    <description value="Regressietest: alleen testgevallen met testsoort Regressie (M-eisen, geautomatiseerd). Een fout laat de test falen. Testpatiënt niveau 4a (TP-4a). Conformancelab zoekt de PS van de Patient-id die je bij de testopzet invoert, zonder 'Patient/'. Implementation Guides: NL-PS https://ig.nictiz.nl/nlps/ en generieke bouwblokken https://ig.nictiz.nl/gbb/. Traceability: PS-requirements v0.1 en het tabblad Testgevallen."/>
    <variable>
        <name value="patient-id-4a"/>
        <defaultValue value="enter-patient-id-level-4a"/>
        <description value="Patient.id van je testpatiënt niveau 4a, zonder 'Patient/'."/>
    </variable>
    <test>
        <name value="TS-02 PS zoeken"/>
        <description value="TG-02-01, TG-02-02: zoek de PS-Composition van de testpatiënt."/>
        <nts:include value="req.op.search" patientQuery="&amp;patient=${patient-id-4a}"/>
        <nts:include value="req.ts02.patientmatch.id" patientVar="patient-id-4a"/>
    </test>
    <test>
        <name value="TS-02/03 Document ophalen en valideren"/>
        <description value="TG-02-05, TG-03-01 t/m TG-03-04, TG-03-07: haal de PS op als document en valideer Bundle en Composition."/>
        <nts:include value="req.op.document"/>
    </test>
    <test>
        <name value="TS-03 Header en patiënt"/>
        <description value="TG-03-05/06/08/09/11 t/m 15/17, op het document uit de vorige test."/>
        <nts:include value="req.ts03.header"/>
    </test>
    <test>
        <name value="TS-03 Verplichte secties"/>
        <description value="TG-03-19 t/m TG-03-24 en TG-03-26."/>
        <nts:include value="req.ts03.secties"/>
    </test>
    <test>
        <name value="TS-07 Sectie Problemen"/>
        <description value="TG-07-01/02/03, TG-07-05, TG-07-10, TG-09-01, TG-09-02: sectie Problemen (LOINC 11450-4)."/>
        <nts:include value="req.ts07.problemen"/>
        <nts:include value="req.ts07.problemen.entry2"/>
        <nts:include value="req.ts09.problemen"/>
    </test>
    <test>
        <name value="TS-07 Sectie Allergieën en intoleranties"/>
        <description value="TG-07-01/02/03, TG-07-06, TG-07-10, TG-09-01, TG-09-02: sectie Allergieën en intoleranties (LOINC 48765-2)."/>
        <nts:include value="req.ts07.allergieen"/>
        <nts:include value="req.ts07.allergieen.entry2"/>
        <nts:include value="req.ts09.allergieen"/>
    </test>
    <test>
        <name value="TS-07 Sectie Verrichtingen"/>
        <description value="TG-07-01/02/03, TG-07-07, TG-07-10, TG-09-01, TG-09-02: sectie Verrichtingen (LOINC 47519-4)."/>
        <nts:include value="req.ts07.verrichtingen"/>
        <nts:include value="req.ts07.verrichtingen.entry2"/>
        <nts:include value="req.ts09.verrichtingen"/>
    </test>
    <test>
        <name value="TS-07 Sectie Medische hulpmiddelen"/>
        <description value="TG-07-01/02/03, TG-07-08, TG-09-01: sectie Medische hulpmiddelen (LOINC 46264-8)."/>
        <nts:include value="req.ts07.hulpmiddelen"/>
        <nts:include value="req.ts07.hulpmiddelen.entry2"/>
        <nts:include value="req.ts09.hulpmiddelen"/>
    </test>
    <test>
        <name value="TS-07 Gegevenskwaliteit"/>
        <description value="TG-07-09."/>
        <nts:include value="req.ts07.kwaliteit"/>
    </test>
</TestScript>
