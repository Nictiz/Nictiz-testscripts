<?xml version="1.0" encoding="UTF-8"?>
<!--
    TS-02/TS-03: haal de PS op als document met $document en controleer en valideer het document als geheel (regressie).
    Gegenereerd door gen_nts.py uit de NL-PS requirements-traceability (PS-requirements v0.1, 24-11-2026). Pas de generator aan, niet dit bestand.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:profile id="ps-bundle-eu-eps" value="http://hl7.eu/fhir/eps/StructureDefinition/bundle-eu-eps"/>
    <nts:profile id="ps-composition-nlps" value="http://ig.nictiz.nl/nlps/StructureDefinition/nl-PatientSummary"/>
    <action>
        <operation>
            <type>
                <system value="http://hl7.org/fhir/restful-interaction"/>
                <code value="read"/>
            </type>
            <resource value="Composition"/>
            <description value="TG-02-05: GET [base]/Composition/[id]/$document"/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <origin value="1"/>
            <params value="/${composition-id}/$document"/>
            <responseId value="ps-document"/>
        </operation>
    </action>
    <action>
        <assert>
            <description value="TG-02-05 (PS-API-07): Confirm that the server responds with HTTP status 200."/>
            <direction value="response"/>
            <response value="okay"/>
            <warningOnly value="false"/>
        </assert>
    </action>
    <action>
        <assert nts:stopTestOnFail="true">
            <description value="TG-02-05 (PS-API-07): het antwoord is een Bundle."/>
            <direction value="response"/>
            <expression value="Bundle.exists()"/>
            <warningOnly value="false"/>
        </assert>
    </action>
    <action>
        <assert nts:stopTestOnFail="true">
            <description value="TG-03-01 (PS-API-07): de Bundle is een document; een searchset-wrapper wordt niet geaccepteerd."/>
            <direction value="response"/>
            <expression value="Bundle.type = 'document'"/>
            <warningOnly value="false"/>
        </assert>
    </action>
    <action>
        <assert nts:stopTestOnFail="true">
            <description value="TG-03-02 (PS-API-08): de eerste entry is een Composition."/>
            <direction value="response"/>
            <expression value="Bundle.entry.first().resource.is(Composition)"/>
            <warningOnly value="false"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="TG-03-02 (PS-API-08): de Composition is een Patient Summary (LOINC 60591-5)."/>
            <direction value="response"/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).type.coding.where(system = 'http://loinc.org' and code = '60591-5').exists()"/>
            <warningOnly value="false"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="TG-03-03 (PS-API-09): het document heeft een identifier met system en value, en een timestamp."/>
            <direction value="response"/>
            <expression value="Bundle.identifier.system.exists() and Bundle.identifier.value.exists() and Bundle.timestamp.exists()"/>
            <warningOnly value="false"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="TG-03-04 (PS-API-10): de Bundle conformeert aan http://hl7.eu/fhir/eps/StructureDefinition/bundle-eu-eps."/>
            <direction value="response"/>
            <validateProfileId value="ps-bundle-eu-eps"/>
            <warningOnly value="false"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="TG-03-07 (PS-HDR-01): de Composition conformeert aan nl-PatientSummary en via imposeProfile aan composition-eu-eps; dekt ook TG-03-21 t/m TG-03-23 (cmp-1, cmp-2, ips-comp-1), TG-03-27 (required bindings) en de XHTML-geldigheid van TG-03-26."/>
            <direction value="response"/>
            <expression value="Bundle.entry.first().resource"/>
            <validateProfileId value="ps-composition-nlps"/>
            <warningOnly value="false"/>
        </assert>
    </action>
</nts:component>
