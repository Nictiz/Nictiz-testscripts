<?xml version="1.0" encoding="UTF-8"?>
<!--
    TS-02: alle gevonden PS-Compositions horen bij de patiënt waarvan de id bij de testopzet is ingevoerd.
    Gegenereerd door gen_nts.py uit de NL-PS requirements-traceability (PS-requirements v0.1, 24-11-2026). Pas de generator aan, niet dit bestand.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <action>
        <assert>
            <description value="TG-02-02 (PS-API-05): alle gevonden Compositions verwijzen naar de gevraagde patiënt, en alleen naar die patiënt."/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is Composition).subject.reference.replaceMatches('^.*/(Patient/[^/]+)$', '$1').distinct()"/>
            <operator value="equals"/>
            <value value="Patient/${{$patientVar}}"/>
            <warningOnly value="false"/>
        </assert>
    </action>
</nts:component>
