<?xml version="1.0" encoding="UTF-8"?>
<!--
    TS-05 (regressie): voorwaardelijke M-eisen aan de maximale metadata.
    Gegenereerd door gen_nts.py uit de NL-PS requirements-traceability (PS-requirements v0.1, 24-11-2026). Pas de generator aan, niet dit bestand.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <action>
        <assert>
            <description value="TG-05-06 (PS-HDR-11): een juridische ondertekening (attester mode legal) heeft time en party."/>
            <direction value="response"/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).attester.where(mode = 'legal').all(time.exists() and party.exists())"/>
            <warningOnly value="false"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="TG-05-08 (PS-HDR-12): een professionele validatie (attester mode professional) heeft time en party."/>
            <direction value="response"/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).attester.where(mode = 'professional').all(time.exists() and party.exists())"/>
            <warningOnly value="false"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="TG-05-11 (PS-HDR-17): als het document een Organization bevat, heeft minimaal één Organization een naam."/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is Organization).empty() or Bundle.entry.resource.where($this is Organization).where(name.exists()).exists()"/>
            <warningOnly value="false"/>
        </assert>
    </action>
</nts:component>
