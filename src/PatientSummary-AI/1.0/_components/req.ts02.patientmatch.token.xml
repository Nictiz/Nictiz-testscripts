<?xml version="1.0" encoding="UTF-8"?>
<!--
    TS-02: met een patiëntgebonden token levert de server de PS van precies één patiënt.
    Gegenereerd door gen_nts.py uit de NL-PS requirements-traceability (PS-requirements v0.1, 24-11-2026). Pas de generator aan, niet dit bestand.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <action>
        <assert>
            <description value="TG-02-04 (PS-API-06): het zoekresultaat bevat precies één Composition."/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is Composition).count() = 1"/>
            <warningOnly value="true"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="TG-02-04 (PS-API-06): alle gevonden Compositions verwijzen naar dezelfde patiënt."/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is Composition).subject.reference.replaceMatches('^.*/(Patient/[^/]+)$', '$1').distinct().count() = 1"/>
            <warningOnly value="true"/>
        </assert>
    </action>
</nts:component>
