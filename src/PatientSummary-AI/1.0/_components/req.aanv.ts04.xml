<?xml version="1.0" encoding="UTF-8"?>
<!--
    TS-04/05/06 (overig): emptyReason komt uit list-empty-reason.
    Gegenereerd door gen_nts.py uit de NL-PS requirements-traceability (PS-requirements v0.1, 24-11-2026). Pas de generator aan, niet dit bestand.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <action>
        <assert>
            <description value="TG-04-02 (PS-SEC-06): elke emptyReason komt uit http://terminology.hl7.org/CodeSystem/list-empty-reason."/>
            <direction value="response"/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).section.where(emptyReason.exists()).all(emptyReason.coding.system contains 'http://terminology.hl7.org/CodeSystem/list-empty-reason')"/>
            <warningOnly value="true"/>
        </assert>
    </action>
</nts:component>
