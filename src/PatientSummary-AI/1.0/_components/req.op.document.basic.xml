<?xml version="1.0" encoding="UTF-8"?>
<!--
    Aanvullende scripts: haal de PS op als document met $document (alleen voorwaarden, geen regressiechecks).
    Gegenereerd door gen_nts.py uit de NL-PS requirements-traceability (PS-requirements v0.1, 24-11-2026). Pas de generator aan, niet dit bestand.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <action>
        <operation>
            <type>
                <system value="http://hl7.org/fhir/restful-interaction"/>
                <code value="read"/>
            </type>
            <resource value="Composition"/>
            <description value="GET [base]/Composition/[id]/$document"/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <origin value="1"/>
            <params value="/${composition-id}/$document"/>
            <responseId value="ps-document"/>
        </operation>
    </action>
    <action>
        <assert>
            <description value="Confirm that the server responds with HTTP status 200."/>
            <direction value="response"/>
            <response value="okay"/>
            <warningOnly value="false"/>
        </assert>
    </action>
    <action>
        <assert nts:stopTestOnFail="true">
            <description value="Voorwaarde (PS-API-07): het antwoord is een document-Bundle met een Composition als eerste entry."/>
            <direction value="response"/>
            <expression value="Bundle.type = 'document' and Bundle.entry.first().resource.is(Composition)"/>
            <warningOnly value="false"/>
        </assert>
    </action>
</nts:component>
