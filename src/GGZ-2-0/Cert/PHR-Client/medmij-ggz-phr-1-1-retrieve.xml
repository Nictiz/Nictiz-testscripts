<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="client">
    <id value="phr-1-1-retrieve-ggz"/>
    <version value="stu3-2.0"/>
    <title value="Scenario 1.1 - Retrieve all GGZ information of person 'XXX-Bals'"/>
    <description value="Qualification of scenario 1.1 of the Basic GGZ Data Retrieve use case. See [the test file on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/Basisgegevens_GGZ_Raadplegen) for more information.&#xA;&#xA;Scenario 1.1 - Retrieve all GGZ information of person 1"/>
    <nts:clAuthExtension patientResourceId="XXX-Bals"/>

    <test id="01-retrieve-Patient">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description
            value="Retrieve zib-Patient instance including the patient's general practitioner and check the request"/>
        <nts:include value="medmij/test.phr.search" scope="common"
            resource="Patient"
            params="?_include=Patient:general-practitioner" description="Send a FHIR search on Patient, including the correct '_include' parameter"/>
        <nts:include value="canary-assert.response.successfulSearch" scope="common"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Patient" count="1"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Practitioner" count="1"/>
    </test>

    <test id="02-retrieve-Payer">
        <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
        <description value="Retrieve zib-Payer instance including the insurer and check the request"/>
        <nts:include value="medmij/test.phr.search" scope="common"
            resource="Coverage"
            params="?_include=Coverage:payor:Patient&amp;_include=Coverage:payor:Organization" description="Send a FHIR search on Coverage, including the correct two '_include' parameters"/>
        <nts:include value="canary-assert.response.successfulSearch" scope="common"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Coverage" count="1"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Organization" count="1"/>
    </test>

