<?xml version="1.0" encoding="UTF-8"?>
<!--
    Asserts specific for request Bundle content against FHIR core (does not include generic Bundle asserts).
-->
<nts:component  xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <action>
        <assert>
            <description value="Confirm that all resources that are updated contain a Resource.id and a fullUrl."/>
            <direction value="request"/>
            <expression value="Bundle.entry.where(request.method='PUT').all(
                $this.fullUrl.exists() and
                $this.resource.id.exists())"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="Check that resources submitted using POST do not contain a resource.id. This is an advisory check because the server SHALL ignore any supplied id."/>
            <direction value="request"/>
            <expression value="Bundle.entry.where(request.method='POST').all($this.resource.id.exists().not())"/>
            <warningOnly value="true"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="Check that entries using POST do not have an HTTP(S) fullUrl. This is an advisory check; an HTTP(S) fullUrl can be a valid source identity and does not necessarily represent the resource's future server location."/>
            <direction value="request"/>
            <expression value="Bundle.entry.where(request.method='POST').all(
                $this.fullUrl.startsWith('http://').not() and 
                $this.fullUrl.startsWith('https://').not()
                )"/>
            <warningOnly value="true"/>
        </assert>
    </action>    
    <action>
        <assert>
            <description value="Check that entries using POST either omit fullUrl or use a UUID URN or OID URN. This is an advisory check; other fullUrl forms are not necessarily invalid."/>
            <direction value="request"/>
            <expression value="Bundle.entry.where(request.method='POST').all(
                fullUrl.empty() or
                fullUrl.matches('^urn:oid:[0-2](\\.(0|[1-9]\\d*))*$') or
                fullUrl.matches('^urn:uuid:[A-Fa-f\\d]{8}-[A-Fa-f\\d]{4}-[A-Fa-f\\d]{4}-[A-Fa-f\\d]{4}-[A-Fa-f\\d]{12}$')
                )"/>
            <warningOnly value="true"/>
        </assert>
    </action>
</nts:component>
