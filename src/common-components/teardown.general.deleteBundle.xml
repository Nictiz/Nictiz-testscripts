<?xml version="1.0" encoding="UTF-8"?>
<!--
    teardown component for AcuteCare test scripts. This component is used to delete the bundle resource created during the test run.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <variable>
        <name value="created-bundle-id" />
        <description value="The id of the created bundle resource" />
        <expression
            value="Bundle.id[0]" />
        <sourceId value="scenario-bundle-response" />
    </variable>

    <teardown>
        <name value="teardown" />
        <description value="Delete the created resources" />
        <action>
            <operation>
                <type>
                <system value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-operation-codes" />
                <code value="delete" />
                </type>
                <description
                value="Delete Bundle resource created during this test run." />
                <resource value="Bundle" />
                <encodeRequestUrl value="true" />
                <params value="/${created-bundle-id}" />
                <requestHeader>
                <field value="Prefer" />
                <value value="return=representation" />
                </requestHeader>
            </operation>
        </action>
    </teardown>
</nts:component>



  