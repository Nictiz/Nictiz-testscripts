<?xml version="1.0" encoding="UTF-8"?>
<!--
    Check that CodeableConcepts have a coding display, text, or an extension.
    @param resourceBase - the resource whose descendants are checked.
    @param direction - either "request" or "response".
    @param codeableConceptDisplayWarningOnly - optional warningOnly value for this assert.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <action>
        <assert>
            <description value="Confirm that every CodeableConcept contains at least one coding.display, a text value, or an extension (e.g. a nullFlavor or data-absent-reason extension) on the CodeableConcept. For more information see https://informatiestandaarden.nictiz.nl/wiki/FHIR:V1.0_FHIR_IG_STU3Use_of_coded_concepts."/>
            <direction value="{$direction}"/>
            <expression value="{$resourceBase}.descendants().where($this.is(CodeableConcept))
                .all(coding.display.exists() or text.exists() or extension.exists())"/>
            <warningOnly nts:ifset="codeableConceptDisplayWarningOnly" value="{$codeableConceptDisplayWarningOnly}"/>
        </assert>
    </action>
</nts:component>
