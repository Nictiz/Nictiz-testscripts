<?xml version="1.0" encoding="UTF-8"?>
<!-- 
    Deletes the created Patient and all related Resources using a transaction or batch request.
    This teardown must be included:
    - In all TestScripts with the system role **Send** that create patient resources.
    - In all **Nictiz internal** TestScripts with the system role **Receive** that create patient resources.
    This ensures that the server is cleaned up after each test run.
-->

<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <variable>
      <name value="patient-id"/>
      <sourceId value="responseId"/>
      <expression value="entry.response.location.where($this.startsWith('Patient/')).first().split('/')[1]"/>
   </variable>

    <teardown>
        <name value="teardown" />
        <description value="Delete the created resources" />    
        <action>
            <operation>
                <type>
                    <system value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-operation-codes"/>
                    <code value="purge"/>
                </type>
                <resource value="Patient"/>
                <description value="Delete the Patient and all subsequent Resources that were created during this test."/>
                <destination value="1"/>
                <encodeRequestUrl value="true"/>
                <params value="/${patient-id}/$purge"/>   
            </operation>
        </action>
    </teardown>
</nts:component>