<?xml version="1.0" encoding="UTF-8"?>
<!--
    Check that response Bundle resources other than OperationOutcome and Binary declare a profile.
    @param bundleEntryProfilesWarningOnly - optional warningOnly value for this assert.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <action>
        <assert>
            <description value="Confirm that all returned resources except OperationOutcome and Binary contain a meta.profile tag."/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where(is(OperationOutcome).not()).where(is(Binary).not()).where(meta.profile.empty()).empty()"/>
            <warningOnly nts:ifset="bundleEntryProfilesWarningOnly" value="{$bundleEntryProfilesWarningOnly}"/>
        </assert>
    </action>
</nts:component>
