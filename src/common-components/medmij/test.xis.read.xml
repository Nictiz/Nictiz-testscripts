<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../lib/Nictiz-tooling-testscripts/1.5.0/schematron/NictizTestScript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<!--
    PHR test to read a specific resource, to be added to `TestScript.test`. It is expected that a token is imported using nts:authToken.
    @param resource - The resource to read.
    @param resourceDisplay - The display value of the resource to read (for use in combination with .url) 
    @param params - The parameters to add to the request URL (usually the id of the resource to read).
    @param url - The url at which the resource is to be read directly
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <action>
        <operation>
            <type>
                <system value="http://hl7.org/fhir/restful-interaction"/>
                <code value="read"/>
            </type>
            <resource nts:ifset="resource" nts:ifnotset="url" value="{$resource}"/>
            <description value="Test XIS server to serve {$resource} resource."/>
            <destination value="1"/>
            <origin value="1"/>          
            <params nts:ifset="params" nts:ifnotset="url" value="{$params}"/>
            <nts:include nts:ifset="useToken" value="header.request.PatientToken" scope="common"/>
            <nts:include value="medmij/header.request.MedMijRequestId" scope="common"/>
            <nts:include value="medmij/header.request.MedMijXCorrelationId" scope="common"/>
            <url nts:ifset="url" value="{$url}"/>
        </operation>
    </action>
</nts:component>
