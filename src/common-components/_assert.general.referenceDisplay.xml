<?xml version="1.0" encoding="UTF-8"?>
<!--
    Check that References have a display value or an accepted absence extension.
    @param resourceBase - the resource whose descendants are checked.
    @param direction - either "request" or "response".
    @param referenceDisplayWarningOnly - optional warningOnly value for this assert.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <action>
        <assert>
            <description value="Confirm that every Reference contains a display value, a data-absent-reason extension, or a nullFlavor extension. For more information see https://informatiestandaarden.nictiz.nl/wiki/FHIR:V1.0_FHIR_IG_STU3#Use_of_the_reference_datatype."/>
            <direction value="{$direction}"/>
            <expression value="{$resourceBase}.descendants().where($this.is(Reference)).all(display.exists() or extension.where(url = 'http://hl7.org/fhir/StructureDefinition/data-absent-reason').exists() or extension.where(url = 'http://hl7.org/fhir/StructureDefinition/iso21090-nullFlavor').exists())"/>
            <warningOnly nts:ifset="referenceDisplayWarningOnly" value="{$referenceDisplayWarningOnly}"/>
        </assert>
    </action>
</nts:component>
