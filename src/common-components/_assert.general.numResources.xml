<?xml version="1.0" encoding="UTF-8"?>
<!--
  Assert that a Bundle contains (at least) the specified amount of entries for the specified resource.
  @param direction - Either "response" or "request".
  @param resource - The resource type to count.
  @param count - The number of entries that contain the specified resource.
  @param warningOnly - If true, the assert is set to warningOnly (default is false).
  @param additionalDescription - An additional description sentence that is added to the auto-generated description.
  @param atLeast - If set, the count() is set to 'greater or equal'.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:parameter name="warningOnly" value="false"/>
    <action nts:ifnotset="atLeast">
        <assert>
            <description nts:ifset="additionalDescription" value="Confirm that the {$direction} Bundle contains exactly {$count} {$resource} resource(s). {$additionalDescription}"/>
            <description nts:ifnotset="additionalDescription" value="Confirm that the {$direction} Bundle contains exactly {$count} {$resource} resource(s)."/>
            <direction value="{$direction}"/>
            <expression value="Bundle.entry.where(resource.is({$resource})).count() = {$count}"/>
            <warningOnly value="{$warningOnly}"/>
        </assert>
    </action>
    <action nts:ifset="atLeast">
        <assert>
            <description nts:ifset="additionalDescription" value="Confirm that the {$direction} Bundle contains at least {$count} {$resource} resource(s). {$additionalDescription}"/>
            <description nts:ifnotset="additionalDescription" value="Confirm that the {$direction} Bundle contains at least {$count} {$resource} resource(s)."/>
            <direction value="{$direction}"/>
            <expression value="Bundle.entry.where(resource.is({$resource})).count() >= {$count}"/>
            <warningOnly value="{$warningOnly}"/>
        </assert>
    </action>
</nts:component>
