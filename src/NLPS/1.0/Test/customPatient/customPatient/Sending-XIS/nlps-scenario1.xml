<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript" nts:scenario="client">
    <id value="imm-retrieve-cert-1-1"/>
    <version value="r4.0.1"/>
    <title value="Scenario 1 - Serve NL Patient summary"/>
    <description value="url fhir ig"/>

    <test id="scenario1-receive-one-correctionrequest">
      <name value="Scenario1"/>
      <description value="Receive one correction request"/>
      <action>
         <operation>
            <type>
               <system value="http://hl7.org/fhir/restful-interaction"/>
               <code value="read"/>
            </type>
            <description value="Test XIS server to handle a Bundle of type transaction with all the required FHIR resources."/>
            <accept value="json"/>
            <contentType value="json"/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <origin value="1"/>
            <requestHeader>
               <field value="Authorization"/>
               <value value="${patient-token-XXX_Helleman}"/>
            </requestHeader>
            <requestHeader>
               <field value="Prefer"/>
               <value value="return=representation"/>
            </requestHeader>
         </operation>
      </action>
    </test>
</TestScript>
