<?xml version="1.0" encoding="UTF-8"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript" nts:scenario="server">
   <id value="gbz-fhir3-0-2-ikz-xis-1-2 test"/>
   <version value="stu3-3.0"/>
   <title value="TEMP test"/>
   <description value="Scenario Obstetric Care casus 2 of the [Birth Care - Retrieve Pregnancy card - midwife care data set use case](https://informatiestandaarden.nictiz.nl/wiki/gz:FHIR_Pregnancy_Card). See [the test file on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/Geboortezorg_3.2_-_kwalificatie_MedMij_-_Beschikbaarstellen_Integrale_Zwangerschapskaart_2.0_Echo) for more information."/>
   <nts:authToken patientResourceId="FIONAXXX-Swart"/>
   <nts:include value="gbz-variable-episode-id-with-status" name="episode-id" status="finished" sourceId="fixture-7-ServeMaternalRecord"/>
   <nts:includeDateT value="yes"/>
   
   <variable>
         <name value="bodysite1-id"/>
         <description value="ID of the first fetus resource"/>
         <expression value="Bundle.entry.resource.where($this is Observation).extension.where(url = 'http://nictiz.nl/fhir/StructureDefinition/observation-focusSTU3').value.where($this is Reference).reference.where(startsWith('BodySite/')).distinct()[0]"/>
         <sourceId value="fixture-10b-ServeObservations"/>
      </variable>
      <variable>
         <name value="bodysite2-id"/>
         <description value="ID of the second fetus resource"/>
         <expression value="Bundle.entry.resource.where($this is Observation).extension.where(url = 'http://nictiz.nl/fhir/StructureDefinition/observation-focusSTU3').value.where($this is Reference).reference.where(startsWith('BodySite/')).distinct()[1]"/>
         <sourceId value="fixture-10b-ServeObservations"/>
      </variable>
      <variable>
         <name value="babyAid"/>
         <expression value="Bundle.entry.resource.where($this is BodySite).where(description.lower().replace(' ', '') = 'babya').id"/>
         <sourceId value="bodysite-search-response"/>
      </variable>
      <variable>
         <name value="babyBid"/>
         <expression value="Bundle.entry.resource.where($this is BodySite).where(description.lower().replace(' ', '') = 'babyb').id"/>
         <sourceId value="bodysite-search-response"/>
      </variable>
      
   <!-- Observations - Observaties gekoppeld aan prenatale controle -->  
   <test id="10b-ServeObservations">
      <name value="10b-ServeObservations"/>
      <description value="Test Server query operation for Observations"/>  
      <nts:include value="medmij/test.xis.successfulSearch" scope="common">
         <nts:with-parameter name="resource" value="Observation"/>
         <nts:with-parameter name="params" value="?context:Encounter.episodeofcare=EpisodeOfCare/${episode-id}"/>
      </nts:include>
      <!-- Prenatale controle -->
      <!-- Lichaamsgewicht -->
       <nts:include value="gbz-assert-returnCountWithCode" nts:in-targets="#default">
         <nts:with-parameter name="additionalDescription" value="(body weight)"></nts:with-parameter>
         <nts:with-parameter name="resource" value="Observation"></nts:with-parameter>
         <nts:with-parameter name="count" value="1"></nts:with-parameter>
         <nts:with-parameter name="code" value="29463-7"></nts:with-parameter>
         <nts:with-parameter name="system" value="http://loinc.org"></nts:with-parameter>
      </nts:include>
      <nts:contentAsserts href="gz-izv-kwa-casus2/mm-gbz-zib-BodyWeight29463-7-0332ec90-6af5-11ec-2107-020000000000.xml" nts:in-targets="CheckContent">
         <nts:discriminator>code.where(coding.where(code = '29463-7'))</nts:discriminator>
      </nts:contentAsserts>
   </test>

   <test id="10c-ResolveFetusResources">
      <name value="10c-ResolveFetusResources"/>
      <description value="Resolve fetus resources for testing purposes."/>
   
      <action nts:in-targets="CheckContent">
         <operation>
            <type>
               <system value="http://hl7.org/fhir/restful-interaction"/>
               <code value="search"/>
            </type>
            <resource value="BodySite"/>
            <description value="Resolve fetus resources for testing purposes."/>
            <origin value="1"/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <params value="?_id=${bodysite1-id},${bodysite2-id}"/>
            <requestHeader>
               <field value="Authorization"/>
               <value value="${patient-token-FIONAXXX-Swart}"/>
            </requestHeader>
            <responseId value="fetusresources"/>
         </operation>
      </action>
      <action nts:in-targets="CheckContent">
         <assert>
            <description value="temp test"/>
            <direction value="response"/>
            <expression value="${babyAid} = 'BodySite/9a381515-6aa8-11ec-1080-020000000000'"/>
            <stopTestOnFail value="false"/>
         </assert>
      </action>
   </test>   
</TestScript>
