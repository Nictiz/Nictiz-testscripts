   <!-- Binary -->
   <test id="11-RetrieveBinary">
      <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
      <name value="11-RetrieveBinary"/>
      <description value="Serve all Binary resources form the DocumentReference provided for this test"/> 
      <action>
         <operation>
            <type>
               <system value="http://hl7.org/fhir/restful-interaction"/>
               <code value="search"/>
            </type>
            <resource value="Binary"/>
            <description value="Test XIS server to serve Binary resources."/>
            <destination value="1"/>
            <origin value="1"/>
            <url value="${binary-id}"/>
            <nts:include value="header.request.PatientToken" scope="common"/>
            <nts:include value="medmij/header.request.MedMijRequestId" scope="common"/>
            <nts:include value="medmij/header.request.MedMijXCorrelationId" scope="common"/>
            <responseId nts:ifset="responseId" value="{$responseId}"/>
         </operation>
      </action>
      <nts:include value="assert.response.success" scope="common"/>
      <action>
         <assert>
            <description value="Confirm that the response contains 1 Binary resource(s)."/>
            <direction value="response"/>
            <expression value="Binary.id.count() = 1"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action nts:in-targets="CheckContent FullComparison">
         <assert>  
            <description value="Binary resource evaluated in the previous assert contains an .id"/>  
            <direction value="response"/>  
            <expression value="Binary.id.exists()"/>  
            <warningOnly value="false"/>  
         </assert>  
      </action>  
