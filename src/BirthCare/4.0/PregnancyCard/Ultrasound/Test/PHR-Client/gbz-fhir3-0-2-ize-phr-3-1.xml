   <nts:includeDateT value="yes"/>
   
   <!-- Patient - Zwangere vrouw -->
   <test id="1-RetrieveWoman">
      <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
      <name value="1-RetrieveWoman"/>
      <description value="Retrieve all Patient resources provided for this test"/>
      <nts:include value="medmij/test.phr.successfulsearch" scope="common">
         <nts:with-parameter name="resource" value="Patient"/>        
      </nts:include>
      <nts:include value="assert.response.numResources" scope="common" resource="Patient" count="1"/>
   </test>
   
   <!-- Coverage - Verzekeraar -->
   <test id="2-RetrievePayer">
      <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
      <name value="2-RetrievePayer"/>
      <description value="Retrieve all Coverage resources provided for this test"/>
      <nts:include value="medmij/test.phr.successfulsearch" scope="common">
         <nts:with-parameter name="resource" value="Coverage"/>         
      </nts:include>
      <nts:include value="assert.response.numResources" scope="common" resource="Coverage" count="1"/>
   </test>
    
   <!-- EpisodeOfCare - zorgepisode zwangerschap -->
   <test id="3-RetrieveMaternalRecord">
      <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
      <name value="3-RetrieveMaternalRecord"/>
      <description value="Retrieve all EpisodeOfCare resources provided for this test, including managing organization (Organization) and care manager (Practitioner)"/>
      <nts:include value="medmij/test.phr.successfulsearch" scope="common">
         <nts:with-parameter name="resource" value="EpisodeOfCare"/>
         <nts:with-parameter name="params" value="?type=http://snomed.info/sct|364320009&amp;status=finished&amp;_include=EpisodeOfCare:organization&amp;_include=EpisodeOfCare:care-manager"/>
      </nts:include>
      <nts:include value="assert.response.numResources" scope="common" resource="EpisodeOfCare" count="1"/>
      <nts:include value="assert.response.numResources" scope="common" resource="Organization" count="1"/>
      <nts:include value="assert.response.numResources" scope="common" resource="Practitioner" count="1"/>
   </test>
     
   <!-- Conditions - Problemen gerelateerd aan zorgepisode incl. zwangerschap -->
   <test id="4-RetrieveConditions">
      <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
      <name value="4-RetrieveConditions"/>
      <description value="Retrieve all Condition (including Pregnancy) resources linked to the EpisodeOfCare provided for this test"/>
      <nts:include value="medmij/test.phr.successfulsearch" scope="common">
         <nts:with-parameter name="resource" value="Condition"/>
         <nts:with-parameter name="params" value="?context=EpisodeOfCare/${episode-id}"/>
      </nts:include>
      <nts:include value="assert.response.numResources" scope="common" resource="Condition" count="2"/>
      <!-- Zwangerschap -->
      <nts:include value="gbz-assert-returnCountWithCode">
         <nts:with-parameter name="additionalDescription" value="(Pregnancy)"/>
         <nts:with-parameter name="resource" value="Condition"/>
         <nts:with-parameter name="count" value="1"/>
         <nts:with-parameter name="code" value="118185001"/>
         <nts:with-parameter name="system" value="http://snomed.info/sct"/>
      </nts:include>
      <!-- Spina bifida -->
      <nts:include value="gbz-assert-returnCountWithCode">
         <nts:with-parameter name="additionalDescription" value="(Spina bifida)"/>
         <nts:with-parameter name="resource" value="Condition"/>
         <nts:with-parameter name="count" value="1"/>
         <nts:with-parameter name="code" value="76916001"/>
         <nts:with-parameter name="system" value="http://snomed.info/sct"/>
      </nts:include>
   </test>
   
   <!-- Encounters -->
   <test id="5-RetrieveEncounters">
      <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
      <name value="5-RetrieveEncounters"/>
      <description value="Retrieve all Encounter resources provided for this test, including the associated Practitioner"/>
      <nts:include value="medmij/test.phr.successfulsearch" scope="common">
         <nts:with-parameter name="resource" value="Encounter"/>
         <nts:with-parameter name="params" value="?episodeofcare=EpisodeOfCare/${episode-id}&amp;_include=Encounter:practitioner"/>
      </nts:include>
      <nts:include value="assert.response.numResources" scope="common" resource="Encounter" count="0"/>
      <nts:include value="assert.response.numResources" scope="common" resource="Practitioner" count="0"/>
   </test>  
      
