   <nts:authToken patientResourceId="L-XXX-Osse"/>
   <nts:fixture id="episodeofcare-fixture" href="gz-ize-kwa-casus1/mm-gbz-bc-MaternalRecord-d0510907-6af3-11ec-0000-020000000000.xml"/>
   <nts:fixture id="binary-fixture" href="gz-ize-kwa-casus1/mm-gbz-Binary-c674f0c3-6aae-11ec-2894-020000000000.xml"/>
   <variable>
      <name value="episode-id"/>
      <expression value="EpisodeOfCare.id"/>
      <sourceId value="episodeofcare-fixture"/>
   </variable>
   <variable>
      <name value="binary-id"/>
      <expression value="Binary.id"/>
      <sourceId value="binary-fixture"/>
