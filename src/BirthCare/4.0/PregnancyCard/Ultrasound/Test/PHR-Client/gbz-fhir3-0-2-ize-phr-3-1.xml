   <!-- Media -->
   <test id="10-RetrieveMedia">
      <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
      <name value="10-RetrieveMedia"/>
      <description value="Retrieve all current Media resources provided for this test"/>
      <!-- DocumentReference -->  
      <nts:include value="medmij/test.phr.successfulsearch" scope="common">
         <nts:with-parameter name="resource" value="DocumentReference"/>
         <nts:with-parameter name="params" value="?status=current"/>
      </nts:include>
      <nts:include value="assert.response.numResources" scope="common" resource="DocumentReference" count="1"/>
   </test>
      <!-- Binary -->
   <test id="11-RetrieveBinary">
      <nts:include value="test.client.ext.requestModes" scope="common" requestMode="random-order"/>
      <name value="11-RetrieveBinary"/>
      <description value="Retrieve all Binary resources form the DocumentReference provided for this test"/>
      <action>
        <operation>
            <type>
                <system value="http://hl7.org/fhir/restful-interaction"/>
                <code value="search"/>
            </type>
            <resource value="Binary"/>
            <description value="Test PHR client to retrieve Binary resources."/>
            <destination value="1"/>
            <origin value="1"/>
            <params value="/${binary-id}"/>
            <nts:include value="header.request.PatientToken" scope="common"/>
        </operation>
    </action>
      <nts:include value="assert.response.success" scope="common"/>
      <action>
        <assert>
            <description value="Confirm that the response contains 1 Binary resource(s)."/>
            <direction value="response"/>
            <expression value="Binary.id.count() = 1"/>
            <warningOnly value="false"/>
        </assert>
      </action>
   </test>
</TestScript>
