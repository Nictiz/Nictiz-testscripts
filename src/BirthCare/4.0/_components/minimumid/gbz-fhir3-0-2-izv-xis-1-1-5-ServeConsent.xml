<?xml version="1.0" encoding="UTF-8"?>
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
   <variable nts:in-targets="CheckContent">
      <name value="c-TreatmentDirective-mm-gbz-ccee86c4-6b5f-11ec-1040-020000000000-id"/>
      <description value="Resource.id for Consent 1"/>
      <expression value="Bundle.entry.resource.where($this is Consent).id"/>
      <sourceId value="fixture-5-ServeConsent"/>
   </variable>
   <test nts:in-targets="CheckContent">
      <name value="5-ServeConsent - Check Consent"/>
      <description value="Check if the previous operation results in a FHIR Consent that contains the values that are expected following Nictiz' materials (fixture .id: c-TreatmentDirective-mm-gbz-ccee86c4-6b5f-11ec-1040-020000000000)"/>
      <action>
         <assert nts:stopTestOnFail="true">
            <description value="Response Bundle contains exactly 1 Consent"/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is Consent).count() = 1"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert nts:stopTestOnFail="true">
            <description value="Consent resource evaluated in the previous assert contains an .id"/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is Consent).id.exists()"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <nts:include value="minimumid/assert" label="1-1" description="Contains .meta with .profile 'http://nictiz.nl/fhir/StructureDefinition/bc-TreatmentDirective'" expression="Bundle.entry.resource.where($this is Consent).where(id = '${c-TreatmentDirective-mm-gbz-ccee86c4-6b5f-11ec-1040-020000000000-id}')" minimumId="minimum-58687af3edb0b330e359" fixtureFile="consent-58687af3edb0b330e359.xml"/>
      <nts:include value="minimumid/assert" label="1-2" description="Contains .identifier with .system and .value" expression="Bundle.entry.resource.where($this is Consent).where(id = '${c-TreatmentDirective-mm-gbz-ccee86c4-6b5f-11ec-1040-020000000000-id}')" minimumId="minimum-ffd8cff97c9495a93515" fixtureFile="consent-ffd8cff97c9495a93515.xml"/>
      <nts:include value="minimumid/assert" label="1-3" description="Contains .status 'active'" expression="Bundle.entry.resource.where($this is Consent).where(id = '${c-TreatmentDirective-mm-gbz-ccee86c4-6b5f-11ec-1040-020000000000-id}')" minimumId="minimum-4ca0532bb99449c5c943" fixtureFile="consent-4ca0532bb99449c5c943.xml"/>
      <nts:include value="minimumid/assert" label="1-4" description="Contains .category with .coding with .system 'http://snomed.info/sct' and .code '129125009' and .display" expression="Bundle.entry.resource.where($this is Consent).where(id = '${c-TreatmentDirective-mm-gbz-ccee86c4-6b5f-11ec-1040-020000000000-id}')" minimumId="minimum-9a8672cc20f0255bb4d5" fixtureFile="consent-9a8672cc20f0255bb4d5.xml"/>
      <nts:include value="minimumid/assert" label="1-5" description="Contains .patient with either .reference or .identifier and .display" expression="Bundle.entry.resource.where($this is Consent).where(id = '${c-TreatmentDirective-mm-gbz-ccee86c4-6b5f-11ec-1040-020000000000-id}')" minimumId="minimum-5e827da4f641ee300868" fixtureFile="consent-5e827da4f641ee300868.xml"/>
      <nts:include value="minimumid/assert" label="1-6" description="Contains .dateTime" expression="Bundle.entry.resource.where($this is Consent).where(id = '${c-TreatmentDirective-mm-gbz-ccee86c4-6b5f-11ec-1040-020000000000-id}')" minimumId="minimum-e32b50ea7ace74a6bad4" fixtureFile="consent-e32b50ea7ace74a6bad4.xml"/>
      <nts:include value="minimumid/assert" label="1-7" description="Contains .consentingParty with either .reference or .identifier and .display" expression="Bundle.entry.resource.where($this is Consent).where(id = '${c-TreatmentDirective-mm-gbz-ccee86c4-6b5f-11ec-1040-020000000000-id}')" minimumId="minimum-c7a88e15a2b25924a26b" fixtureFile="consent-c7a88e15a2b25924a26b.xml"/>
      <nts:include value="minimumid/assert" label="1-8" description="Contains .policy with .uri" expression="Bundle.entry.resource.where($this is Consent).where(id = '${c-TreatmentDirective-mm-gbz-ccee86c4-6b5f-11ec-1040-020000000000-id}')" minimumId="minimum-90aacdc68715bab633be" fixtureFile="consent-90aacdc68715bab633be.xml"/>
      <nts:include value="minimumid/assert" label="1-9" description="Contains .except with .type 'permit', and .period with .end, and .code with .system 'http://snomed.info/sct' and .code '116762002' and .display" expression="Bundle.entry.resource.where($this is Consent).where(id = '${c-TreatmentDirective-mm-gbz-ccee86c4-6b5f-11ec-1040-020000000000-id}')" minimumId="minimum-2d33907ec973fb4ec171" fixtureFile="consent-2d33907ec973fb4ec171.xml"/>
   </test>
</nts:component>
