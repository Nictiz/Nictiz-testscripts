<?xml version="1.0" encoding="UTF-8"?>
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
   <variable nts:in-targets="CheckContent">
      <name value="relatedperson-mm-gbz-MOHAMMEDMELKADDOURI-id"/>
      <description value="Resource.id for RelatedPerson 1"/>
      <expression value="Bundle.entry.resource.where($this is RelatedPerson).where(relationship.coding.where(code = 'DOMPART')).id"/>
      <sourceId value="fixture-6-ServeRelatedPerson"/>
   </variable>
   <test nts:in-targets="CheckContent">
      <name value="6-ServeRelatedPerson - Check RelatedPerson"/>
      <description value="Check if the previous operation results in a FHIR RelatedPerson that contains the values that are expected following Nictiz' materials (fixture .id: relatedperson-mm-gbz-MOHAMMEDMELKADDOURI)"/>
      <action>
         <assert nts:stopTestOnFail="true">
            <description value="Response Bundle contains exactly 1 RelatedPerson with properties: contains relationship.coding.code = 'DOMPART' (domestic partner)"/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is RelatedPerson).where(relationship.coding.where(code = 'DOMPART')).count() = 1"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert nts:stopTestOnFail="true">
            <description value="RelatedPerson resource evaluated in the previous assert contains an .id"/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is RelatedPerson).where(relationship.coding.where(code = 'DOMPART')).id.exists()"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <nts:include value="minimumid/assert" label="1-1" description="Contains .meta with .profile 'http://fhir.nl/fhir/StructureDefinition/nl-core-relatedperson'" expression="Bundle.entry.resource.where($this is RelatedPerson).where(id = '${relatedperson-mm-gbz-MOHAMMEDMELKADDOURI-id}')" minimumId="minimum-5980f5a3484c8f9b6f1e" fixtureFile="relatedperson-5980f5a3484c8f9b6f1e.xml"/>
      <nts:include value="minimumid/assert" label="1-2" description="Contains .extension with url 'http://nictiz.nl/fhir/StructureDefinition/bc-patient-ethnicity' with .valueCodeableConcept with .coding with .system 'urn:oid:2.16.840.1.113883.2.4.4.13.28' and .code '5' and .display" expression="Bundle.entry.resource.where($this is RelatedPerson).where(id = '${relatedperson-mm-gbz-MOHAMMEDMELKADDOURI-id}')" minimumId="minimum-2531832a7f992496adff" fixtureFile="relatedperson-2531832a7f992496adff.xml"/>
      <nts:include value="minimumid/assert" label="1-3" description="Contains .identifier with .system and .value" expression="Bundle.entry.resource.where($this is RelatedPerson).where(id = '${relatedperson-mm-gbz-MOHAMMEDMELKADDOURI-id}')" minimumId="minimum-1591f9b206ab534371cc" fixtureFile="relatedperson-1591f9b206ab534371cc.xml"/>
      <nts:include value="minimumid/assert" label="1-4" description="Contains .patient with either .reference or .identifier and .display" expression="Bundle.entry.resource.where($this is RelatedPerson).where(id = '${relatedperson-mm-gbz-MOHAMMEDMELKADDOURI-id}')" minimumId="minimum-7831aaecdd5dbac7f459" fixtureFile="relatedperson-7831aaecdd5dbac7f459.xml"/>
      <nts:include value="minimumid/assert" label="1-5" description="Contains .relationship with .coding with .system 'http://hl7.org/fhir/v3/RoleCode' and .code 'DOMPART' and .display" expression="Bundle.entry.resource.where($this is RelatedPerson).where(id = '${relatedperson-mm-gbz-MOHAMMEDMELKADDOURI-id}')" minimumId="minimum-8d6255c510e34f1a96ec" fixtureFile="relatedperson-8d6255c510e34f1a96ec.xml"/>
      <nts:include value="minimumid/assert" label="1-6" description="Contains .name with .text with a value, and .family with a value and with .extension with url 'http://hl7.org/fhir/StructureDefinition/humanname-own-prefix' with .valueString with a value and .extension with url 'http://hl7.org/fhir/StructureDefinition/humanname-own-name' with .valueString with a value, and .given with a value and with .extension with url 'http://hl7.org/fhir/StructureDefinition/iso21090-EN-qualifier' with .valueCode 'BR', and .given with a value and with .extension with url 'http://hl7.org/fhir/StructureDefinition/iso21090-EN-qualifier' with .valueCode 'IN'" expression="Bundle.entry.resource.where($this is RelatedPerson).where(id = '${relatedperson-mm-gbz-MOHAMMEDMELKADDOURI-id}')" minimumId="minimum-412a8585ca863d110461" fixtureFile="relatedperson-412a8585ca863d110461.xml"/>
      <nts:include value="minimumid/assert" label="1-7" description="Contains .telecom with .extension with url 'http://nictiz.nl/fhir/StructureDefinition/zib-ContactInformation-TelecomType' with .valueCodeableConcept with .coding with .system 'http://hl7.org/fhir/v3/AddressUse' and .code 'MC' and .display and .system 'phone', and .value with a value, and .use 'mobile'" expression="Bundle.entry.resource.where($this is RelatedPerson).where(id = '${relatedperson-mm-gbz-MOHAMMEDMELKADDOURI-id}')" minimumId="minimum-fc4c176eea7527a0235c" fixtureFile="relatedperson-fc4c176eea7527a0235c.xml"/>
      <nts:include value="minimumid/assert" label="1-8" description="Contains .telecom with .system 'email', and .value with a value" expression="Bundle.entry.resource.where($this is RelatedPerson).where(id = '${relatedperson-mm-gbz-MOHAMMEDMELKADDOURI-id}')" minimumId="minimum-1aa5d55c6a093442a030" fixtureFile="relatedperson-1aa5d55c6a093442a030.xml"/>
   </test>
</nts:component>
