<?xml version="1.0" encoding="UTF-8"?>
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
   <variable nts:in-targets="CheckContent">
      <name value="7b035f27-6b20-11ec-1275-020000000000-id"/>
      <description value="Resource.id for Encounter 1"/>
      <expression value="Bundle.entry.resource.where($this is Encounter).where(type.coding.code = '11429006').id"/>
      <sourceId value="fixture-9-ServeEncounters"/>
   </variable>
   <test nts:in-targets="CheckContent">
      <name value="9-ServeEncounters - Check Encounter"/>
      <description value="Check if the previous operation results in a FHIR Encounter that contains the values that are expected following Nictiz' materials (fixture .id: 7b035f27-6b20-11ec-1275-020000000000)"/>
      <action>
         <assert nts:stopTestOnFail="true">
            <description value="Response Bundle contains exactly 1 Encounter with properties: contains type.coding.code = '11429006' (Consultation)"/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is Encounter).where(type.coding.code = '11429006').count() = 1"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert nts:stopTestOnFail="true">
            <description value="Encounter resource evaluated in the previous assert contains an .id"/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is Encounter).where(type.coding.code = '11429006').id.exists()"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <nts:include value="minimumid/assert" label="1-1" description="Contains .meta with .profile 'http://nictiz.nl/fhir/StructureDefinition/zib-Encounter' and .profile 'http://nictiz.nl/fhir/StructureDefinition/bc-Encounter'" expression="Bundle.entry.resource.where($this is Encounter).where(id = '${7b035f27-6b20-11ec-1275-020000000000-id}')" minimumId="minimum-eedd310996ee7ed317d1" fixtureFile="encounter-eedd310996ee7ed317d1.xml"/>
      <nts:include value="minimumid/assert" label="1-2" description="Contains .identifier with .system and .value" expression="Bundle.entry.resource.where($this is Encounter).where(id = '${7b035f27-6b20-11ec-1275-020000000000-id}')" minimumId="minimum-cbdd8c717d5f4eac4479" fixtureFile="encounter-cbdd8c717d5f4eac4479.xml"/>
      <nts:include value="minimumid/assert" label="1-3" description="Contains .status 'finished'" expression="Bundle.entry.resource.where($this is Encounter).where(id = '${7b035f27-6b20-11ec-1275-020000000000-id}')" minimumId="minimum-ae449e329d1859702f0e" fixtureFile="encounter-ae449e329d1859702f0e.xml"/>
      <nts:include value="minimumid/assert" label="1-4" description="Contains .class with .extension with url 'http://nictiz.nl/fhir/StructureDefinition/code-specification' with .valueCodeableConcept with .coding with .system 'http://hl7.org/fhir/v3/ActCode' and .code 'AMB' and .display and .system 'http://hl7.org/fhir/v3/ActCode' and .code 'AMB' and .display" expression="Bundle.entry.resource.where($this is Encounter).where(id = '${7b035f27-6b20-11ec-1275-020000000000-id}')" minimumId="minimum-53eceacea8f6977509a7" fixtureFile="encounter-53eceacea8f6977509a7.xml" warningOnly="true"/>
      <nts:include value="minimumid/assert" label="1-5" description="Contains .type with .coding with .system 'http://snomed.info/sct' and .code '11429006' and .display" expression="Bundle.entry.resource.where($this is Encounter).where(id = '${7b035f27-6b20-11ec-1275-020000000000-id}')" minimumId="minimum-3dd6d716ce389bcba335" fixtureFile="encounter-3dd6d716ce389bcba335.xml"/>
      <nts:include value="minimumid/assert" label="1-6" description="Contains .subject with either .reference or .identifier and .display" expression="Bundle.entry.resource.where($this is Encounter).where(id = '${7b035f27-6b20-11ec-1275-020000000000-id}')" minimumId="minimum-8721486ded7466143144" fixtureFile="encounter-8721486ded7466143144.xml"/>
      <nts:include value="minimumid/assert" label="1-7" description="Contains .episodeOfCare with either .reference or .identifier and .display" expression="Bundle.entry.resource.where($this is Encounter).where(id = '${7b035f27-6b20-11ec-1275-020000000000-id}')" minimumId="minimum-499a2f13f5fb31bc64dd" fixtureFile="encounter-499a2f13f5fb31bc64dd.xml"/>
      <nts:include value="minimumid/assert" label="1-8" description="Contains .participant with .individual with .extension with url 'http://nictiz.nl/fhir/StructureDefinition/practitionerrole-reference' with .valueReference with either .reference or .identifier and .display, and with either .reference or .identifier and .display" expression="Bundle.entry.resource.where($this is Encounter).where(id = '${7b035f27-6b20-11ec-1275-020000000000-id}')" minimumId="minimum-3ce571bcd9e7f17ac6b0" fixtureFile="encounter-3ce571bcd9e7f17ac6b0.xml"/>
      <nts:include value="minimumid/assert" label="1-9" description="Contains .period with .start and .end" expression="Bundle.entry.resource.where($this is Encounter).where(id = '${7b035f27-6b20-11ec-1275-020000000000-id}')" minimumId="minimum-22d0ab894da5a002b8a0" fixtureFile="encounter-22d0ab894da5a002b8a0.xml"/>
      <nts:include value="minimumid/assert" label="1-10" description="Contains .reason with .extension with url 'http://nictiz.nl/fhir/StructureDefinition/bc-encounter-reasonreference' with .valueReference with either .reference or .identifier and .display" expression="Bundle.entry.resource.where($this is Encounter).where(id = '${7b035f27-6b20-11ec-1275-020000000000-id}')" minimumId="minimum-48e1231401f7f100f05b" fixtureFile="encounter-48e1231401f7f100f05b.xml"/>
      <nts:include value="minimumid/assert" label="1-11" description="Contains .diagnosis with .condition with either .reference or .identifier and .display" expression="Bundle.entry.resource.where($this is Encounter).where(id = '${7b035f27-6b20-11ec-1275-020000000000-id}')" minimumId="minimum-fc561445beb9f6dbc2b0" fixtureFile="encounter-fc561445beb9f6dbc2b0.xml"/>
   </test>
