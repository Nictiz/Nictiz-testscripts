      <nts:include value="minimumid/assert" label="1" description="Check the expected Encounter content against the minimum fixture." expression="Bundle.entry.resource.where($this is Encounter).where(id = '${7b035f27-6b20-11ec-1275-020000000000-id}')" minimumId="7b035f27-6b20-11ec-1275-020000000000-min" fixtureFile="mm-gbz-bc-Encounter-7b035f27-6b20-11ec-1275-020000000000-min.xml"/>
