<?xml version="1.0" encoding="UTF-8"?>
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
   <variable nts:in-targets="CheckContent">
      <name value="744c5203-6b78-11ec-2891-020000000000-id"/>
      <description value="Resource.id for DocumentReference 1"/>
      <expression value="Bundle.entry.resource.where($this is DocumentReference).id"/>
      <sourceId value="fixture-10-RetrieveMedia"/>
   </variable>
   <test nts:in-targets="CheckContent">
      <name value="10-RetrieveMedia - Check DocumentReference"/>
      <description value="Check if the previous operation results in a FHIR DocumentReference that contains the values that are expected following Nictiz' materials (fixture .id: 744c5203-6b78-11ec-2891-020000000000)"/>
      <action>
         <assert nts:stopTestOnFail="true">
            <description value="Response Bundle contains exactly 1 DocumentReference"/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is DocumentReference).count() = 1"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert nts:stopTestOnFail="true">
            <description value="DocumentReference resource evaluated in the previous assert contains an .id"/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is DocumentReference).id.exists()"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <nts:include value="minimumid/assert" label="1-1" description="Contains .meta with .profile 'http://nictiz.nl/fhir/StructureDefinition/IHE.MHD.Minimal.DocumentReference'" expression="Bundle.entry.resource.where($this is DocumentReference).where(id = '${744c5203-6b78-11ec-2891-020000000000-id}')" minimumId="minimum-3b529f4bce4f1501c479" fixtureFile="documentreference-3b529f4bce4f1501c479.xml"/>
      <nts:include value="minimumid/assert" label="1-2" description="Contains .masterIdentifier with .system and .value" expression="Bundle.entry.resource.where($this is DocumentReference).where(id = '${744c5203-6b78-11ec-2891-020000000000-id}')" minimumId="minimum-40a64d84c3f35a43f881" fixtureFile="documentreference-40a64d84c3f35a43f881.xml"/>
      <nts:include value="minimumid/assert" label="1-3" description="Contains .identifier with .system and .value" expression="Bundle.entry.resource.where($this is DocumentReference).where(id = '${744c5203-6b78-11ec-2891-020000000000-id}')" minimumId="minimum-ed847b73027ac99a886e" fixtureFile="documentreference-ed847b73027ac99a886e.xml"/>
      <nts:include value="minimumid/assert" label="1-4" description="Contains .status 'current'" expression="Bundle.entry.resource.where($this is DocumentReference).where(id = '${744c5203-6b78-11ec-2891-020000000000-id}')" minimumId="minimum-80960957d003b5342881" fixtureFile="documentreference-80960957d003b5342881.xml"/>
      <nts:include value="minimumid/assert" label="1-5" description="Contains .type with .coding with .system 'http://snomed.info/sct' and .code '9781000146100' and .display" expression="Bundle.entry.resource.where($this is DocumentReference).where(id = '${744c5203-6b78-11ec-2891-020000000000-id}')" minimumId="minimum-50a3d6de553acd7ab8ef" fixtureFile="documentreference-50a3d6de553acd7ab8ef.xml"/>
      <nts:include value="minimumid/assert" label="1-6" description="Contains .subject with either .reference or .identifier and .display" expression="Bundle.entry.resource.where($this is DocumentReference).where(id = '${744c5203-6b78-11ec-2891-020000000000-id}')" minimumId="minimum-c3d68a889dcbd51b086c" fixtureFile="documentreference-c3d68a889dcbd51b086c.xml"/>
      <nts:include value="minimumid/assert" label="1-7" description="Contains .indexed" expression="Bundle.entry.resource.where($this is DocumentReference).where(id = '${744c5203-6b78-11ec-2891-020000000000-id}')" minimumId="minimum-174fcf342567e8b47a80" fixtureFile="documentreference-174fcf342567e8b47a80.xml"/>
      <nts:include value="minimumid/assert" label="1-8" description="Contains .content with .attachment with .contentType and with either .data or .url" expression="Bundle.entry.resource.where($this is DocumentReference).where(id = '${744c5203-6b78-11ec-2891-020000000000-id}')" minimumId="minimum-b77cf6a9f4acff5e59c8" fixtureFile="documentreference-b77cf6a9f4acff5e59c8.xml"/>
   </test>
</nts:component>
