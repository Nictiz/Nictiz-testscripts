<?xml version="1.0" encoding="UTF-8"?>
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
   <variable nts:in-targets="CheckContent">
      <name value="d58a7136-6af5-11ec-2312-020000000000-id"/>
      <description value="Resource.id for Condition 1"/>
      <expression value="Bundle.entry.resource.where($this is Condition).id"/>
      <sourceId value="fixture-8b-ServeConditions"/>
   </variable>
   <test nts:in-targets="CheckContent">
      <name value="8b-ServeConditions - Check Condition"/>
      <description value="Check if the previous operation results in a FHIR Condition that contains the values that are expected following Nictiz' materials (fixture .id: d58a7136-6af5-11ec-2312-020000000000)"/>
      <action>
         <assert nts:stopTestOnFail="true">
            <description value="Response Bundle contains exactly 1 Condition"/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is Condition).count() = 1"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert nts:stopTestOnFail="true">
            <description value="Condition resource evaluated in the previous assert contains an .id"/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is Condition).id.exists()"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <nts:include value="minimumid/assert" label="1-1" description="Contains .meta with .profile 'http://nictiz.nl/fhir/StructureDefinition/zib-Wound'" expression="Bundle.entry.resource.where($this is Condition).where(id = '${d58a7136-6af5-11ec-2312-020000000000-id}')" minimumId="minimum-19a3c1bc227551a27bb3" fixtureFile="condition-19a3c1bc227551a27bb3.xml"/>
      <nts:include value="minimumid/assert" label="1-2" description="Contains .identifier with .system and .value" expression="Bundle.entry.resource.where($this is Condition).where(id = '${d58a7136-6af5-11ec-2312-020000000000-id}')" minimumId="minimum-e02eda8b275e0bdecdd8" fixtureFile="condition-e02eda8b275e0bdecdd8.xml"/>
      <nts:include value="minimumid/assert" label="1-3" description="Contains .clinicalStatus 'active'" expression="Bundle.entry.resource.where($this is Condition).where(id = '${d58a7136-6af5-11ec-2312-020000000000-id}')" minimumId="minimum-4b33f86332101ea00e3d" fixtureFile="condition-4b33f86332101ea00e3d.xml"/>
      <nts:include value="minimumid/assert" label="1-4" description="Contains .code with .coding with .system 'http://snomed.info/sct' and .code '31781000146105' and .display" expression="Bundle.entry.resource.where($this is Condition).where(id = '${d58a7136-6af5-11ec-2312-020000000000-id}')" minimumId="minimum-7302f856eb29809d2585" fixtureFile="condition-7302f856eb29809d2585.xml"/>
      <nts:include value="minimumid/assert" label="1-5" description="Contains .subject with either .reference or .identifier and .display" expression="Bundle.entry.resource.where($this is Condition).where(id = '${d58a7136-6af5-11ec-2312-020000000000-id}')" minimumId="minimum-3cbd01180cb2c9226616" fixtureFile="condition-3cbd01180cb2c9226616.xml"/>
      <nts:include value="minimumid/assert" label="1-6" description="Contains .context with either .reference or .identifier and .display" expression="Bundle.entry.resource.where($this is Condition).where(id = '${d58a7136-6af5-11ec-2312-020000000000-id}')" minimumId="minimum-3c6c07a3d5aa30aedc03" fixtureFile="condition-3c6c07a3d5aa30aedc03.xml"/>
   </test>
</nts:component>
