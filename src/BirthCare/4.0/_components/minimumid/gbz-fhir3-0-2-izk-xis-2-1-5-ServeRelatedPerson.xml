<?xml version="1.0" encoding="UTF-8"?>
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
   <variable nts:in-targets="CheckContent">
      <name value="relatedperson-mm-gbz-TOONXXX-VISSER-id"/>
      <description value="Resource.id for RelatedPerson 1"/>
      <expression value="Bundle.entry.resource.where($this is RelatedPerson).where(relationship.coding.where(code = 'HUSB')).id"/>
      <sourceId value="fixture-5-ServeRelatedPerson"/>
   </variable>
   <test nts:in-targets="CheckContent">
      <name value="5-ServeRelatedPerson - Check RelatedPerson"/>
      <description value="Check if the previous operation results in a FHIR RelatedPerson that contains the values that are expected following Nictiz' materials (fixture .id: relatedperson-mm-gbz-TOONXXX-VISSER)"/>
      <action>
         <assert nts:stopTestOnFail="true">
            <description value="Response Bundle contains exactly 1 RelatedPerson with properties: contains relationship.coding.code = 'HUSB'"/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is RelatedPerson).where(relationship.coding.where(code = 'HUSB')).count() = 1"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert nts:stopTestOnFail="true">
            <description value="RelatedPerson resource evaluated in the previous assert contains an .id"/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is RelatedPerson).where(relationship.coding.where(code = 'HUSB')).id.exists()"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <nts:include value="minimumid/assert" label="1-1" description="Contains .meta with .profile 'http://fhir.nl/fhir/StructureDefinition/nl-core-relatedperson'" expression="Bundle.entry.resource.where($this is RelatedPerson).where(id = '${relatedperson-mm-gbz-TOONXXX-VISSER-id}')" minimumId="minimum-5980f5a3484c8f9b6f1e" fixtureFile="relatedperson-5980f5a3484c8f9b6f1e.xml"/>
      <nts:include value="minimumid/assert" label="1-2" description="Contains .identifier with .system and .value" expression="Bundle.entry.resource.where($this is RelatedPerson).where(id = '${relatedperson-mm-gbz-TOONXXX-VISSER-id}')" minimumId="minimum-1591f9b206ab534371cc" fixtureFile="relatedperson-1591f9b206ab534371cc.xml"/>
      <nts:include value="minimumid/assert" label="1-3" description="Contains .patient with either .reference or .identifier and .display" expression="Bundle.entry.resource.where($this is RelatedPerson).where(id = '${relatedperson-mm-gbz-TOONXXX-VISSER-id}')" minimumId="minimum-7831aaecdd5dbac7f459" fixtureFile="relatedperson-7831aaecdd5dbac7f459.xml"/>
      <nts:include value="minimumid/assert" label="1-4" description="Contains .relationship with .coding with .system 'http://hl7.org/fhir/v3/RoleCode' and .code 'HUSB' and .display" expression="Bundle.entry.resource.where($this is RelatedPerson).where(id = '${relatedperson-mm-gbz-TOONXXX-VISSER-id}')" minimumId="minimum-f83d1ee37ae4562dc17d" fixtureFile="relatedperson-f83d1ee37ae4562dc17d.xml"/>
      <nts:include value="minimumid/assert" label="1-5" description="Contains .name with .extension with url 'http://hl7.org/fhir/StructureDefinition/humanname-assembly-order' with .valueCode 'NL1' and .text with a value, and .family with a value and with .extension with url 'http://hl7.org/fhir/StructureDefinition/humanname-own-name' with .valueString with a value, and .given with a value and with .extension with url 'http://hl7.org/fhir/StructureDefinition/iso21090-EN-qualifier' with .valueCode 'BR'" expression="Bundle.entry.resource.where($this is RelatedPerson).where(id = '${relatedperson-mm-gbz-TOONXXX-VISSER-id}')" minimumId="minimum-f317a368cafc57b702de" fixtureFile="relatedperson-f317a368cafc57b702de.xml"/>
      <nts:include value="minimumid/assert" label="1-6" description="Contains .telecom with .extension with url 'http://nictiz.nl/fhir/StructureDefinition/zib-ContactInformation-TelecomType' with .valueCodeableConcept with .coding with .system 'http://hl7.org/fhir/v3/AddressUse' and .code 'MC' and .display and .system 'phone', and .value with a value, and .use 'mobile'" expression="Bundle.entry.resource.where($this is RelatedPerson).where(id = '${relatedperson-mm-gbz-TOONXXX-VISSER-id}')" minimumId="minimum-fc4c176eea7527a0235c" fixtureFile="relatedperson-fc4c176eea7527a0235c.xml"/>
      <nts:include value="minimumid/assert" label="1-7" description="Contains .birthDate" expression="Bundle.entry.resource.where($this is RelatedPerson).where(id = '${relatedperson-mm-gbz-TOONXXX-VISSER-id}')" minimumId="minimum-72ec2fa3c72c9c6780a1" fixtureFile="relatedperson-72ec2fa3c72c9c6780a1.xml"/>
   </test>
</nts:component>
