<?xml version="1.0" encoding="UTF-8"?>
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
   <variable nts:in-targets="CheckContent FullComparison">
      <name value="relatedperson-mm-gbz-TOONXXX-VISSER-id"/>
      <description value="Resource.id for RelatedPerson 1"/>
      <expression value="Bundle.entry.resource.where($this is RelatedPerson).where(relationship.coding.where(code = 'HUSB')).id"/>
      <sourceId value="fixture-5-ServeRelatedPerson"/>
   </variable>
   <test nts:in-targets="CheckContent FullComparison">
      <name value="5-ServeRelatedPerson - Check RelatedPerson"/>
      <description value="Check if the previous operation results in a FHIR RelatedPerson that contains the values that are expected following Nictiz' materials (fixture .id: relatedperson-mm-gbz-TOONXXX-VISSER)"/>
      <action>
         <assert nts:stopTestOnFail="true">
            <description value="Response Bundle contains exactly 1 RelatedPerson with properties: contains relationship.coding.code = 'HUSB'"/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is RelatedPerson).where(relationship.coding.where(code = 'HUSB')).count() = 1"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert nts:stopTestOnFail="true">
            <description value="RelatedPerson resource evaluated in the previous assert contains an .id"/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is RelatedPerson).where(relationship.coding.where(code = 'HUSB')).id.exists()"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <nts:include value="minimumid/assert" label="1" description="Check the expected RelatedPerson content against the minimum fixture." expression="Bundle.entry.resource.where($this is RelatedPerson).where(id = '${relatedperson-mm-gbz-TOONXXX-VISSER-id}')" minimumId="relatedperson-mm-gbz-TOONXXX-VISSER-min" fixtureFile="mm-gbz-nl-core-relatedperson-relatedperson-mm-gbz-TOONXXX-VISSER-min.xml" nts:in-targets="CheckContent"/>
      <nts:include value="minimumid/assert" label="1" description="Compare all known RelatedPerson scenario content with the full minimum fixture." expression="Bundle.entry.resource.where($this is RelatedPerson).where(id = '${relatedperson-mm-gbz-TOONXXX-VISSER-id}')" minimumId="relatedperson-mm-gbz-TOONXXX-VISSER-full-min" fixtureFile="mm-gbz-nl-core-relatedperson-relatedperson-mm-gbz-TOONXXX-VISSER-full-min.xml" nts:in-targets="FullComparison" fixtureDir="fullcomparison"/>
   </test>
</nts:component>
