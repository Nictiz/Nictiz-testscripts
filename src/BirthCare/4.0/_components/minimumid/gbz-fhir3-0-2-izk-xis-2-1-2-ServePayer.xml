      </action>
      <nts:include value="minimumid/assert" label="1-1" description="Contains .meta with .profile 'http://nictiz.nl/fhir/StructureDefinition/zib-Payer'" expression="Bundle.entry.resource.where($this is Coverage).where(id = '${Payer-mm-gbz-06923be3-6b2c-11ec-2129-020000000000-1-id}')" minimumId="minimum-77dfc9a5ef48041a3a0a" fixtureFile="coverage-77dfc9a5ef48041a3a0a.xml"/>
      <nts:include value="minimumid/assert" label="1-2" description="Contains .identifier with .system and .value" expression="Bundle.entry.resource.where($this is Coverage).where(id = '${Payer-mm-gbz-06923be3-6b2c-11ec-2129-020000000000-1-id}')" minimumId="minimum-475d5d9a321190ca7427" fixtureFile="coverage-475d5d9a321190ca7427.xml"/>
      <nts:include value="minimumid/assert" label="1-3" description="Contains .subscriber with either .reference or .identifier and .display" expression="Bundle.entry.resource.where($this is Coverage).where(id = '${Payer-mm-gbz-06923be3-6b2c-11ec-2129-020000000000-1-id}')" minimumId="minimum-b6629be9ef68613708ad" fixtureFile="coverage-b6629be9ef68613708ad.xml"/>
      <nts:include value="minimumid/assert" label="1-4" description="Contains .beneficiary with either .reference or .identifier and .display" expression="Bundle.entry.resource.where($this is Coverage).where(id = '${Payer-mm-gbz-06923be3-6b2c-11ec-2129-020000000000-1-id}')" minimumId="minimum-b14a1eb4115e4146fa1f" fixtureFile="coverage-b14a1eb4115e4146fa1f.xml"/>
      <nts:include value="minimumid/assert" label="1-5" description="Contains .period with .start and .end" expression="Bundle.entry.resource.where($this is Coverage).where(id = '${Payer-mm-gbz-06923be3-6b2c-11ec-2129-020000000000-1-id}')" minimumId="minimum-742512a00c599b32bf18" fixtureFile="coverage-742512a00c599b32bf18.xml"/>
      <nts:include value="minimumid/assert" label="1-6" description="Contains .payor with either .reference or .identifier and .display" expression="Bundle.entry.resource.where($this is Coverage).where(id = '${Payer-mm-gbz-06923be3-6b2c-11ec-2129-020000000000-1-id}')" minimumId="minimum-713309b6e69c1029eaaa" fixtureFile="coverage-713309b6e69c1029eaaa.xml"/>
