<?xml version="1.0" encoding="UTF-8"?>
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
   <variable nts:in-targets="CheckContent">
      <name value="Payer-mm-gbz-06923be3-6b2c-11ec-2129-020000000000-1-id"/>
      <description value="Resource.id for Coverage 1"/>
      <expression value="Bundle.entry.resource.where($this is Coverage).id"/>
      <sourceId value="fixture-2-ServePayer"/>
   </variable>
   <test nts:in-targets="CheckContent">
