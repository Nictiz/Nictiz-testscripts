<?xml version="1.0" encoding="UTF-8"?>
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
   <variable nts:in-targets="CheckContent">
      <name value="IRIS-I-XXX-KRUIK-id"/>
      <description value="Resource.id for Patient 1"/>
      <expression value="Bundle.entry.resource.where($this is Patient).id"/>
      <sourceId value="fixture-1-ServeWoman"/>
   </variable>
   <test nts:in-targets="CheckContent">
      <name value="1-ServeWoman - Check Patient"/>
      <description value="Check if the previous operation results in a FHIR Patient that contains the values that are expected following Nictiz' materials (fixture .id: IRIS-I-XXX-KRUIK)"/>
      <action>
         <assert nts:stopTestOnFail="true">
            <description value="Response Bundle contains exactly 1 Patient"/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is Patient).count() = 1"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert nts:stopTestOnFail="true">
            <description value="Patient resource evaluated in the previous assert contains an .id"/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is Patient).id.exists()"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <nts:include value="minimumid/assert" label="1" description="Check the expected Patient content against the minimum fixture." expression="Bundle.entry.resource.where($this is Patient).where(id = '${IRIS-I-XXX-KRUIK-id}')" minimumId="minimum-c48f20756eeb17779640" fixtureFile="patient-c48f20756eeb17779640.xml"/>
   </test>
</nts:component>
