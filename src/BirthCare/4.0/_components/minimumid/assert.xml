<?xml version="1.0" encoding="UTF-8"?>
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
   <nts:parameter name="warningOnly" value="false"/>
   <nts:parameter name="fixtureDir" value="checkcontent"/>
   <nts:fixture id="{$minimumId}" href="minimum/{$fixtureDir}/{$fixtureFile}"/>
   <action>
      <assert>
         <label value="{$label}"/>
         <description value="{$description}"/>
         <direction value="response"/>
         <expression value="{$expression}"/>
         <minimumId value="{$minimumId}"/>
         <warningOnly value="{$warningOnly}"/>
      </assert>
   </action>
</nts:component>
