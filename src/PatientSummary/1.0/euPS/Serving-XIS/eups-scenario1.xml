<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript" nts:scenario="server">
    <id value="eups-scenario1"/>
    <version value="r4.0.1"/>
    <title value="Scenario 1 - Serve EU Patient summary"/>
    <description value="url fhir ig"/>

    <nts:clAuthExtension patientResourceId="medmij-bgz-patient-ts-01" id="Enter your bearer token"/>

    <test>
      <name value="Scenario1"/>
      <description value="Provide EU Patient Summary"/>
      <action>
         <operation>
            <type>
               <system value="http://hl7.org/fhir/restful-interaction"/>
               <code value="read"/>
            </type>
            <resource value="Patient"/>
            <description value="Test XIS server to provide a EU Patient Summary."/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <origin value="1"/>
            <requestHeader>
               <field value="Accept"/>
               <value value="application/fhir+xml"/>
            </requestHeader>
            <requestHeader>
               <field value="Prefer"/>
               <value value="return=representation"/>
            </requestHeader>
         </operation>
      </action>
    </test>
</TestScript>
