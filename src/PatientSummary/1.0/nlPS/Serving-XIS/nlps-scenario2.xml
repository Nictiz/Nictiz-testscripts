<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript" nts:scenario="server">
    <id value="nlps-scenario2"/>
    <version value="r4.0.1"/>
    <title value="Scenario 2 - NL-PS level 2: Narrative summaries only"/>
    <description value="The serving system provides an NL-PS for its level 2 test patient, in which every mandatory section has a narrative summary and no structured entries. The patient is selected by the token entered at test setup. Implementation Guide: https://build.fhir.org/ig/Nictiz/NL-PS-IG/"/>

    <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-authentication">
        <extension url="display">
            <valueString value="NL-PS level 2 test patient"/>
        </extension>
        <extension url="access-token">
            <valueString value=""/>
        </extension>
    </extension>

    <test>
        <name value="Search Patient Summary"/>
        <description value="Search the NL-PS Composition of the test patient."/>
        <nts:include value="ps.test.search"/>
    </test>

    <test>
        <name value="Retrieve Patient Summary document"/>
        <description value="Retrieve the NL-PS as a document Bundle with $document and check the document as a whole."/>
        <nts:include value="ps.test.document"
            bundleProfile="http://hl7.org/fhir/StructureDefinition/Bundle"
            compositionProfile="http://ig.nictiz.nl/nlps/StructureDefinition/nl-PatientSummary"
            validationWarningOnly="true"/>
        <!-- Warning only until the GBB package with the nl-core profiles that NL-PS refers to exists. -->
    </test>

    <test>
        <name value="Level 2 checks"/>
        <description value="Check that every mandatory section has a narrative summary and no structured entries."/>
        <nts:include value="ps.level2"/>
    </test>
</TestScript>
