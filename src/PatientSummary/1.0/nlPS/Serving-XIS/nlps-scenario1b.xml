<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript" nts:scenario="server">
    <id value="nlps-scenario1b"/>
    <version value="r4.0.1"/>
    <title value="Scenario 1b - Serve NL Patient summary"/>
    <description value="url fhir ig"/>

    <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-authentication">
      <extension url="display">
         <valueString value="Enter your bearer token"/>
      </extension>
      <extension url="access-token">
         <valueString value=""/>
      </extension>
   </extension>

    <test>
      <name value="1"/>
      <description value="Provide NL Patient Summary"/>
      <action>
         <operation>
            <type>
               <system value="http://hl7.org/fhir/restful-interaction"/>
               <code value="read"/>
            </type>
            <resource value="Patient"/>
            <description value="Test XIS server to provide a NL Patient Summary."/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <origin value="1"/>
            <requestHeader>
               <field value="Accept"/>
               <value value="application/fhir+xml"/>
            </requestHeader>
            <requestHeader>
               <field value="Prefer"/>
               <value value="return=representation"/>
            </requestHeader>
         </operation>
      </action>
    </test>
</TestScript>
