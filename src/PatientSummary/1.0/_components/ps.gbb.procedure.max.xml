<?xml version="1.0" encoding="UTF-8"?>
<!--
    Section History of procedures on levels 3b and 4b: the elements that the GBB profile http://ig.nictiz.nl/gbb/StructureDefinition/nl-core-Procedure marks
    SHOULD:populate-if-known are present on at least one entry.
    @param sectionName - Human readable name of the section.
    @param sectionCode - LOINC code of the section.
    @param resourceType - The resource type of the GBB.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.gbb.element.any" element="a method (extension procedure-method)" elementCondition="extension.where(url = 'http://hl7.org/fhir/StructureDefinition/procedure-method').value.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="an identifier" elementCondition="identifier.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a category" elementCondition="category.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a performed[x]" elementCondition="performed.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a performer.actor" elementCondition="performer.actor.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a location" elementCondition="location.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a reasonCode" elementCondition="reasonCode.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a reasonReference" elementCondition="reasonReference.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a bodySite" elementCondition="bodySite.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="an outcome" elementCondition="outcome.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a complication" elementCondition="complication.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a note.text" elementCondition="note.text.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a focalDevice.manipulated" elementCondition="focalDevice.manipulated.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a usedReference" elementCondition="usedReference.exists()"/>
</nts:component>
