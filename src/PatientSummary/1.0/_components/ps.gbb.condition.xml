<?xml version="1.0" encoding="UTF-8"?>
<!--
    Section Problems on levels 3b and 4b: every Condition in the document has the elements that the GBB profile
    http://ig.nictiz.nl/gbb/StructureDefinition/nl-core-Condition marks SHALL:populate, and, as a warning, the elements it marks
    SHOULD:populate-if-known. The checks follow the order of the profile.
    The profile marks identifier SHALL:populate, but that obligation is too strict; it is checked as
    SHOULD:populate-if-known.
    @param sectionName - Human readable name of the section.
    @param sectionCode - LOINC code of the section.
    @param resourceType - The resource type of the GBB.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.gbb.element.all" element="a language" elementCondition="language.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a related artifact (extension artifact-relatedArtifact)" elementCondition="extension.where(url = 'http://hl7.org/fhir/StructureDefinition/artifact-relatedArtifact').exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="an identifier" elementCondition="identifier.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a clinicalStatus" elementCondition="clinicalStatus.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a verificationStatus" elementCondition="verificationStatus.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a category" elementCondition="category.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a severity" elementCondition="severity.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a code" elementCondition="code.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a code.text" elementCondition="code.text.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a bodySite" elementCondition="bodySite.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a bodySite with a body structure (extension bodySite)" elementCondition="bodySite.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/bodySite').value.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a subject" elementCondition="subject.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="an onset" elementCondition="onset.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="an abatement" elementCondition="abatement.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a recordedDate" elementCondition="recordedDate.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a recorder" elementCondition="recorder.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="an asserter" elementCondition="asserter.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a stage.summary" elementCondition="stage.summary.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a stage.type" elementCondition="stage.type.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a note.text" elementCondition="note.text.exists()" warningOnly="true"/>
</nts:component>
