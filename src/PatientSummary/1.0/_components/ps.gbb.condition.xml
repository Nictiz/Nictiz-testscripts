<?xml version="1.0" encoding="UTF-8"?>
<!--
    Section Problems on levels 3b and 4b: the elements that the GBB profile http://ig.nictiz.nl/gbb/StructureDefinition/nl-core-Condition marks
    SHALL:populate are present on every Condition in the document.
    The profile marks identifier SHALL:populate, but that obligation is too strict; ps.gbb.condition.max checks it
    as SHOULD:populate-if-known.
    @param sectionName - Human readable name of the section.
    @param sectionCode - LOINC code of the section.
    @param resourceType - The resource type of the GBB.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.gbb.element.all" element="a code" elementCondition="code.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a subject" elementCondition="subject.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="an onset" elementCondition="onset.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a recordedDate" elementCondition="recordedDate.exists()"/>
</nts:component>
