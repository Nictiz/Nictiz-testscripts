<?xml version="1.0" encoding="UTF-8"?>
<!--
    Section History of procedures on levels 3 and 4: entries that refer to Procedure resources conforming to the GBB profile
    http://ig.nictiz.nl/gbb/StructureDefinition/nl-core-Procedure, each with the elements the profile marks SHALL:populate.
    @param sectionName - Human readable name of the section.
    @param sectionCode - LOINC code of the section.
    @param resourceType - The resource type of the GBB.
    @param minEntries - The minimum number of entries.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.section.gbb" profile="http://ig.nictiz.nl/gbb/StructureDefinition/nl-core-Procedure"/>
    <nts:include value="ps.assert.gbb.element.all" element="a status" elementCondition="status.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a code" elementCondition="code.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a subject" elementCondition="subject.exists()"/>
</nts:component>
