<?xml version="1.0" encoding="UTF-8"?>
<!--
    Section History of procedures on levels 3b and 4b: every Procedure in the document has the elements that the GBB profile
    http://ig.nictiz.nl/gbb/StructureDefinition/nl-core-Procedure marks SHALL:populate, and, as a warning, the elements it marks
    SHOULD:populate-if-known. The checks follow the order of the profile.
    The profile marks performer.actor SHALL:populate-if-known; it is checked as a warning, like the
    SHOULD:populate-if-known elements.
    @param sectionName - Human readable name of the section.
    @param sectionCode - LOINC code of the section.
    @param resourceType - The resource type of the GBB.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.gbb.element.all" element="a language" elementCondition="language.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a method (extension procedure-method)" elementCondition="extension.where(url = 'http://hl7.org/fhir/StructureDefinition/procedure-method').value.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a recorded date (extension extension-Procedure.recorded)" elementCondition="extension.where(url = 'http://hl7.org/fhir/5.0/StructureDefinition/extension-Procedure.recorded').value.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="an identifier" elementCondition="identifier.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a status" elementCondition="status.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a category" elementCondition="category.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a code" elementCondition="code.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a subject" elementCondition="subject.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a performedDateTime or performedPeriod" elementCondition="performed.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a recorder" elementCondition="recorder.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="an asserter" elementCondition="asserter.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a performer.actor" elementCondition="performer.actor.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a location" elementCondition="location.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a reasonCode" elementCondition="reasonCode.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a reasonReference" elementCondition="reasonReference.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a bodySite" elementCondition="bodySite.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="an outcome" elementCondition="outcome.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a complication" elementCondition="complication.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a note.text" elementCondition="note.text.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a focalDevice.manipulated" elementCondition="focalDevice.manipulated.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a usedReference" elementCondition="usedReference.exists()" warningOnly="true"/>
</nts:component>
