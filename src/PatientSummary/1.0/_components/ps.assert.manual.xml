<?xml version="1.0" encoding="UTF-8"?>
<!--
    Manual check by the test coordinator. The check fails unless the test coordinator passes it.
    Conformancelab only waits for a manual check that directly follows an operation, and skips any assert after it in
    the same test. Keep this the last action of the test that holds the $document operation.
    @param check - What the test coordinator judges.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <action>
        <assert>
            <description value="Manual check by the test coordinator: {$check}"/>
            <defaultManualCompletion value="fail"/>
            <operator value="manualEval"/>
        </assert>
    </action>
</nts:component>
