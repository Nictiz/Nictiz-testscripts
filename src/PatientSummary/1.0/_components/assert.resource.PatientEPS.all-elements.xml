<?xml version="1.0" encoding="UTF-8"?>
<!--
    Strict content coverage for the Nictiz GBB nl-core-Patient profile.
    Use with a deliberately complete Patient fixture: all SHOULD:populate-if-known
    elements are expected to be present in that fixture.
    The mutually exclusive choice branches are checked by
    assert.resource.GBB-Patient.choice-elements.xml.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:parameter name="direction" value="response"/>

<!--General checks-->
    <action>
        <assert>
            <description value="Exactly one Patient with the requested id is returned."/>
            <direction value="{$direction}"/>
            <expression value="Bundle.entry.resource.ofType(Patient).where(id = '{$patientId}').count() = 1"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="The Patient declares the Patient (EPS) nl-core-Patient profile."/>
            <direction value="{$direction}"/>
            <expression value="Bundle.entry.resource.ofType(Patient).where(id = '{$patientId}').meta.profile.contains('http://hl7.eu/fhir/eps/StructureDefinition/patient-eu-eps')"/>
        </assert>
    </action>


<!--Element checks-->
    <action>
        <assert>
            <description value="Patient identifier is present."/>
            <direction value="{$direction}"/>
            <expression value="Bundle.entry.resource.ofType(Patient).where(id = '{$patientId}').identifier.exists()"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="Patient name use is present."/>
            <direction value="{$direction}"/>
            <expression value="Bundle.entry.resource.ofType(Patient).where(id = '{$patientId}').name.use.exists()"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="Patient name is present as a simple text name."/>
            <direction value="{$direction}"/>
            <expression value="Bundle.entry.resource.ofType(Patient).where(id = '{$patientId}').name.text.exists()"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="Patient family name is present."/>
            <direction value="{$direction}"/>
            <expression value="Bundle.entry.resource.ofType(Patient).where(id = '{$patientId}').name.family.exists()"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="Patient given name is present."/>
            <direction value="{$direction}"/>
            <expression value="Bundle.entry.resource.ofType(Patient).where(id = '{$patientId}').name.given.exists()"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="Patient contact information is present."/>
            <direction value="{$direction}"/>
            <expression value="Bundle.entry.resource.ofType(Patient).where(id = '{$patientId}').telecom.exists()"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="Administrative gender is present."/>
            <direction value="{$direction}"/>
            <expression value="Bundle.entry.resource.ofType(Patient).where(id = '{$patientId}').gender.exists()"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="Date of birth is present."/>
            <direction value="{$direction}"/>
            <expression value="Bundle.entry.resource.ofType(Patient).where(id = '{$patientId}').birthDate.exists()"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="Patient address is present."/>
            <direction value="{$direction}"/>
            <expression value="Bundle.entry.resource.ofType(Patient).where(id = '{$patientId}').address.exists()"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="General practitioner is present."/>
            <direction value="{$direction}"/>
            <expression value="Bundle.entry.resource.ofType(Patient).where(id = '{$patientId}').generalPractitioner.exists()"/>
        </assert>
    </action>
</nts:component>
