<?xml version="1.0" encoding="UTF-8"?>
<!--
    Metadata GBB PractitionerRole on level 1b: if the document holds a PractitionerRole, at least one PractitionerRole has the elements that the GBB profile
    http://ig.nictiz.nl/gbb/StructureDefinition/nl-core-PractitionerRole marks SHALL:populate, and, as a warning, the elements it marks
    SHOULD:populate-if-known. The checks follow the order of the profile.
    @param resourceType - The resource type of the GBB.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.metadata.element" element="a practitioner" elementCondition="practitioner.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="an organization" elementCondition="organization.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a code" elementCondition="code.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a specialty" elementCondition="specialty.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a telecom" elementCondition="telecom.exists()" warningOnly="true"/>
</nts:component>
