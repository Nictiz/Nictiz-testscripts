<?xml version="1.0" encoding="UTF-8"?>
<!--
    Step 2 of retrieving a Patient Summary: retrieve the Composition found in step 1 as a document Bundle with
    $document, and check the document as a whole. The Composition is selected with an expression and validated against
    the profile set in the TestScript, whether or not it claims it in meta.profile. Later tests without an operation
    check parts of the same document: Conformancelab evaluates them against the response of this operation.
    @param bundleProfile - The profile the returned Bundle is validated against.
    @param compositionProfile - The profile the Composition is validated against.
    @param [validationWarningOnly] - Report a failed profile validation as a warning. Defaults to false.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:parameter name="validationWarningOnly" value="false"/>
    <nts:profile id="ps-bundle-profile" value="{$bundleProfile}"/>
    <nts:profile id="ps-composition-profile" value="{$compositionProfile}"/>

    <action>
        <operation>
            <type>
                <system value="http://hl7.org/fhir/restful-interaction"/>
                <code value="read"/>
            </type>
            <resource value="Composition"/>
            <description value="Retrieve the Patient Summary as a document: GET [base]/Composition/[id]/$document"/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <origin value="1"/>
            <params value="/${composition-id}/$document"/>
            <responseId value="ps-document"/>
        </operation>
    </action>
    <nts:include value="assert.response.success" scope="common"/>
    <action>
        <assert nts:stopTestOnFail="true">
            <description value="Confirm that the response is a Bundle."/>
            <direction value="response"/>
            <resource value="Bundle"/>
        </assert>
    </action>
    <action>
        <assert nts:stopTestOnFail="true">
            <description value="Confirm that the Bundle is a document. (FHIR R4 allows a server to wrap the document in a searchset Bundle; that is not accepted here.)"/>
            <direction value="response"/>
            <expression value="Bundle.type = 'document'"/>
        </assert>
    </action>
    <action>
        <assert nts:stopTestOnFail="true">
            <description value="Confirm that the first entry of the document is a Composition."/>
            <direction value="response"/>
            <expression value="Bundle.entry.first().resource.is(Composition)"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="Confirm that the Composition is a Patient Summary (type LOINC 60591-5)."/>
            <direction value="response"/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).type.coding.where(system = 'http://loinc.org' and code = '60591-5').exists()"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="Confirm that the document conforms to {$bundleProfile}."/>
            <direction value="response"/>
            <validateProfileId value="ps-bundle-profile"/>
            <warningOnly value="{$validationWarningOnly}"/>
        </assert>
    </action>
    <action>
        <assert>
            <description value="Confirm that the Composition conforms to {$compositionProfile}, and through it to the EU-PS profile it imposes."/>
            <direction value="response"/>
            <expression value="Bundle.entry.first().resource"/>
            <validateProfileId value="ps-composition-profile"/>
            <warningOnly value="{$validationWarningOnly}"/>
        </assert>
    </action>
</nts:component>
