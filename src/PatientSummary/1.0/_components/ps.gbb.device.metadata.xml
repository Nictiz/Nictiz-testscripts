<?xml version="1.0" encoding="UTF-8"?>
<!--
    Metadata GBB Device on level 1b: if the document holds a Device, at least one Device has the elements that the GBB profile
    http://ig.nictiz.nl/gbb/StructureDefinition/nl-core-Device marks SHALL:populate, and, as a warning, the elements it marks
    SHOULD:populate-if-known. The checks follow the order of the profile.
    @param resourceType - The resource type of the GBB.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.metadata.element" element="an identifier" elementCondition="identifier.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a udiCarrier with a deviceIdentifier" elementCondition="udiCarrier.deviceIdentifier.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a udiCarrier.issuer" elementCondition="udiCarrier.issuer.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a manufacturer" elementCondition="manufacturer.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a manufactureDate" elementCondition="manufactureDate.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="an expirationDate" elementCondition="expirationDate.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a lotNumber" elementCondition="lotNumber.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a serialNumber" elementCondition="serialNumber.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a deviceName with a name and a type" elementCondition="deviceName.where(name.exists() and type.exists()).exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a modelNumber" elementCondition="modelNumber.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a type" elementCondition="type.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a version with a value" elementCondition="version.value.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a note.text" elementCondition="note.text.exists()" warningOnly="true"/>
</nts:component>
