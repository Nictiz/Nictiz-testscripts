<?xml version="1.0" encoding="UTF-8"?>
<!--
    Section Allergies and intolerances on levels 3b and 4b: every AllergyIntolerance in the document has the elements that the GBB profile
    http://ig.nictiz.nl/gbb/StructureDefinition/nl-core-AllergyIntolerance marks SHALL:populate, and, as a warning, the elements it marks
    SHOULD:populate-if-known. The checks follow the order of the profile.
    @param sectionName - Human readable name of the section.
    @param sectionCode - LOINC code of the section.
    @param resourceType - The resource type of the GBB.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.gbb.element.all" element="a language" elementCondition="language.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="an identifier" elementCondition="identifier.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a clinicalStatus" elementCondition="clinicalStatus.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a verificationStatus" elementCondition="verificationStatus.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a category" elementCondition="category.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a criticality" elementCondition="criticality.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a code" elementCondition="code.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a patient" elementCondition="patient.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a recorder" elementCondition="recorder.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="an asserter" elementCondition="asserter.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a lastOccurrence" elementCondition="lastOccurrence.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a note.text" elementCondition="note.text.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a reaction" elementCondition="reaction.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a reaction certainty (extension allergyintolerance-certainty)" elementCondition="reaction.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/allergyintolerance-certainty').value.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a reaction.substance" elementCondition="reaction.substance.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a manifestation and an onset on every reaction" elementCondition="reaction.all(manifestation.exists() and onset.exists())"/>
    <nts:include value="ps.assert.gbb.element.all" element="a reaction.description" elementCondition="reaction.description.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a reaction.severity" elementCondition="reaction.severity.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a reaction.exposureRoute" elementCondition="reaction.exposureRoute.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.gbb.element.all" element="a reaction.note.text" elementCondition="reaction.note.text.exists()" warningOnly="true"/>
</nts:component>
