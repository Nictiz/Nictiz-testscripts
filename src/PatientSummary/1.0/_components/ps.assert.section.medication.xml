<?xml version="1.0" encoding="UTF-8"?>
<!--
    Levels 3 and 4: check section Medication summary of the document. Medication is out of scope, so the section has
    no entries, and has an emptyReason and a narrative. Use in a test without an operation after ps.test.document.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.section" sectionName="Medication summary" sectionCode="10160-0"
        condition="exists()"
        conditionDescription="the section is present."/>
    <nts:include value="ps.assert.section" sectionName="Medication summary" sectionCode="10160-0"
        condition="all(entry.empty() and emptyReason.exists() and text.exists())"
        conditionDescription="the section has no entries, and has an emptyReason and a narrative."/>
</nts:component>
