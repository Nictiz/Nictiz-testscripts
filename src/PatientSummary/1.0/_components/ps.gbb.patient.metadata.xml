<?xml version="1.0" encoding="UTF-8"?>
<!--
    Metadata GBB Patient on level 1b: if the document holds a Patient, at least one Patient has the elements that the GBB profile
    http://ig.nictiz.nl/gbb/StructureDefinition/nl-core-Patient marks SHALL:populate, and, as a warning, the elements it marks
    SHOULD:populate-if-known. The checks follow the order of the profile.
    @param resourceType - The resource type of the GBB.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.metadata.element" element="an identifier" elementCondition="identifier.exists()"/>
    <nts:include value="ps.assert.metadata.element" element="a gender identity with a value (extension individual-genderIdentity)" elementCondition="extension.where(url = 'http://hl7.org/fhir/StructureDefinition/individual-genderIdentity').extension.where(url = 'value').value.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="pronouns with a value (extension individual-pronouns)" elementCondition="extension.where(url = 'http://hl7.org/fhir/StructureDefinition/individual-pronouns').extension.where(url = 'value').value.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a sex parameter for clinical use with a value (extension patient-sexParameterForClinicalUse)" elementCondition="extension.where(url = 'http://hl7.org/fhir/StructureDefinition/patient-sexParameterForClinicalUse').extension.where(url = 'value').value.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a BSN" elementCondition="identifier.where(system = 'http://fhir.nl/fhir/NamingSystem/bsn').exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a name" elementCondition="name.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a telecom" elementCondition="telecom.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a gender" elementCondition="gender.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a birthDate" elementCondition="birthDate.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a deceased[x]" elementCondition="deceased.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="an address" elementCondition="address.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a maritalStatus" elementCondition="maritalStatus.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a multipleBirth[x]" elementCondition="multipleBirth.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a contact" elementCondition="contact.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a contact.name" elementCondition="contact.name.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a contact.telecom" elementCondition="contact.telecom.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a contact.address" elementCondition="contact.address.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a contact.organization" elementCondition="contact.organization.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a generalPractitioner" elementCondition="generalPractitioner.exists()" warningOnly="true"/>
</nts:component>
