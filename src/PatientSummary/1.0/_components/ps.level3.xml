<?xml version="1.0" encoding="UTF-8"?>
<!--
    Levels 3 and 4: every mandatory section except Medication summary holds a minimum number of entries that refer to
    generic building blocks (GBBs) in the document, each with the elements the GBB profile marks SHALL:populate.
    Medication summary has no entries, and has an emptyReason and a narrative, because medication is out of scope.
    @param minEntries - The minimum number of entries per GBB section: 1 for level 3, 2 for level 4.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.sections"
        condition="exists()"
        conditionDescription="the section is present."/>
    <nts:include value="ps.gbb.condition" sectionName="Problems" sectionCode="11450-4" resourceType="Condition"/>
    <nts:include value="ps.gbb.allergyintolerance" sectionName="Allergies and intolerances" sectionCode="48765-2" resourceType="AllergyIntolerance"/>
    <nts:include value="ps.gbb.procedure" sectionName="History of procedures" sectionCode="47519-4" resourceType="Procedure"/>
    <nts:include value="ps.gbb.deviceuse" sectionName="Medical devices" sectionCode="46264-8" resourceType="DeviceUseStatement"/>
    <nts:include value="ps.assert.section" sectionName="Medication summary" sectionCode="10160-0"
        condition="all(entry.empty() and emptyReason.exists() and text.div.exists())"
        conditionDescription="the section has no entries, and has an emptyReason and a narrative."/>
    <nts:include value="ps.assert.section" sectionName="Medication summary" sectionCode="10160-0"
        condition="all(text.status != 'generated')"
        conditionDescription="the narrative is not generated from entries (text.status is not 'generated')."
        warningOnly="true"/>
</nts:component>
