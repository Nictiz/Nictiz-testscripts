<?xml version="1.0" encoding="UTF-8"?>
<!--
    Assert that every resource of a type in the document has an element. The check covers every resource of that
    type in the document, also one that the section does not refer to. ps.assert.section.gbb checks that the entries
    of the section refer to resources of that type.
    @param sectionName - Human readable name of the section.
    @param sectionCode - LOINC code of the section.
    @param resourceType - The resource type of the GBB, e.g. 'Condition'.
    @param element - Human readable name of the element.
    @param elementCondition - FHIRPath applied to each resource, e.g. 'code.exists()'.
    @param [warningOnly] - Defaults to false.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:parameter name="warningOnly" value="false"/>
    <action>
        <assert>
            <description value="Entries of section {$sectionName} (LOINC {$sectionCode}): every {$resourceType} in the document has {$element}."/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is {$resourceType}).all({$elementCondition})"/>
            <warningOnly value="{$warningOnly}"/>
        </assert>
    </action>
</nts:component>
