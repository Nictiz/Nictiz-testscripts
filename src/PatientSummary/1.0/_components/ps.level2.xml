<?xml version="1.0" encoding="UTF-8"?>
<!--
    Level 2: every mandatory section has a narrative summary and no structured entries. Medication summary also has an
    emptyReason, because medication is out of scope. Whether the summaries are readable and meaningful is judged by
    the test coordinator with ps.assert.manual.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.sections"
        condition="exists()"
        conditionDescription="the section is present."/>
    <nts:include value="ps.assert.sections"
        condition="all(entry.empty() and text.div.exists())"
        conditionDescription="the section has a narrative and no entries."/>
    <nts:include value="ps.assert.section" sectionName="Medication summary" sectionCode="10160-0"
        condition="all(emptyReason.exists())"
        conditionDescription="the section has an emptyReason."/>
    <nts:include value="ps.assert.sections"
        condition="all(text.status != 'generated')"
        conditionDescription="the narrative is not generated from entries (text.status is not 'generated')."
        warningOnly="true"/>
</nts:component>
