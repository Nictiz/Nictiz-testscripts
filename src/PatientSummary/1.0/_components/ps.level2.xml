<?xml version="1.0" encoding="UTF-8"?>
<!--
    Level 2: every mandatory section has a narrative summary and no structured entries. Whether the summaries are
    readable and meaningful is judged by the test coordinator.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.sections"
        condition="exists()"
        conditionDescription="the section is present."/>
    <nts:include value="ps.assert.sections"
        condition="all(entry.empty() and text.div.exists())"
        conditionDescription="the section has a narrative and no entries."/>
    <!-- Conformancelab only waits for a manual check that directly follows an operation, and skips any assert
         after it in the same test. Keep this the last action of the test that holds the $document operation. -->
    <action>
        <assert>
            <description value="Manual check by the test coordinator: every section has a readable, meaningful narrative summary of the patient's information."/>
            <defaultManualCompletion value="fail"/>
            <operator value="manualEval"/>
        </assert>
    </action>
</nts:component>
