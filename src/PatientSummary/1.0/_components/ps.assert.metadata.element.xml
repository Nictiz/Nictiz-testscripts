<?xml version="1.0" encoding="UTF-8"?>
<!--
    Assert that, if the document holds resources of a type, at least one of them has an element. Used for the
    metadata GBBs on level 1b, where one filled resource per type is enough.
    @param resourceType - The resource type of the GBB, e.g. 'Practitioner'.
    @param element - Human readable name of the element.
    @param elementCondition - FHIRPath applied to each resource, e.g. 'name.exists()'.
    @param [warningOnly] - Defaults to false.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:parameter name="warningOnly" value="false"/>
    <action>
        <assert>
            <description value="Metadata: if the document holds a {$resourceType}, at least one {$resourceType} has {$element}."/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is {$resourceType}).empty() or Bundle.entry.resource.where($this is {$resourceType}).where({$elementCondition}).exists()"/>
            <warningOnly value="{$warningOnly}"/>
        </assert>
    </action>
</nts:component>
