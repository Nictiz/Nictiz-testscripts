<?xml version="1.0" encoding="UTF-8"?>
<!--
    Metadata GBB Organization on level 1b: if the document holds a Organization, at least one Organization has the elements that the GBB profile
    http://ig.nictiz.nl/gbb/StructureDefinition/nl-core-Organization marks SHALL:populate, and, as a warning, the elements it marks
    SHOULD:populate-if-known. The checks follow the order of the profile.
    Known issue: of the Organization obligations only name is SHALL; the other SHALL:populate obligations in the
    profile are treated as SHOULD:populate-if-known.
    @param resourceType - The resource type of the GBB.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.metadata.element" element="an identifier" elementCondition="identifier.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a type" elementCondition="type.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a name" elementCondition="name.exists()"/>
    <nts:include value="ps.assert.metadata.element" element="a telecom" elementCondition="telecom.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="an address" elementCondition="address.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.metadata.element" element="a partOf" elementCondition="partOf.exists()" warningOnly="true"/>
</nts:component>
