<?xml version="1.0" encoding="UTF-8"?>
<!--
    Assert that a section holds a minimum number of entries, that every entry refers to a resource of the expected type
    in the document, and that the narrative is generated from the entries. A reference matches the fullUrl of a
    document entry or its relative form [type]/[id]. resolve() is not used, as the HL7 FHIRPath engine does not resolve
    references inside a Bundle.
    @param sectionName - Human readable name of the section.
    @param sectionCode - LOINC code of the section.
    @param resourceType - The resource type of the GBB, e.g. 'Condition'.
    @param profile - Canonical of the GBB profile.
    @param minEntries - The minimum number of entries.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.section"
        condition="entry.count() &gt;= {$minEntries}"
        conditionDescription="the section has at least {$minEntries} entries."/>
    <nts:include value="ps.assert.section"
        condition="all(entry.reference.subsetOf(%resource.entry.where(resource is {$resourceType}).select(fullUrl | ('{$resourceType}/' + resource.id))))"
        conditionDescription="every entry refers to a {$resourceType} in the document."/>
    <action>
        <assert>
            <description value="Every {$resourceType} in the document claims the profile {$profile}."/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is {$resourceType}).all(meta.profile.where($this.startsWith('{$profile}')).exists())"/>
            <warningOnly value="true"/>
        </assert>
    </action>
    <nts:include value="ps.assert.section"
        condition="all(text.div.exists())"
        conditionDescription="the section has a narrative."/>
    <nts:include value="ps.assert.section"
        condition="all(text.status = 'generated')"
        conditionDescription="the narrative is generated from the entries (text.status is 'generated')."
        warningOnly="true"/>
</nts:component>
