<?xml version="1.0" encoding="UTF-8"?>
<!--
    Section Problems on levels 3b and 4b: the elements that the GBB profile http://ig.nictiz.nl/gbb/StructureDefinition/nl-core-Condition marks
    SHOULD:populate-if-known are present on every entry.
    @param sectionName - Human readable name of the section.
    @param sectionCode - LOINC code of the section.
    @param resourceType - The resource type of the GBB.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.gbb.element.all" element="a language" elementCondition="language.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a related artifact (extension artifact-relatedArtifact)" elementCondition="extension.where(url = 'http://hl7.org/fhir/StructureDefinition/artifact-relatedArtifact').exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a clinicalStatus" elementCondition="clinicalStatus.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a verificationStatus" elementCondition="verificationStatus.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a category" elementCondition="category.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a severity" elementCondition="severity.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a code.text" elementCondition="code.text.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a bodySite" elementCondition="bodySite.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a bodySite with a body structure (extension bodySite)" elementCondition="bodySite.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/bodySite').value.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="an abatement" elementCondition="abatement.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a recorder" elementCondition="recorder.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="an asserter" elementCondition="asserter.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a stage.summary" elementCondition="stage.summary.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a stage.type" elementCondition="stage.type.exists()"/>
    <nts:include value="ps.assert.gbb.element.all" element="a note.text" elementCondition="note.text.exists()"/>
</nts:component>
