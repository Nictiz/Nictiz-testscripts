<?xml version="1.0" encoding="UTF-8"?>
<!--
    Section Allergies and intolerances on levels 3b and 4b: the elements that the GBB profile http://ig.nictiz.nl/gbb/StructureDefinition/nl-core-AllergyIntolerance marks
    SHOULD:populate-if-known are present on at least one entry.
    @param sectionName - Human readable name of the section.
    @param sectionCode - LOINC code of the section.
    @param resourceType - The resource type of the GBB.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.gbb.element.any" element="a language" elementCondition="language.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="an identifier" elementCondition="identifier.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a verificationStatus" elementCondition="verificationStatus.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a category" elementCondition="category.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a criticality" elementCondition="criticality.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a recorder" elementCondition="recorder.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="an asserter" elementCondition="asserter.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a lastOccurrence" elementCondition="lastOccurrence.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a note.text" elementCondition="note.text.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a reaction" elementCondition="reaction.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a reaction certainty (extension allergyintolerance-certainty)" elementCondition="reaction.extension.where(url = 'http://hl7.org/fhir/StructureDefinition/allergyintolerance-certainty').value.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a reaction.substance" elementCondition="reaction.substance.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a reaction.description" elementCondition="reaction.description.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a reaction.severity" elementCondition="reaction.severity.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a reaction.exposureRoute" elementCondition="reaction.exposureRoute.exists()"/>
    <nts:include value="ps.assert.gbb.element.any" element="a reaction.note.text" elementCondition="reaction.note.text.exists()"/>
</nts:component>
