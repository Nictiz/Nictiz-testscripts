<?xml version="1.0" encoding="UTF-8"?>
<!--
    Assert a condition on the Patient Summary Composition in the response of the last operation.
    Conformancelab evaluates an assert against the response of the operation it follows and ignores
    assert.sourceId, so include this component directly after the $document operation.
    @param element - Human readable name of what is checked.
    @param condition - FHIRPath applied to the Composition.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <action>
        <assert>
            <description value="Confirm that the Composition contains {$element}."/>
            <direction value="response"/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).{$condition}"/>
        </assert>
    </action>
</nts:component>
