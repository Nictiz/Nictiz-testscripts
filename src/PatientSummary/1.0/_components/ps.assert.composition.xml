<?xml version="1.0" encoding="UTF-8"?>
<!--
    Assert a condition on the Patient Summary Composition in the response 'ps-document'.
    @param element - Human readable name of what is checked.
    @param condition - FHIRPath applied to the Composition.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <action>
        <assert>
            <description value="Confirm that the Composition contains {$element}."/>
            <expression value="Bundle.entry.first().resource.ofType(Composition).{$condition}"/>
            <sourceId value="ps-document"/>
        </assert>
    </action>
</nts:component>
