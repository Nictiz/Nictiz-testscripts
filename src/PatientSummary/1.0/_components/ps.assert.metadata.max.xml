<?xml version="1.0" encoding="UTF-8"?>
<!--
    Maximum metadata: every Composition element that the NL-PS Composition profile marks mustSupport is present.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.composition" element="a language" condition="language.exists()"/>
    <nts:include value="ps.assert.composition" element="a version (extension-Composition.version)" condition="extension.where(url = 'http://hl7.org/fhir/5.0/StructureDefinition/extension-Composition.version').value.exists()"/>
    <nts:include value="ps.assert.composition" element="an identifier" condition="identifier.value.exists()"/>
    <nts:include value="ps.assert.composition" element="a status" condition="status.exists()"/>
    <nts:include value="ps.assert.composition" element="a category" condition="category.exists()"/>
    <nts:include value="ps.assert.composition" element="a subject" condition="subject.exists()"/>
    <nts:include value="ps.assert.composition" element="a date" condition="date.exists()"/>
    <nts:include value="ps.assert.composition" element="an author" condition="author.exists()"/>
    <nts:include value="ps.assert.composition" element="a title" condition="title.exists()"/>
    <nts:include value="ps.assert.composition" element="a legal attester with time and party" condition="attester.where(mode = 'legal' and time.exists() and party.exists()).exists()"/>
    <nts:include value="ps.assert.composition" element="a professional attester (validator) with time and party" condition="attester.where(mode = 'professional' and time.exists() and party.exists()).exists()"/>
    <nts:include value="ps.assert.composition" element="a custodian" condition="custodian.exists()"/>
    <nts:include value="ps.assert.composition" element="an event with a code" condition="event.code.exists()"/>
    <nts:include value="ps.assert.composition" element="an event with a period" condition="event.period.exists()"/>
</nts:component>
