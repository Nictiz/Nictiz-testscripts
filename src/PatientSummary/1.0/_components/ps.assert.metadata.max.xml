<?xml version="1.0" encoding="UTF-8"?>
<!--
    Maximum metadata (level 1b). The Composition has the elements that the NL-PS Composition profile marks
    SHALL:populate, and, as a warning, the elements it marks SHOULD:populate-if-known. The attesters have no obligation
    themselves, so their presence is a warning. The metadata GBBs follow in ps.gbb.[type].metadata.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.composition" element="a language" condition="language.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.composition" element="a version (extension-Composition.version)" condition="extension.where(url = 'http://hl7.org/fhir/5.0/StructureDefinition/extension-Composition.version').value.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.composition" element="an identifier" condition="identifier.value.exists()"/>
    <nts:include value="ps.assert.composition" element="a status" condition="status.exists()"/>
    <nts:include value="ps.assert.composition" element="a category" condition="category.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.composition" element="a subject" condition="subject.exists()"/>
    <nts:include value="ps.assert.composition" element="a date" condition="date.exists()"/>
    <nts:include value="ps.assert.composition" element="an author" condition="author.exists()"/>
    <nts:include value="ps.assert.composition" element="a title" condition="title.exists()"/>
    <nts:include value="ps.assert.composition" element="a legal attester with time and party" condition="attester.where(mode = 'legal' and time.exists() and party.exists()).exists()" warningOnly="true"/>
    <nts:include value="ps.assert.composition" element="a professional attester (validator) with time and party" condition="attester.where(mode = 'professional' and time.exists() and party.exists()).exists()" warningOnly="true"/>
    <nts:include value="ps.assert.composition" element="a custodian" condition="custodian.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.composition" element="an event with a code" condition="event.code.exists()" warningOnly="true"/>
    <nts:include value="ps.assert.composition" element="an event with a period" condition="event.period.exists()" warningOnly="true"/>
    <nts:include value="ps.gbb.patient.metadata" resourceType="Patient"/>
    <nts:include value="ps.gbb.practitioner.metadata" resourceType="Practitioner"/>
    <nts:include value="ps.gbb.practitionerrole.metadata" resourceType="PractitionerRole"/>
    <nts:include value="ps.gbb.device.metadata" resourceType="Device"/>
    <nts:include value="ps.gbb.organization.metadata" resourceType="Organization"/>
</nts:component>
