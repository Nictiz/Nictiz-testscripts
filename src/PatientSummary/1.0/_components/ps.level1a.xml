<?xml version="1.0" encoding="UTF-8"?>
<!--
    Level 1a: minimal metadata and empty sections. Every mandatory section is present, has no entries, and has an
    emptyReason and a human readable narrative. The minimal metadata is covered by profile validation in step 2.
-->
<nts:component xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
    <nts:include value="ps.assert.sections"
        condition="exists()"
        conditionDescription="the section is present."/>
    <nts:include value="ps.assert.sections"
        condition="all(entry.empty() and emptyReason.exists() and text.div.exists())"
        conditionDescription="the section has no entries, and has an emptyReason and a narrative."/>
</nts:component>
