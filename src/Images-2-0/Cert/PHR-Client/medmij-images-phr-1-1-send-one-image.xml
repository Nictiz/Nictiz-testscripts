<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://hl7.org/fhir/STU3/testscript.sch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript"
    nts:scenario="client">
    <id value="phr-1-1-send-image"/>
    <version value="stu3-2.0"/>
    <title value="Scenario 1.1 - Send One Image of person 'XXX-TEST-C'"/>
    <description value="Qualification of scenario 1.1 of the Images Receive use case. See [the test file on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/Beelden_Sturen) for more information."/>
    <nts:clAuthExtension patientResourceId="selfmeasurement-patient-kwalificatie1" id="XXX-TEST-C"/>
    <nts:fixture id="scenario-1-1-bundle-fixture"
        href="transaction-bundles/images-scenario-1-1-Bundle-one-image.xml"/>
    <variable>
        <name value="T"/>
        <defaultValue value="${CURRENTDATETIME}"/>
        <description value="Date that data and queries are expected to be relative to."/>
    </variable>

    <test id="scenario1-1-send-one-image">
        <description value="Send one image in a Bundle transaction and check the request"/>
        <nts:include value="medmij/test.phr.successfulTransaction" scope="common" sourceId="scenario-1-1-bundle-fixture" description="Send a FHIR transaction Bundle"/>
        <nts:include value="assert.request.numResources" scope="common"
            resource="Media" count="1"/>
        <nts:include value="assert.request.numResources" scope="common"
            resource="Binary" count="1"/>
        <nts:include value="assert.request.numResources" scope="common"
            resource="Patient" count="1"/>
        <nts:include value="assert.request.numResources" scope="common"
            resource="Practitioner" count="1"/>
        <action>
            <assert>
                <description
                    value="Confirm that all resources contain a meta.profile tag, minus the Bundle and Binary resource."/>
                <direction value="request"/>
                <expression
                    value="Bundle.entry.resource.meta.profile.count() = Bundle.entry.resource.count()-1"
                />
            </assert>
        </action>
        <action>
            <assert>
                <description
                    value="Confirm that the Media resource has a recipient extension with a value."/>
                <direction value="request"/>
                <expression
                    value="Bundle.entry.resource.ofType(List).extension.where(url = 'http://nictiz.nl/fhir/StructureDefinition/images-recipient').value.exists()"
                />
            </assert>
        </action>
    </test>
</TestScript>
