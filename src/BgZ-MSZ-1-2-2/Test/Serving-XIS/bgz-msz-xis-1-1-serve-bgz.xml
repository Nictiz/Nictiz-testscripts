    <id value="bgz-msz-xis-1-1-serve-bgz"/>
    <version value="stu3-3.0"/>
    <title value="Scenario 1.1 - Serve BgZ resources of DE-BOER"/>
    <description value="Test of scenario 1.1 of the BgZ MSZ 1.2.2 Serve use case. See [the test file on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/bgz:V1.2.3_Testscripts) for more information."/>
