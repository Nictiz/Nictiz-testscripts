    <test id="01-serve-Patient">
        <description value="Serve zib-Patient instance including the patient's general practitioner and check the response"/>
        <nts:include value="test.server.successfulSearch" scope="common"
            resource="Patient"
            params="?identifier=http://fhir.nl/fhir/NamingSystem/bsn|999996538&amp;_include=Patient:general-practitioner"
            useToken="true" description="Receive a FHIR search on Patient, including 'identifier' and '_include' parameters, and send a response"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Patient" count="1" nts:in-targets="#default"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Practitioner" count="0" nts:in-targets="#default"/>
        
        <nts:contentAsserts href="resources/DE-BOER.xml" nts:in-targets="CheckContent"/>
    </test>

