            params="/$lastn?patient.identifier=http://fhir.nl/fhir/NamingSystem/bsn|999991346&amp;code=http://loinc.org|85354-9"
            useToken="true" description="Receive a FHIR $lastn search on Observation, including 'patient.identifier' and 'code' parameters, and send a response"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Observation" count="1"/>
        
        <action>
