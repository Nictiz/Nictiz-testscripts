    <test id="01-retrieve-Patient">
        <description value="Retrieve zib-Patient instance including the patient's general practitioner and check the request"/>
        <nts:include value="test.client.search" scope="common"
            resource="Patient"
            params="?identifier=http://fhir.nl/fhir/NamingSystem/bsn|999996976&amp;_include=Patient:general-practitioner"
            useToken="true" description="Send a FHIR search on Patient, including the correct 'identifier' and '_include' parameters"/>
        <nts:include value="canary-assert.response.successfulSearch" scope="common"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Patient" count="1"/>
        <nts:include value="assert.response.numResources" scope="common"
            resource="Practitioner" count="1"/>
    </test>

