<Organization xmlns="http://hl7.org/fhir">
   <meta>
      <profile value="http://fhir.nl/fhir/StructureDefinition/nl-core-organization"/>
   </meta>
   <identifier>
      <system>
         <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-minimumId-exists">
            <valueBoolean value="true"/>
         </extension>
      </system>
      <value>
         <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-minimumId-exists">
            <valueBoolean value="true"/>
         </extension>
      </value>
   </identifier>
   <type>
      <coding>
         <system value="http://nictiz.nl/fhir/NamingSystem/organization-type"/>
         <code value="G3"/>
         <display>
            <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-minimumId-exists">
               <valueBoolean value="true"/>
            </extension>
         </display>
      </coding>
   </type>
   <name>
      <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-minimumId-existsWithValue">
         <valueBoolean value="true"/>
      </extension>
   </name>
   <telecom>
      <extension url="http://nictiz.nl/fhir/StructureDefinition/zib-ContactInformation-TelecomType">
         <valueCodeableConcept>
            <coding>
               <system value="http://hl7.org/fhir/v3/AddressUse"/>
               <code value="MC"/>
               <display>
                  <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-minimumId-exists">
                     <valueBoolean value="true"/>
                  </extension>
               </display>
            </coding>
         </valueCodeableConcept>
      </extension>
      <system value="phone"/>
      <value>
         <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-minimumId-existsWithValue">
            <valueBoolean value="true"/>
         </extension>
      </value>
      <use value="mobile"/>
   </telecom>
</Organization>
