<Patient xmlns="http://hl7.org/fhir">
   <meta>
      <profile value="http://fhir.nl/fhir/StructureDefinition/nl-core-patient"/>
      <profile value="http://nictiz.nl/fhir/StructureDefinition/bc-Child"/>
   </meta>
   <identifier>
      <system>
         <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-minimumId-exists">
            <valueBoolean value="true"/>
         </extension>
      </system>
      <value>
         <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-minimumId-exists">
            <valueBoolean value="true"/>
         </extension>
      </value>
   </identifier>
   <name>
      <text>
         <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-minimumId-existsWithValue">
            <valueBoolean value="true"/>
         </extension>
      </text>
      <family>
         <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-minimumId-existsWithValue">
            <valueBoolean value="true"/>
         </extension>
         <extension url="http://hl7.org/fhir/StructureDefinition/humanname-own-name">
            <valueString>
               <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-minimumId-existsWithValue">
                  <valueBoolean value="true"/>
               </extension>
            </valueString>
         </extension>
      </family>
      <given>
         <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-minimumId-existsWithValue">
            <valueBoolean value="true"/>
         </extension>
         <extension url="http://hl7.org/fhir/StructureDefinition/iso21090-EN-qualifier">
            <valueCode value="BR"/>
         </extension>
      </given>
   </name>
   <gender value="male">
      <extension url="http://nictiz.nl/fhir/StructureDefinition/code-specification">
         <valueCodeableConcept>
            <coding>
               <system value="http://hl7.org/fhir/v3/AdministrativeGender"/>
               <code value="M"/>
               <display>
                  <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-minimumId-exists">
                     <valueBoolean value="true"/>
                  </extension>
               </display>
            </coding>
         </valueCodeableConcept>
      </extension>
   </gender>
   <birthDate>
      <extension url="http://hl7.org/fhir/StructureDefinition/patient-birthTime">
         <valueDateTime>
            <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-minimumId-exists">
               <valueBoolean value="true"/>
            </extension>
         </valueDateTime>
      </extension>
   </birthDate>
</Patient>
