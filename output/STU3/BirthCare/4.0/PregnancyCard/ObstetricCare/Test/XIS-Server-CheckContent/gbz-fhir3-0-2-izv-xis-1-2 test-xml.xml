         <operation>
            <type>
               <system value="http://hl7.org/fhir/restful-interaction"/>
               <code value="search"/>
            </type>
            <resource value="BodySite"/>
            <description value="Resolve fetus resources for testing purposes."/>
            <accept value="xml"/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <origin value="1"/>
            <params value="?_id=${bodysite1-id},${bodysite2-id}"/>
            <requestHeader>
               <field value="Authorization"/>
               <value value="${patient-token-FIONAXXX-Swart}"/>
            </requestHeader>
            <responseId value="fetusresources"/>
         </operation>
      </action>
      <action>
         <assert>
            <description value="temp test"/>
            <direction value="response"/>
            <expression value="${babyAid} = 'BodySite/9a381515-6aa8-11ec-1080-020000000000'"/>
            <stopTestOnFail value="false"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
   </test>
