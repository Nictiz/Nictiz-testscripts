<?xml version="1.0" encoding="UTF-8"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
   <id value="phr-1-2-send-image"/>
   <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-authentication">
      <extension url="display">
         <valueString value="XXX-TEST-C"/>
      </extension>
      <extension url="access-token">
         <valueString value="d9f8d61b-c236-489f-aba5-b3bebd312c30"/>
      </extension>
   </extension>
   <url value="http://nictiz.nl/fhir/TestScript/phr-1-2-send-image"/>
   <version value="stu3-2.0-patchlevel 2026.46"/>
   <name value="Phr_1_2_send_image"/>
   <title value="Scenario 1.2 - Send Collection of three images"/>
   <status value="active"/>
   <publisher value="Nictiz"/>
   <contact>
      <name value="Nictiz"/>
      <telecom>
         <system value="email"/>
         <value value="kwalificatie@nictiz.nl"/>
         <use value="work"/>
      </telecom>
   </contact>
   <description value="Scenario 1.2 - Send collection of three images"/>
   <origin>
      <index value="1"/>
      <profile>
         <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-origin-types"/>
         <code value="FHIR-Client"/>
      </profile>
   </origin>
   <destination>
      <index value="1"/>
      <profile>
         <system value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-destination-profile"/>
         <code value="Conformancelab-Server"/>
      </profile>
   </destination>
   <fixture id="scenario-1-2-bundle-fixture">
      <autocreate value="false"/>
      <autodelete value="false"/>
      <resource>
         <reference value="../_reference/transaction-bundles/images-scenario-1-2-Bundle-collection-images.xml"/>
      </resource>
   </fixture>
   <profile id="Bundle-profile"
            value="http://hl7.org/fhir/StructureDefinition/Bundle"/>
   <variable>
      <name value="T"/>
      <defaultValue value="${CURRENTDATETIME}"/>
      <description value="Date that data and queries are expected to be relative to."/>
   </variable>
   <test id="scenario1-1-SendCollectionImages">
      <name value="Scenario 1.1"/>
      <description value="Send three images in a Bundle transaction"/>
      <action>
         <operation>
            <type>
               <system value="http://hl7.org/fhir/restful-interaction"/>
               <code value="transaction"/>
            </type>
            <description value="Test PHR client to POST a Bundle of type transaction."/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <origin value="1"/>
            <sourceId value="scenario-1-2-bundle-fixture"/>
         </operation>
      </action>
      <action>
         <assert>
            <description value="Confirm that request Bundle is of type transaction."/>
            <direction value="request"/>
            <expression value="Bundle.type = 'transaction'"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that HTTP header Authorization contains the patient token Bearer d9f8d61b-c236-489f-aba5-b3bebd312c30"/>
            <direction value="request"/>
            <headerField value="Authorization"/>
            <stopTestOnFail value="false"/>
            <value value="Bearer d9f8d61b-c236-489f-aba5-b3bebd312c30"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Check that the request URL does not contain 'patient=' to prevent patient searches using BSN identifiers."/>
            <direction value="request"/>
            <operator value="notContains"/>
            <requestURL value="patient="/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Check that the request URL does not contain 'subject=' to prevent patient searches using BSN identifiers."/>
            <direction value="request"/>
            <operator value="notContains"/>
            <requestURL value="subject="/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that all resources that are updated contain a Resource.id and a fullUrl."/>
            <direction value="request"/>
            <expression value="Bundle.entry.where(request.method='PUT').all( $this.fullUrl.exists() and $this.resource.id.exists())"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Check that resources submitted using POST do not contain a resource.id. This is an advisory check because the server SHALL ignore any supplied id."/>
            <direction value="request"/>
            <expression value="Bundle.entry.where(request.method='POST').all($this.resource.id.exists().not())"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="true"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Check that entries using POST do not have an HTTP(S) fullUrl. This is an advisory check; an HTTP(S) fullUrl can be a valid source identity and does not necessarily represent the resource's future server location."/>
            <direction value="request"/>
            <expression value="Bundle.entry.where(request.method='POST').all( $this.fullUrl.startsWith('http://').not() and $this.fullUrl.startsWith('https://').not() )"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="true"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Check that entries using POST either omit fullUrl or use a UUID URN or OID URN. This is an advisory check; other fullUrl forms are not necessarily invalid."/>
            <direction value="request"/>
            <expression value="Bundle.entry.where(request.method='POST').all( fullUrl.empty() or fullUrl.matches('^urn:oid:[0-2](\\.(0|[1-9]\\d*))*$') or fullUrl.matches('^urn:uuid:[A-Fa-f\\d]{8}-[A-Fa-f\\d]{4}-[A-Fa-f\\d]{4}-[A-Fa-f\\d]{4}-[A-Fa-f\\d]{12}$') )"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="true"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that every resource in the request Bundle, except Binary, contains a meta.profile declaration."/>
            <direction value="request"/>
            <expression value="Bundle.entry.resource.where(is(Binary).not()).where(meta.profile.empty()).empty()"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the fullUrl does not disagree with the id in the resource, see http://hl7.org/fhir/stu3/bundle-definitions.html#Bundle.entry.fullUrl"/>
            <direction value="request"/>
            <expression value="Bundle.entry.where(fullUrl.exists() and resource.id.exists()).all( fullUrl.matches('^((http|https)://([A-Za-z0-9\\.:%$-]*/)+)?' &amp; '[A-Z][A-Za-z0-9]*/[A-Za-z0-9.-]{1,64}$') implies fullUrl.endsWith('/' &amp; $this.resource.id))"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the fullUrl is an absolute URL, an uuid or an oid."/>
            <direction value="request"/>
            <expression value="Bundle.entry.fullUrl.all( startsWith('http://') or startsWith('https://') or matches('^urn:oid:[0-2](\\.(0|[1-9]\\d*))*$') or matches('^urn:uuid:[A-Fa-f\\d]{8}-[A-Fa-f\\d]{4}-[A-Fa-f\\d]{4}-[A-Fa-f\\d]{4}-[A-Fa-f\\d]{12}$') )"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Bundle conforms to the base FHIR specification and its resources conform to the profiles declared in meta.profile."/>
            <direction value="request"/>
            <stopTestOnFail value="false"/>
            <validateProfileId value="Bundle-profile"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that all Coding elements contain both a .system and a .code."/>
            <direction value="request"/>
            <expression value="Bundle.descendants().where($this.is(Coding)).all(system.exists() and code.exists())"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the OID of the zib valueset is not used for the system of a coding element."/>
            <direction value="request"/>
            <expression value="Bundle.descendants().where($this.is(Coding)).where(system.startsWith('urn:oid:2.16.840.1.113883.2.4.3.11.60.40.2')).exists().not()"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that every CodeableConcept contains at least one coding.display, a text value, or an extension (e.g. a nullFlavor or data-absent-reason extension) on the CodeableConcept. For more information see https://informatiestandaarden.nictiz.nl/wiki/FHIR:V1.0_FHIR_IG_STU3Use_of_coded_concepts."/>
            <direction value="request"/>
            <expression value="Bundle.descendants().where($this.is(CodeableConcept)) .all(coding.display.exists() or text.exists() or extension.exists())"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that every Reference contains a display value, a data-absent-reason extension, or a nullFlavor extension. For more information see https://informatiestandaarden.nictiz.nl/wiki/FHIR:V1.0_FHIR_IG_STU3#Use_of_the_reference_datatype."/>
            <direction value="request"/>
            <expression value="Bundle.descendants().where($this.is(Reference)).all(display.exists() or extension.where(url = 'http://hl7.org/fhir/StructureDefinition/data-absent-reason').exists() or extension.where(url = 'http://hl7.org/fhir/StructureDefinition/iso21090-nullFlavor').exists())"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that all Identifiers have both a .system and a .value. In rare cases where a general category of identifiers can be used, .type can replace .system. Edge cases for both .system and .type to be unknown are not applicable to Nictiz. For more information, see https://www.hl7.org/fhir/stu3/datatypes.html#Identifier."/>
            <direction value="request"/>
            <expression value="Bundle.descendants().where($this.is(Identifier)).all((system.exists() or type.exists()) and value.exists())"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Bundle contains no identifier with system http://fhir.nl/fhir/NamingSystem/bsn and a non-empty value without extensions on that value."/>
            <direction value="request"/>
            <expression value="Bundle.descendants().select(identifier.where(system = 'http://fhir.nl/fhir/NamingSystem/bsn').where(value.empty().not() and value.extension.exists().not())).count() = 0"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the operation was successful"/>
            <operator value="in"/>
            <responseCode value="200,201"/>
            <stopTestOnFail value="true"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Make sure the server of the test simulator handles each resource in the batch Bundle correctly"/>
            <direction value="response"/>
            <expression value="Bundle.entry.all(response.status.matches('^(200|201)( .*)?$'))"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the request Bundle contains exactly 3 Media resource(s)."/>
            <direction value="request"/>
            <expression value="Bundle.entry.where(resource.is(Media)).count() = 3"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the request Bundle contains exactly 3 Binary resource(s)."/>
            <direction value="request"/>
            <expression value="Bundle.entry.where(resource.is(Binary)).count() = 3"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the request Bundle contains exactly 1 Patient resource(s)."/>
            <direction value="request"/>
            <expression value="Bundle.entry.where(resource.is(Patient)).count() = 1"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the request Bundle contains exactly 1 Practitioner resource(s)."/>
            <direction value="request"/>
            <expression value="Bundle.entry.where(resource.is(Practitioner)).count() = 1"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that all resources contain a meta.profile tag, minus the Bundle and Binary resource."/>
            <direction value="request"/>
            <expression value="Bundle.entry.resource.meta.profile.count() = Bundle.entry.resource.count()-3"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Media resource has a recipient extension with a value."/>
            <direction value="request"/>
            <!--FHIRPath expressions with .ofType(...) are poorly supported at the moment, so it was rewritten. Original expression: 'Bundle.entry.resource.ofType(List).extension.where(url = 'http://nictiz.nl/fhir/StructureDefinition/images-recipient').value.exists()'-->
            <expression value="Bundle.entry.resource.where($this is List).extension.where(url = 'http://nictiz.nl/fhir/StructureDefinition/images-recipient').value.exists()"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
   </test>
</TestScript>
