<?xml version="1.0" encoding="UTF-8"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
   <id value="phr-1-4-retrieve-0-binary"/>
   <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-authentication">
      <extension url="display">
         <valueString value="XXX_Baltus"/>
      </extension>
      <extension url="access-token">
         <valueString value="f92b6141-55db-46d5-a3ae-874b69907d22"/>
      </extension>
   </extension>
   <url value="http://nictiz.nl/fhir/TestScript/phr-1-4-retrieve-0-binary"/>
   <version value="stu3-2.0-patchlevel 2026.46"/>
   <name value="Phr_1_4_retrieve_0_binary"/>
   <title value="Scenario 1.4 - Retrieve Binary resource of XXX-Baltus that has a wrong id from retrieved DocumentReference-3"/>
   <status value="active"/>
   <publisher value="Nictiz"/>
   <contact>
      <name value="Nictiz"/>
      <telecom>
         <system value="email"/>
         <value value="kwalificatie@nictiz.nl"/>
         <use value="work"/>
      </telecom>
   </contact>
   <description value="Qualification of scenario 1.4 of the PDF/A Retrieve use case. See [the test file on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2020.01/PDFA_Raadplegen) for more information."/>
   <origin>
      <index value="1"/>
      <profile>
         <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-origin-types"/>
         <code value="FHIR-Client"/>
      </profile>
   </origin>
   <destination>
      <index value="1"/>
      <profile>
         <system value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-destination-profile"/>
         <code value="Conformancelab-Server"/>
      </profile>
   </destination>
   <test id="scenario1-4-retrieve-0-binary">
      <description value="Read Binary resource and check the request"/>
      <action>
         <operation>
            <type>
               <system value="http://hl7.org/fhir/restful-interaction"/>
               <code value="read"/>
            </type>
            <resource value="Binary"/>
            <description value="Send a FHIR read on Binary"/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <origin value="1"/>
            <params value="/foutieve-en-onbekend-id"/>
         </operation>
      </action>
      <action>
         <assert>
            <description value="Confirm that HTTP header Authorization contains the patient token Bearer f92b6141-55db-46d5-a3ae-874b69907d22"/>
            <direction value="request"/>
            <headerField value="Authorization"/>
            <stopTestOnFail value="false"/>
            <value value="Bearer f92b6141-55db-46d5-a3ae-874b69907d22"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that query parameter 'patient=' was not present to avoid BSNs in the URL."/>
            <direction value="request"/>
            <operator value="notContains"/>
            <requestURL value="patient="/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that query parameter 'subject=' was not present to avoid BSNs in the URL."/>
            <direction value="request"/>
            <operator value="notContains"/>
            <requestURL value="subject="/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the returned HTTP status is 404 (Not Found) or 410 (Gone)."/>
            <direction value="response"/>
            <operator value="in"/>
            <responseCode value="404,410"/>
            <stopTestOnFail value="true"/>
            <warningOnly value="false"/>
         </assert>
      </action>
   </test>
</TestScript>
