<?xml version="1.0" encoding="UTF-8"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
   <id value="medmij-medication-medicationagreement-phr-1-03"/>
   <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-authentication">
      <extension url="display">
         <valueString value="XXX-DIRKSZ"/>
      </extension>
      <extension url="access-token">
         <valueString value="e2696872-f855-4283-a01b-c0db9c50bde2"/>
      </extension>
   </extension>
   <url value="http://nictiz.nl/fhir/TestScript/medmij-medication-medicationagreement-phr-1-03"/>
   <version value="stu3-9.0.7-patchlevel 2026.46"/>
   <name value="Medmij_medication_medicationagreement_phr_1_03"/>
   <title value="Scenario 1.3 - Retrieve medication agreements of person 'XXX-DIRKSZ' filtered by product codes"/>
   <status value="active"/>
   <publisher value="Nictiz"/>
   <contact>
      <name value="Nictiz"/>
      <telecom>
         <system value="email"/>
         <value value="kwalificatie@nictiz.nl"/>
         <use value="work"/>
      </telecom>
   </contact>
   <description value="Qualification of scenario 1.3 of the Medication Agreement Retrieve use case. See [the qualification documentation on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2019.01_Kwalificatie#Medicatiegegevens) for more information."/>
   <origin>
      <index value="1"/>
      <profile>
         <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-origin-types"/>
         <code value="FHIR-Client"/>
      </profile>
   </origin>
   <destination>
      <index value="1"/>
      <profile>
         <system value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-destination-profile"/>
         <code value="Conformancelab-Server"/>
      </profile>
   </destination>
   <test id="Scenario-1-3">
      <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-test-request-mode">
         <valueCode value="extra-allowed"/>
      </extension>
      <description value="Retrieve medication agreements of person 'XXX-DIRKSZ' filtered by product codes and check the request"/>
      <action>
         <operation>
            <type>
               <system value="http://hl7.org/fhir/restful-interaction"/>
               <code value="search"/>
            </type>
            <resource value="MedicationRequest"/>
            <description value="Send a FHIR search on MedicationRequest, including the 'category', 'medication.code' and '_include' parameters"/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <origin value="1"/>
            <params value="?category=http://snomed.info/sct|16076005&amp;medication.code=urn:oid:2.16.840.1.113883.2.4.4.10|6939,urn:oid:2.16.840.1.113883.2.4.4.7|615560,urn:oid:2.16.840.1.113883.2.4.4.10|3891&amp;_include=MedicationRequest:medication"/>
         </operation>
      </action>
      <action>
         <assert>
            <description value="Confirm that HTTP header Authorization contains the patient token Bearer e2696872-f855-4283-a01b-c0db9c50bde2"/>
            <direction value="request"/>
            <headerField value="Authorization"/>
            <stopTestOnFail value="false"/>
            <value value="Bearer e2696872-f855-4283-a01b-c0db9c50bde2"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that query parameter 'patient=' was not present to avoid BSNs in the URL."/>
            <direction value="request"/>
            <operator value="notContains"/>
            <requestURL value="patient="/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that query parameter 'subject=' was not present to avoid BSNs in the URL."/>
            <direction value="request"/>
            <operator value="notContains"/>
            <requestURL value="subject="/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Make sure that the server of the test simulator gives a success response."/>
            <operator value="in"/>
            <responseCode value="200,201"/>
            <stopTestOnFail value="true"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the server of the test simulator returns a Bundle."/>
            <direction value="response"/>
            <resource value="Bundle"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the returned searchset Bundle contains 6 entry(-ies).  (3 MedicationRequest and 3 Medication resources)"/>
            <direction value="response"/>
            <expression value="Bundle.entry.count() = 6"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
   </test>
</TestScript>
