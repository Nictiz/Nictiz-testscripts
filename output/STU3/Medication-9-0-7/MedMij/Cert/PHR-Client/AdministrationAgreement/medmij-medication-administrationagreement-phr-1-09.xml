<?xml version="1.0" encoding="UTF-8"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
   <id value="medmij-medication-administrationagreement-phr-1-09"/>
   <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-authentication">
      <extension url="display">
         <valueString value="XXX-BOURGONJE"/>
      </extension>
      <extension url="access-token">
         <valueString value="c980c4c9-a6d7-41d2-b541-5284f33b2f75"/>
      </extension>
   </extension>
   <url value="http://nictiz.nl/fhir/TestScript/medmij-medication-administrationagreement-phr-1-09"/>
   <version value="stu3-9.0.7-patchlevel 2026.46"/>
   <name value="Medmij_medication_administrationagreement_phr_1_09"/>
   <title value="Scenario 1.9 - Retrieve administration agreements of person 'XXX-BOURGONJE' filtered by a single product code"/>
   <status value="active"/>
   <publisher value="Nictiz"/>
   <contact>
      <name value="Nictiz"/>
      <telecom>
         <system value="email"/>
         <value value="kwalificatie@nictiz.nl"/>
         <use value="work"/>
      </telecom>
   </contact>
   <description value="Qualification of scenario 1.9 of the Administration Agreement Retrieve use case. See [the qualification documentation on the Nictiz wiki](https://informatiestandaarden.nictiz.nl/wiki/MedMij:V2019.01_Kwalificatie#Medicatiegegevens) for more information."/>
   <origin>
      <index value="1"/>
      <profile>
         <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-origin-types"/>
         <code value="FHIR-Client"/>
      </profile>
   </origin>
   <destination>
      <index value="1"/>
      <profile>
         <system value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-destination-profile"/>
         <code value="Conformancelab-Server"/>
      </profile>
   </destination>
   <test id="Scenario-1-9">
      <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-test-request-mode">
         <valueCode value="extra-allowed"/>
      </extension>
      <description value="Retrieve administration agreements of person 'XXX-BOURGONJE' filtered by a single product code and check the request"/>
      <action>
         <operation>
            <type>
               <system value="http://hl7.org/fhir/restful-interaction"/>
               <code value="search"/>
            </type>
            <resource value="MedicationDispense"/>
            <description value="Send a FHIR search on MedicationDispense, including the 'category', 'medication.code' and '_include' parameters"/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <origin value="1"/>
            <params value="?category=http://snomed.info/sct|422037009&amp;medication.code=urn:oid:2.16.840.1.113883.2.4.4.7|1205943&amp;_include=MedicationDispense:medication"/>
         </operation>
      </action>
      <action>
         <assert>
            <description value="Confirm that HTTP header Authorization contains the patient token Bearer c980c4c9-a6d7-41d2-b541-5284f33b2f75"/>
            <direction value="request"/>
            <headerField value="Authorization"/>
            <stopTestOnFail value="false"/>
            <value value="Bearer c980c4c9-a6d7-41d2-b541-5284f33b2f75"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that query parameter 'patient=' was not present to avoid BSNs in the URL."/>
            <direction value="request"/>
            <operator value="notContains"/>
            <requestURL value="patient="/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that query parameter 'subject=' was not present to avoid BSNs in the URL."/>
            <direction value="request"/>
            <operator value="notContains"/>
            <requestURL value="subject="/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Make sure that the server of the test simulator gives a success response."/>
            <operator value="in"/>
            <responseCode value="200,201"/>
            <stopTestOnFail value="true"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the server of the test simulator returns a Bundle."/>
            <direction value="response"/>
            <resource value="Bundle"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the response Bundle contains 1 MedicationDispense resource(s)."/>
            <direction value="response"/>
            <expression value="Bundle.entry.where(resource.is(MedicationDispense)).count() = 1"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the returned searchset Bundle contains 2 entry(-ies). (Consists of 1 MedicationDispense and 1 Medication resources.)"/>
            <direction value="response"/>
            <expression value="Bundle.entry.count() = 2"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
   </test>
</TestScript>
