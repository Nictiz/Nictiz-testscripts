<?xml version="1.0" encoding="UTF-8"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
   <id value="eups-plugathon-level1b-xml"/>
   <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-authentication">
      <extension url="display">
         <valueString value="EU-PS level 1b: bearer token from your own system for your level 1b test patient"/>
      </extension>
      <extension url="access-token">
         <valueString value=""/>
      </extension>
   </extension>
   <url value="http://nictiz.nl/fhir/TestScript/eups-plugathon-level1b-xml"/>
   <version value="r4.0.1-patchlevel 2026.38"/>
   <name value="Eups_plugathon_level1b_xml"/>
   <title value="EU-PS-L1-B - Level 1b: Maximum metadata and empty sections - XML Format"/>
   <status value="active"/>
   <publisher value="Nictiz"/>
   <contact>
      <name value="Nictiz"/>
      <telecom>
         <system value="email"/>
         <value value="kwalificatie@nictiz.nl"/>
         <use value="work"/>
      </telecom>
   </contact>
   <description value="The serving system provides an EU-PS for its level 1b test patient, in which all metadata is present, and all mandatory sections are empty, with an emptyReason and a narrative. Conformancelab sends the bearer token you enter at test setup to your server. Use a token issued by your own system that gives access to your level 1b test patient, and only to that patient. Implementation Guide: https://build.fhir.org/ig/hl7-eu/eps/"/>
   <origin>
      <index value="1"/>
      <profile>
         <system value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-origin-profile"/>
         <code value="Conformancelab-Client"/>
      </profile>
   </origin>
   <destination>
      <index value="1"/>
      <profile>
         <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"/>
         <code value="FHIR-Server"/>
      </profile>
   </destination>
   <profile id="ps-bundle-profile"
            value="http://hl7.eu/fhir/eps/StructureDefinition/bundle-eu-eps"/>
   <variable>
      <name value="composition-id"/>
      <description value="The id of the first Patient Summary Composition in the search result."/>
      <expression value="Bundle.entry.resource.where($this is Composition).first().id"/>
      <sourceId value="ps-search-response"/>
   </variable>
   <test>
      <name value="Search Patient Summary"/>
      <description value="Search the EU-PS Composition of the test patient."/>
      <action>
         <operation>
            <type>
               <system value="http://hl7.org/fhir/restful-interaction"/>
               <code value="search"/>
            </type>
            <resource value="Composition"/>
            <description value="Search the Patient Summary Compositions of the patient: GET [base]/Composition?type=http://loinc.org|60591-5"/>
            <accept value="xml"/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <origin value="1"/>
            <params value="?type=http://loinc.org|60591-5"/>
            <responseId value="ps-search-response"/>
         </operation>
      </action>
      <action>
         <assert>
            <description value="Confirm that the operation was successful"/>
            <operator value="in"/>
            <responseCode value="200,201"/>
            <stopTestOnFail value="true"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the response is a searchset Bundle."/>
            <direction value="response"/>
            <expression value="Bundle.type = 'searchset'"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the search result contains at least one Patient Summary Composition. Without one, step 2 cannot run."/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is Composition).exists()"/>
            <stopTestOnFail value="true"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the search result contains exactly one Composition. If there are more, step 2 uses the first one."/>
            <direction value="response"/>
            <expression value="Bundle.entry.resource.where($this is Composition).count() = 1"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="true"/>
         </assert>
      </action>
   </test>
   <test>
      <name value="Retrieve Patient Summary document"/>
      <description value="Retrieve the EU-PS as a document Bundle with $document and check the document as a whole."/>
      <action>
         <operation>
            <type>
               <system value="http://hl7.org/fhir/restful-interaction"/>
               <code value="read"/>
            </type>
            <resource value="Composition"/>
            <description value="Retrieve the Patient Summary as a document: GET [base]/Composition/[id]/$document"/>
            <accept value="xml"/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <origin value="1"/>
            <params value="/${composition-id}/$document"/>
            <responseId value="ps-document"/>
         </operation>
      </action>
      <action>
         <assert>
            <description value="Confirm that the operation was successful"/>
            <operator value="in"/>
            <responseCode value="200,201"/>
            <stopTestOnFail value="true"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the response is a Bundle."/>
            <direction value="response"/>
            <resource value="Bundle"/>
            <stopTestOnFail value="true"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Bundle is a document. (FHIR R4 allows a server to wrap the document in a searchset Bundle; that is not accepted here.)"/>
            <direction value="response"/>
            <expression value="Bundle.type = 'document'"/>
            <stopTestOnFail value="true"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the first entry of the document is a Composition."/>
            <direction value="response"/>
            <expression value="Bundle.entry.first().resource.is(Composition)"/>
            <stopTestOnFail value="true"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Composition is a Patient Summary (type LOINC 60591-5)."/>
            <direction value="response"/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).type.coding.where(system = 'http://loinc.org' and code = '60591-5').exists()"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Composition claims the profile http://hl7.eu/fhir/eps/StructureDefinition/composition-eu-eps."/>
            <direction value="response"/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).meta.profile.where($this.startsWith('http://hl7.eu/fhir/eps/StructureDefinition/composition-eu-eps')).exists()"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="true"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the document conforms to http://hl7.eu/fhir/eps/StructureDefinition/bundle-eu-eps, and its resources to the profiles they claim in meta.profile."/>
            <direction value="response"/>
            <stopTestOnFail value="false"/>
            <validateProfileId value="ps-bundle-profile"/>
            <warningOnly value="false"/>
         </assert>
      </action>
   </test>
   <test>
      <name value="Level 1b checks"/>
      <description value="Check that all metadata is present, and all mandatory sections are empty, with an emptyReason and a narrative."/>
      <action>
         <assert>
            <description value="Section Problems (LOINC 11450-4): the section is present."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).section.where(code.coding.where(system = 'http://loinc.org' and code = '11450-4').exists()).exists()"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Section Allergies and intolerances (LOINC 48765-2): the section is present."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).section.where(code.coding.where(system = 'http://loinc.org' and code = '48765-2').exists()).exists()"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Section Medication summary (LOINC 10160-0): the section is present."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).section.where(code.coding.where(system = 'http://loinc.org' and code = '10160-0').exists()).exists()"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Section History of procedures (LOINC 47519-4): the section is present."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).section.where(code.coding.where(system = 'http://loinc.org' and code = '47519-4').exists()).exists()"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Section Medical devices (LOINC 46264-8): the section is present."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).section.where(code.coding.where(system = 'http://loinc.org' and code = '46264-8').exists()).exists()"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Section Problems (LOINC 11450-4): the section has no entries, and has an emptyReason and a narrative."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).section.where(code.coding.where(system = 'http://loinc.org' and code = '11450-4').exists()).all(entry.empty() and emptyReason.exists() and text.div.exists())"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Section Allergies and intolerances (LOINC 48765-2): the section has no entries, and has an emptyReason and a narrative."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).section.where(code.coding.where(system = 'http://loinc.org' and code = '48765-2').exists()).all(entry.empty() and emptyReason.exists() and text.div.exists())"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Section Medication summary (LOINC 10160-0): the section has no entries, and has an emptyReason and a narrative."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).section.where(code.coding.where(system = 'http://loinc.org' and code = '10160-0').exists()).all(entry.empty() and emptyReason.exists() and text.div.exists())"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Section History of procedures (LOINC 47519-4): the section has no entries, and has an emptyReason and a narrative."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).section.where(code.coding.where(system = 'http://loinc.org' and code = '47519-4').exists()).all(entry.empty() and emptyReason.exists() and text.div.exists())"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Section Medical devices (LOINC 46264-8): the section has no entries, and has an emptyReason and a narrative."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).section.where(code.coding.where(system = 'http://loinc.org' and code = '46264-8').exists()).all(entry.empty() and emptyReason.exists() and text.div.exists())"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Composition contains a language."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).language.exists()"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Composition contains a version (extension-Composition.version)."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).extension.where(url = 'http://hl7.org/fhir/5.0/StructureDefinition/extension-Composition.version').value.exists()"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Composition contains an identifier."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).identifier.value.exists()"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Composition contains a status."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).status.exists()"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Composition contains a category."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).category.exists()"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Composition contains a subject."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).subject.exists()"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Composition contains a date."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).date.exists()"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Composition contains an author."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).author.exists()"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Composition contains a title."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).title.exists()"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Composition contains a legal attester with time and party."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).attester.where(mode = 'legal' and time.exists() and party.exists()).exists()"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Composition contains a professional attester (validator) with time and party."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).attester.where(mode = 'professional' and time.exists() and party.exists()).exists()"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Composition contains a custodian."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).custodian.exists()"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Composition contains an event with a code."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).event.code.exists()"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Composition contains an event with a period."/>
            <expression value="Bundle.entry.first().resource.where($this is Composition).event.period.exists()"/>
            <sourceId value="ps-document"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
   </test>
</TestScript>
