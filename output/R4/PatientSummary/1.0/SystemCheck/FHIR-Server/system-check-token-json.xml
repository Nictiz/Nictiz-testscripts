<?xml version="1.0" encoding="UTF-8"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
   <id value="system-check-with-token-json"/>
   <url value="http://nictiz.nl/fhir/TestScript/system-check-with-token-json"/>
   <version value="r4.0.1-patchlevel 2026.38"/>
   <name value="System_check_with_token_json"/>
   <title value="System check with token - JSON Format"/>
   <status value="active"/>
   <publisher value="Nictiz"/>
   <contact>
      <name value="Nictiz"/>
      <telecom>
         <system value="email"/>
         <value value="kwalificatie@nictiz.nl"/>
         <use value="work"/>
      </telecom>
   </contact>
   <description value="Checks that the FHIR server accepts the token entered at setup, by searching the Patient Summary Compositions it gives access to."/>
   <origin>
      <index value="1"/>
      <profile>
         <system value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-origin-profile"/>
         <code value="Conformancelab-Client"/>
      </profile>
   </origin>
   <destination>
      <index value="1"/>
      <profile>
         <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"/>
         <code value="FHIR-Server"/>
      </profile>
   </destination>
   <test>
      <name value="SystemCheckToken"/>
      <description value="Search the Patient Summary Compositions with the token"/>
      <action>
         <operation>
            <type>
               <system value="http://hl7.org/fhir/restful-interaction"/>
               <code value="search-type"/>
            </type>
            <resource value="Composition"/>
            <description value="Search the Patient Summary Compositions (GET [base]/Composition?type=http://loinc.org|60591-5)."/>
            <accept value="json"/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <origin value="1"/>
            <params value="?type=http://loinc.org|60591-5"/>
         </operation>
      </action>
      <action>
         <assert>
            <description value="Confirm that the server responds with HTTP status 200."/>
            <direction value="response"/>
            <operator value="equals"/>
            <responseCode value="200"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the response is a searchset Bundle."/>
            <direction value="response"/>
            <expression value="Bundle.type = 'searchset'"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
   </test>
</TestScript>
