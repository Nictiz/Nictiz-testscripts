   <url value="http://nictiz.nl/fhir/TestScript/nlps-scenario1b-xml"/>
   <version value="r4.0.1-patchlevel 2026.38"/>
   <name value="Nlps_scenario1b_xml"/>
   <title value="Scenario 1b - NL-PS level 1b: Maximum metadata and empty sections - XML Format"/>
   <status value="active"/>
   <publisher value="Nictiz"/>
   <contact>
      <name value="Nictiz"/>
      <telecom>
         <system value="email"/>
         <value value="kwalificatie@nictiz.nl"/>
         <use value="work"/>
      </telecom>
   </contact>
   <description value="The serving system provides an NL-PS for its level 1b test patient, in which all metadata is present, and all mandatory sections are empty, with an emptyReason and a narrative. The patient is selected by the token entered at test setup. Implementation Guide: https://build.fhir.org/ig/Nictiz/NL-PS-IG/"/>
   <origin>
      <index value="1"/>
      <profile>
         <system value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-origin-profile"/>
         <code value="Conformancelab-Client"/>
      </profile>
   </origin>
   <destination>
      <index value="1"/>
      <profile>
         <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"/>
         <code value="FHIR-Server"/>
      </profile>
   </destination>
   <profile id="ps-bundle-profile"
            value="http://hl7.org/fhir/StructureDefinition/Bundle"/>
   <variable>
      <name value="composition-id"/>
      <description value="The id of the first Patient Summary Composition in the search result."/>
      <!--FHIRPath expressions with .ofType(...) are poorly supported at the moment, so it was rewritten. Original expression: 'Bundle.entry.resource.ofType(Composition).first().id'-->
      <expression value="Bundle.entry.resource.where($this is Composition).first().id"/>
      <sourceId value="ps-search-response"/>
   </variable>
   <test>
      <name value="Search Patient Summary"/>
      <description value="Search the NL-PS Composition of the test patient."/>
      <action>
         <operation>
            <type>
               <system value="http://hl7.org/fhir/restful-interaction"/>
               <code value="search"/>
            </type>
            <resource value="Composition"/>
            <description value="Search the Patient Summary Compositions of the patient: GET [base]/Composition?type=http://loinc.org|60591-5"/>
            <accept value="xml"/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <origin value="1"/>
            <params value="?type=http://loinc.org|60591-5"/>
            <responseId value="ps-search-response"/>
         </operation>
      </action>
      <action>
         <assert>
            <description value="Confirm that the operation was successful"/>
            <operator value="in"/>
            <responseCode value="200,201"/>
            <stopTestOnFail value="true"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the response is a searchset Bundle."/>
            <direction value="response"/>
            <expression value="Bundle.type = 'searchset'"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the search result contains at least one Patient Summary Composition. Without one, step 2 cannot run."/>
            <direction value="response"/>
            <!--FHIRPath expressions with .ofType(...) are poorly supported at the moment, so it was rewritten. Original expression: 'Bundle.entry.resource.ofType(Composition).exists()'-->
            <expression value="Bundle.entry.resource.where($this is Composition).exists()"/>
            <stopTestOnFail value="true"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the search result contains exactly one Composition. If there are more, step 2 uses the first one."/>
            <direction value="response"/>
            <!--FHIRPath expressions with .ofType(...) are poorly supported at the moment, so it was rewritten. Original expression: 'Bundle.entry.resource.ofType(Composition).count() = 1'-->
            <expression value="Bundle.entry.resource.where($this is Composition).count() = 1"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="true"/>
         </assert>
      </action>
   </test>
   <test>
      <name value="Retrieve Patient Summary document"/>
      <description value="Retrieve the NL-PS as a document Bundle with $document and check the document as a whole."/>
      <action>
         <operation>
            <type>
               <system value="http://hl7.org/fhir/restful-interaction"/>
               <code value="read"/>
            </type>
            <resource value="Composition"/>
            <description value="Retrieve the Patient Summary as a document: GET [base]/Composition/[id]/$document"/>
            <accept value="xml"/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <origin value="1"/>
            <params value="/${composition-id}/$document"/>
            <responseId value="ps-document"/>
         </operation>
      </action>
      <action>
         <assert>
            <description value="Confirm that the operation was successful"/>
            <operator value="in"/>
            <responseCode value="200,201"/>
            <stopTestOnFail value="true"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the response is a Bundle."/>
            <direction value="response"/>
            <resource value="Bundle"/>
            <stopTestOnFail value="true"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Bundle is a document. (FHIR R4 allows a server to wrap the document in a searchset Bundle; that is not accepted here.)"/>
            <direction value="response"/>
            <expression value="Bundle.type = 'document'"/>
            <stopTestOnFail value="true"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the first entry of the document is a Composition."/>
            <direction value="response"/>
            <expression value="Bundle.entry.first().resource.is(Composition)"/>
            <stopTestOnFail value="true"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Composition is a Patient Summary (type LOINC 60591-5)."/>
            <direction value="response"/>
            <!--FHIRPath expressions with .ofType(...) are poorly supported at the moment, so it was rewritten. Original expression: 'Bundle.entry.first().resource.ofType(Composition).type.coding.where(system = 'http://loinc.org' and code = '60591-5').exists()'-->
            <expression value="Bundle.entry.first().resource.where($this is Composition).type.coding.where(system = 'http://loinc.org' and code = '60591-5').exists()"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the Composition claims the profile http://ig.nictiz.nl/nlps/StructureDefinition/nl-PatientSummary."/>
            <direction value="response"/>
            <!--FHIRPath expressions with .ofType(...) are poorly supported at the moment, so it was rewritten. Original expression: 'Bundle.entry.first().resource.ofType(Composition).meta.profile.where($this.startsWith('http://ig.nictiz.nl/nlps/StructureDefinition/nl-PatientSummary')).exists()'-->
            <expression value="Bundle.entry.first().resource.where($this is Composition).meta.profile.where($this.startsWith('http://ig.nictiz.nl/nlps/StructureDefinition/nl-PatientSummary')).exists()"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="true"/>
         </assert>
      </action>
      <action>
         <assert>
            <description value="Confirm that the document conforms to http://hl7.org/fhir/StructureDefinition/Bundle, and its resources to the profiles they claim in meta.profile."/>
            <direction value="response"/>
            <stopTestOnFail value="false"/>
            <validateProfileId value="ps-bundle-profile"/>
            <warningOnly value="true"/>
         </assert>
      </action>
      <!-- Warning only until the GBB package with the nl-core profiles that NL-PS refers to exists. -->
   </test>
