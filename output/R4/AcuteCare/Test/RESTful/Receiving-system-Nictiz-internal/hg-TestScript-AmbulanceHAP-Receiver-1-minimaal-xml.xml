   <test id="01-receive-ambulance-referral">
      <description value="Receive ServiceRequest az-ave-tst-1-minimaal."/>
      <action>
         <operation>
            <type>
               <system value="http://hl7.org/fhir/restful-interaction"/>
               <code value="transaction"/>
            </type>
            <description value="Receive the ambulance-to-HAP referral message ServiceRequest from the sender. PROVISIONAL: modelled as a create/POST pending the exchange-paradigm choice (#14)."/>
            <accept value="xml"/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <method value="post"/>
            <origin value="1"/>
            <sourceId value="scenario-servicerequest-fixture"/>
            <requestId value="scenario-servicerequest-request"/>
            <responseId value="scenario-servicerequest-response"/>
            <requestHeader>
               <field value="Authorization"/>
               <value value="${patient-token-patient-}"/>
            </requestHeader>
         </operation>
      </action>
      <action>
         <assert>
            <description value="Confirm that the operation was successful"/>
            <operator value="in"/>
            <responseCode value="200,201"/>
            <stopTestOnFail value="true"/>
            <warningOnly value="false"/>
         </assert>
      </action>
   </test>
