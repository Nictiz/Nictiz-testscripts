<?xml version="1.0" encoding="UTF-8"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
   <id value="hg-TestScript-AmbulanceHAP-Receiver-1-xml"/>
   <url value="http://nictiz.nl/fhir/TestScript/hg-TestScript-AmbulanceHAP-Receiver-1-xml"/>
   <version value="0.1.0-alpha.1-patchlevel 2026.30"/>
   <name value="Hg_TestScript_AmbulanceHAP_Receiver_1_xml"/>
   <title value="Scenario 1 - Receive maximal - XML Format"/>
   <status value="active"/>
   <publisher value="Nictiz"/>
   <contact>
      <name value="Nictiz"/>
      <telecom>
         <system value="email"/>
         <value value="kwalificatie@nictiz.nl"/>
         <use value="work"/>
      </telecom>
   </contact>
   <description value="Receive an ambulance-to-HAP referral message with a richly populated message"/>
   <origin>
      <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-SUT">
         <valueBoolean value="false"/>
      </extension>
      <index value="1"/>
      <profile>
         <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-origin-types"/>
         <code value="FHIR-Client"/>
      </profile>
   </origin>
   <destination>
      <extension url="http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-SUT">
         <valueBoolean value="true"/>
      </extension>
      <index value="1"/>
      <profile>
         <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"/>
         <code value="FHIR-Server"/>
      </profile>
   </destination>
   <fixture id="scenario-bundle-fixture">
      <autocreate value="false"/>
      <autodelete value="false"/>
      <resource>
         <reference value="../../_reference/EXAMPLE-messaging-bundle.xml"/>
      </resource>
   </fixture>
   <test id="01-receive-ambulance-referral">
      <description value="Receive patient az-ave-tst-2-maximaal."/>
      <action>
         <operation>
            <type>
               <system value="http://hl7.org/fhir/restful-interaction"/>
               <code value="process-message"/>
            </type>
            <description value="Send the ambulance-to-HAP referral message Bundle to the receiver. PROVISIONAL: modelled as a create/POST pending the exchange-paradigm choice (#14)."/>
            <accept value="xml"/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <method value="post"/>
            <origin value="1"/>
            <sourceId value="scenario-bundle-fixture"/>
            <responseId value="scenario-bundle-response"/>
         </operation>
      </action>
      <action>
         <assert>
            <description value="Confirm that the operation was successful"/>
            <operator value="in"/>
            <responseCode value="200,201"/>
            <stopTestOnFail value="true"/>
            <warningOnly value="false"/>
         </assert>
      </action>
   </test>
</TestScript>
