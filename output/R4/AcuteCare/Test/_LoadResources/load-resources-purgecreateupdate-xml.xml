<TestScript xmlns="http://hl7.org/fhir">
   <id value="resources-purgecreateupdate-xml"/>
   <url value="http://nictiz.nl/fhir/TestScript/load-resources-purgecreateupdate-xml"/>
   <name value="Load_Test_Resources_Purge_Create_Update_XML"/>
   <status value="active"/>
   <publisher value="Nictiz"/>
   <contact>
      <name value="MedMij"/>
      <telecom>
         <system value="email"/>
         <value value="kwalificatie@nictiz.nl"/>
         <use value="work"/>
      </telecom>
   </contact>
   <description value="Load test resources using the update (PUT) operation of the target FHIR server for use in testing. All resource ids are pre-defined. The target XIS FHIR server is expected to support resource create via the update (PUT) operation for client assigned ids."/>
   <copyright value="© Nictiz 2020"/>
   <fixture id="Patient-412a3804-d210-11f1-1773-020000000000">
      <autocreate value="false"/>
      <autodelete value="false"/>
      <resource>
         <reference value="../_reference/fixtures/az-ave-tst-1-minimaal-412a3804-d210-11f1-1773-020000000000.xml"/>
      </resource>
   </fixture>
   <variable>
      <name value="Patient-412a3804-d210-11f1-1773-020000000000-id"/>
      <expression value="Patient.id"/>
      <sourceId value="Patient-412a3804-d210-11f1-1773-020000000000"/>
   </variable>
   <variable>
      <name value="T"/>
      <defaultValue value="${CURRENTDATE}"/>
      <description value="Date that data and queries are expected to be relative to."/>
   </variable>
   <setup>
      <action>
         <operation>
            <type>
               <system value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-operation-codes"/>
               <code value="purge"/>
            </type>
            <resource value="Patient"/>
            <accept value="xml"/>
            <contentType value="xml"/>
            <encodeRequestUrl value="true"/>
            <params value="412a3804-d210-11f1-1773-020000000000/$purge"/>
            <requestHeader>
               <field value="Authorization"/>
               <value value="Bearer 33a86354-9cf8-4204-aa2b-f368cc949a9b"/>
            </requestHeader>
         </operation>
      </action>
      <action>
         <assert>
            <description value="Confirm that the returned HTTP status is 200(OK) or 204(No Content)"/>
            <operator value="in"/>
            <responseCode value="200,204"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
   </setup>
   <test id="Step1-LoadTestResourceCreate">
      <name value="Step1-LoadTestResourceCreate"/>
      <description value="Load test resources using the update (PUT) operation of the target FHIR server for use in testing. All resource ids are pre-defined. The target XIS FHIR server is expected to support resource create via the update (PUT) operation for client assigned ids."/>
      <action>
         <operation>
            <type>
               <system value="http://hl7.org/fhir/restful-interaction"/>
               <code value="update"/>
            </type>
            <resource value="Patient"/>
            <description value="PUT Patient/412a3804-d210-11f1-1773-020000000000"/>
            <accept value="xml"/>
            <contentType value="xml"/>
            <encodeRequestUrl value="true"/>
            <params value="/${Patient-412a3804-d210-11f1-1773-020000000000-id}"/>
            <requestHeader>
               <field value="Authorization"/>
               <value value="Bearer 33a86354-9cf8-4204-aa2b-f368cc949a9b"/>
            </requestHeader>
            <sourceId value="Patient-412a3804-d210-11f1-1773-020000000000"/>
         </operation>
      </action>
      <action>
         <assert>
            <description value="Confirm that the returned HTTP status is 200(OK) or 201(Created)."/>
            <operator value="in"/>
            <responseCode value="200,201"/>
            <stopTestOnFail value="false"/>
            <warningOnly value="false"/>
         </assert>
      </action>
   </test>
</TestScript>
