<?xml version="1.0" encoding="UTF-8"?>
<TestScript xmlns="http://hl7.org/fhir" xmlns:nts="http://nictiz.nl/xsl/testscript">
   <id value="-TestScript-AmbulanceHAP-Receiver-1-minimaal-Nictiz-internal-xml"/>
   <url value="http://nictiz.nl/fhir/TestScript/hg-TestScript-AmbulanceHAP-Receiver-1-minimaal-Nictiz-internal-xml"/>
   <version value="0.1.0-alpha.1-patchlevel 2026.42"/>
   <name value="Hg_TestScript_AmbulanceHAP_Receiver_1_minimaal_Nictiz_internal_xml"/>
   <title value="Scenario 1 - Receive minimal - target Nictiz-internal - XML Format"/>
   <status value="active"/>
   <publisher value="Nictiz"/>
   <contact>
      <name value="Nictiz"/>
      <telecom>
         <system value="email"/>
         <value value="kwalificatie@nictiz.nl"/>
         <use value="work"/>
      </telecom>
   </contact>
   <description value="Receive an ambulance-to-HAP referral message with a minimally populated message"/>
   <origin>
      <index value="1"/>
      <profile>
         <system value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-origin-profile"/>
         <code value="Conformancelab-Client"/>
      </profile>
   </origin>
   <origin>
      <index value="2"/>
      <profile>
         <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-origin-types"/>
         <code value="FHIR-Client"/>
      </profile>
   </origin>
   <destination>
      <index value="1"/>
      <profile>
         <system value="http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"/>
         <code value="FHIR-Server"/>
      </profile>
   </destination>
   <destination>
      <index value="2"/>
      <profile>
         <system value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-destination-profile"/>
         <code value="Conformancelab-Server"/>
      </profile>
   </destination>
   <fixture id="scenario-servicerequest-fixture">
      <autocreate value="false"/>
      <autodelete value="false"/>
      <resource>
         <reference value="../_reference/bundles/bundle-az-ave-tst-1-minimaal.xml"/>
      </resource>
   </fixture>
   <variable>
      <name value="patient-token-412a3804-d210-11f1-1773-020000000000"/>
      <defaultValue value="Bearer 33a86354-9cf8-4204-aa2b-f368cc949a9b"/>
      <description value="OAuth Token for patient '412a3804-d210-11f1-1773-020000000000'"/>
   </variable>
   <variable>
      <name value="Patient-id"/>
      <description value="The id of the patient resource"/>
      <expression value="Bundle.entry.resource.where($this is ServiceRequest).subject.reference.replaceMatches('^Patient/', '')"/>
      <sourceId value="scenario-servicerequest-request"/>
   </variable>
   <variable>
      <name value="Encounter-id"/>
      <description value="The id of the patient resource"/>
      <expression value="Bundle.entry.resource.where($this is ServiceRequest).encounter.reference.replaceMatches('^Encounter/', '')"/>
      <sourceId value="scenario-servicerequest-request"/>
   </variable>
   <variable>
      <name value="PractitionerRole-id"/>
      <description value="The id of the patient resource"/>
      <expression value="Bundle.entry.resource.where($this is ServiceRequest).requester.reference.replaceMatches('^PractitionerRole/', '')"/>
      <sourceId value="scenario-servicerequest-request"/>
   </variable>
   <variable>
      <name value="Organization-id"/>
      <description value="The id of the patient resource"/>
      <expression value="Bundle.entry.resource.where($this is ServiceRequest).performer.reference.replaceMatches('^Organization/', '')"/>
      <sourceId value="scenario-servicerequest-request"/>
   </variable>
   <variable>
      <name value="Composition-id"/>
      <description value="The id of the patient resource"/>
      <expression value="Bundle.entry.resource.where($this is ServiceRequest).supportingInfo.reference.where(startsWith('Composition/')).replaceMatches('^Composition/', '')"/>
      <sourceId value="scenario-servicerequest-request"/>
   </variable>
   <variable>
      <name value="DocumentReference-id"/>
      <description value="The id of the patient resource"/>
      <expression value="Bundle.entry.resource.where($this is ServiceRequest).supportingInfo.reference.where(startsWith('DocumentReference/')).replaceMatches('^DocumentReference/', '')"/>
      <sourceId value="scenario-servicerequest-request"/>
   </variable>
   <variable>
      <name value="created-servicerequest-id"/>
      <description value="The id of the created ServiceRequest resource"/>
      <expression value="Bundle.entry.response.location.where(startsWith('ServiceRequest/')).replaceMatches('^ServiceRequest/([^/]+).*$','$1')"/>
      <sourceId value="scenario-servicerequest-response"/>
   </variable>
   <test id="01-receive-ambulance-referral">
      <description value="Receive ServiceRequest az-ave-tst-1-minimaal."/>
      <action>
         <operation>
            <type>
               <system value="http://hl7.org/fhir/restful-interaction"/>
               <code value="transaction"/>
            </type>
            <description value="Receive the ambulance-to-HAP referral message ServiceRequest from the sender."/>
            <accept value="xml"/>
            <destination value="1"/>
            <encodeRequestUrl value="true"/>
            <method value="post"/>
            <origin value="1"/>
            <sourceId value="scenario-servicerequest-fixture"/>
            <requestId value="scenario-servicerequest-request"/>
            <responseId value="scenario-servicerequest-response"/>
            <requestHeader>
               <field value="Authorization"/>
               <value value="${patient-token-412a3804-d210-11f1-1773-020000000000}"/>
            </requestHeader>
         </operation>
      </action>
      <action>
         <assert>
            <description value="Confirm that the operation was successful"/>
            <operator value="in"/>
            <responseCode value="200,201"/>
            <stopTestOnFail value="true"/>
            <warningOnly value="false"/>
         </assert>
      </action>
   </test>
   <teardown>
      <name value="teardown"/>
      <description value="Delete the created resources"/>
      <action>
         <operation>
            <type>
               <system value="http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-operation-codes"/>
               <code value="delete"/>
            </type>
            <description value="Delete Bundle resource created during this test run."/>
            <resource value="Bundle"/>
            <accept value="xml"/>
            <encodeRequestUrl value="true"/>
            <params value="/${created-servicerequest-id}"/>
            <requestHeader>
               <field value="Prefer"/>
               <value value="return=representation"/>
            </requestHeader>
         </operation>
      </action>
   </teardown>
</TestScript>
