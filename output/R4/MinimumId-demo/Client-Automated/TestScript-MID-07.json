          "type": {
            "system": "http://hl7.org/fhir/restful-interaction",
            "code": "update"
          },
          "origin": 1,
          "destination": 1,
          "encodeRequestUrl": true,
          "url": "${DESTINATION-1}/Patient/${MID-07-run}-variabele-json",
          "sourceId": "MID-07-variabele-json-source",
          "requestHeader": [
            {
              "field": "Content-Type",
              "value": "application/fhir+json"
            },
            {
              "field": "Accept",
              "value": "application/fhir+json"
            }
          ]
        }
      },
      {
        "assert": {
          "id": "MID-07-variabele-json-seed-ok",
          "description": "Opslaan eigen bron: HTTP 200/201",
          "warningOnly": false,
          "stopTestOnFail": true,
          "responseCode": "200,201",
          "operator": "in"
        }
      },
      {
        "operation": {
          "id": "MID-07-variabele-xml-seed",
          "description": "Voer update uit met de eigen demobron",
          "type": {
            "system": "http://hl7.org/fhir/restful-interaction",
            "code": "update"
          },
          "origin": 1,
