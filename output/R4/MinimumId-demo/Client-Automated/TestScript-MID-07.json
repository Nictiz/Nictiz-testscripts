{
  "resourceType": "TestScript",
  "id": "MID-07",
  "meta": {
    "profile": [
      "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-TestScript-core"
    ]
  },
  "url": "http://fhir.interoplab.eu/demo/minimumId/TestScript/MID-07",
  "version": "1.0.0",
  "name": "MinimumIdDemo07",
  "title": "MID-07 / Variabelen in het minimum / PASS",
  "status": "active",
  "publisher": "Interoplab",
  "description": "Kies Automated mode en behoud de run-id. Alleen JSON/JSON en XML/XML. Verwachte scriptstatus: **PASS**.\n\nHet rijke minimum bevat ${MID-07-family}. De vaste variabele resolveert naar XXX_Helleman. Controleer de opgeloste waarde in Show variables en de gebruikte minimuminhoud in de vergelijking.\n\nOpen Resource comparison op de minimumId-assert. Minimum fixture staat links, Source fixture rechts. Bekijk Match, Different, Missing en de instructielabels; navigeer vooruit en terug door de verschillen, klap geneste elementen in en uit en controleer de oorspronkelijke bronindices. Zet Show extra aan en uit: extra inhoud is toegestaan en wordt neutraal getoond. Beide panelen volgen het bronformaat; er is geen XML/JSON-toggle. Sla de Test run op en heropen de vergelijking: inhoud, status, uitleg en formaat blijven behouden.",
  "origin": [
    {
      "index": 1,
      "profile": {
        "system": "http://terminology.hl7.org/CodeSystem/testscript-profile-origin-types",
        "code": "FHIR-Client"
      }
    }
  ],
  "destination": [
    {
      "index": 1,
      "profile": {
        "system": "http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-destination-profile",
        "code": "Conformancelab-Server"
      }
    }
  ],
  "variable": [
    {
      "name": "MID-07-run",
      "defaultValue": "${UUID}"
    },
    {
      "name": "MID-07-family",
      "defaultValue": "XXX_Helleman"
    }
  ],
