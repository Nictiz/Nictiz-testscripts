        "assert": {
          "id": "MID-07-variabele-xml-seed-ok",
          "description": "Opslaan eigen bron: HTTP 200/201",
          "warningOnly": false,
          "stopTestOnFail": true,
          "responseCode": "200,201",
          "operator": "in"
        }
      }
    ]
  },
